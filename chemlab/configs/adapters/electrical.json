{
 "class": "electrical",
 "adapter": "chemlab.compile.classes.electrical:ElectricalAdapter",
 "about": "Electrical, magnetic and thermoelectric property testers: contact, move, set-field, set-temp, temp, wait-temp, method (class keys with units), calibrate, start (job-N), stop, result, status. power / estop / ack / wait come from the shared layer.",
 "membership": {
  "decided": "2026-10-22",
  "primary": [
   "lakeshore_measurereadym91",
   "signatone_quadpro2",
   "lakeshore_8604vsm",
   "novocontrol_alphat",
   "linseis_lsr3"
  ],
  "secondary": {},
  "not_here": {
   "hot_tps2500": "thermal conductivity tester: primary in thermal_analysis (this package); not an electrical measurement"
  }
 },
 "members": {
  "lakeshore_measurereadym91": {
   "role": "primary",
   "verbs": {
    "contact": {
     "check": {
      "cap": "contact_check.auto",
      "keys": {
       "max-current": {
        "arg": "max_current_a",
        "kind": "current"
       },
       "max-voltage": {
        "arg": "max_voltage_v",
        "kind": "voltage"
       },
       "points": {
        "arg": "points"
       },
       "r2": {
        "arg": "minimum_r_squared"
       }
      },
      "defaults": {
       "max_current_a": "example",
       "max_voltage_v": "example",
       "points": "example",
       "minimum_r_squared": "example"
      },
      "passthrough": true
     },
     "probe_alternative": "the M91 has no probe actuator (the sample card is clamped by the lab operator); `contact check` runs its contact check"
    },
    "temp": {
     "reads": [
      "thermal.indicated_k",
      "field.indicated_t"
     ]
    },
    "method": {
     "cap": "method.configure",
     "keys": {
      "current": {
       "arg": "current_a",
       "kind": "current"
      },
      "range": {
       "arg": "current_range_a",
       "kind": "current"
      },
      "vrange": {
       "arg": "voltage_range_v",
       "kind": "voltage"
      },
      "phase": {
       "arg": "phase_duration_s",
       "kind": "duration"
      },
      "repeats": {
       "arg": "repeats"
      },
      "field-tol": {
       "arg": "field_settling_tolerance_t",
       "kind": "magnetic_field"
      }
     },
     "need": [
      "current"
     ],
     "defaults": {
      "current_range_a": {
       "auto_range_for": "current_a"
      },
      "voltage_range_v": "example",
      "phase_duration_s": "example",
      "repeats": "example",
      "field_settling_tolerance_t": "example"
     }
    },
    "calibrate": {
     "cap": "sensor.calibrate",
     "keys": {
      "field_offset_t": {
       "arg": "field_offset_t",
       "kind": "magnetic_field"
      },
      "voltage_offset_v": {
       "arg": "voltage_offset_v",
       "kind": "voltage"
      }
     }
    },
    "start": {
     "cap": "acquisition.start"
    },
    "stop": {
     "cap": "acquisition.stop"
    },
    "result": {
     "cap": "acquisition.result",
     "columns": {
      "voltage_v": [
       "voltage",
       "voltage"
      ],
      "current_a": [
       "current",
       "current"
      ],
      "field_t": [
       "field",
       "magnetic_field"
      ]
     }
    },
    "analyze": {
     "default": "hall",
     "models": {
      "hall": {
       "cap": "analysis.hall_vdp",
       "objects": {
        "observations": {
         "fields": [
          "host_time_s",
          "contact_configuration",
          "current_a",
          "voltage_v",
          "field_t"
         ]
        }
       },
       "min_rows": 18,
       "fix": "the Hall analysis needs at least 18 readings (two repeats): `chemlab run INST method current=... repeats=2`, then start again",
       "keys": {
        "thickness": {
         "arg": "thickness_m",
         "kind": "length"
        }
       },
       "need": [
        "thickness"
       ],
       "defaults": {
        "hall_geometry_factor": "example",
        "hall_factor": "example",
        "field_symmetry_relative": "example",
        "accept_single_carrier_model": "example"
       }
      }
     },
     "example": "hall thickness=500um"
    }
   },
   "slots": {
    "power": "power.enabled",
    "temp": "thermal.indicated_k",
    "field": "field.indicated_t",
    "field_set": "field.target_t",
    "phase": "acquisition.phase",
    "points": "acquisition.points",
    "sample": "sample.present",
    "warmup": "warmup.ready",
    "calibration": "calibration.state",
    "voltage": "measured.voltage_v",
    "current": "measured.current_a"
   },
   "requires": {
    "method": [
     {
      "slot": "power.enabled",
      "code": "POWER_OFF",
      "message": "{inst} is switched off.",
      "fix": "switch it on: `chemlab run {inst} power on`.",
      "label": "power on",
      "truthy": true
     }
    ],
    "contact-check": [
     {
      "slot": "power.enabled",
      "code": "POWER_OFF",
      "message": "{inst} is switched off.",
      "fix": "switch it on: `chemlab run {inst} power on`.",
      "label": "power on",
      "truthy": true
     },
     {
      "slot": "warmup.elapsed_s",
      "code": "WARMING_UP",
      "message": "{inst} has been on for {value} s; it measures only after its 30 min warm-up.",
      "fix": "wait: `chemlab wait 30min` (the warm-up counts from power-on).",
      "label": "warmed up",
      "min": 1800.0
     },
     {
      "slot": "clamp.position_m",
      "code": "CLAMP_OPEN",
      "message": "the sample clamp of {inst} is open.",
      "fix": "the lab operator closes the clamp; ask for it.",
      "label": "clamp closed",
      "max": 1e-09
     }
    ],
    "start": [
     {
      "slot": "power.enabled",
      "code": "POWER_OFF",
      "message": "{inst} is switched off.",
      "fix": "switch it on: `chemlab run {inst} power on`.",
      "label": "power on",
      "truthy": true
     },
     {
      "slot": "sample.present",
      "code": "NO_SAMPLE",
      "message": "no sample card is in {inst}.",
      "fix": "the lab operator mounts the sample; ask for it.",
      "label": "sample mounted",
      "truthy": true
     },
     {
      "slot": "clamp.position_m",
      "code": "CLAMP_OPEN",
      "message": "the sample clamp of {inst} is open.",
      "fix": "the lab operator closes the clamp; ask for it.",
      "label": "clamp closed",
      "max": 1e-09
     },
     {
      "slot": "warmup.elapsed_s",
      "code": "WARMING_UP",
      "message": "{inst} has been on for {value} s; it measures only after its 30 min warm-up.",
      "fix": "wait: `chemlab wait 30min` (the warm-up counts from power-on).",
      "label": "warmed up",
      "min": 1800.0
     }
    ]
   },
   "unsupported": {
    "move": "no positioner: the specimen sits in a fixed holder",
    "set-field": "the magnet is the lab's (its field is set by the lab operator, not by the M91 interface)",
    "set-temp": "the sample temperature is set by the lab's temperature stage, not by the M91 interface",
    "wait-temp": "no set point to wait for (the temperature is the lab's)"
   },
   "alternatives": {
    "set-field": "read the field with `chemlab run INST temp`; the field of a Hall run is part of the lab set-up."
   },
   "notes": {
    "method": [
     "range=auto (default) picks the smallest current range that holds current=; the FastHall, resistivity and four-wire routines (fasthall.start, resistivity.start, four_wire.start) stay on `chemlab call`"
    ],
    "contact": [
     "contact check [max-current=100mA max-voltage=10V points=11 r2=0.9999] runs contact_check.auto as job-N"
    ]
   },
   "params": {
    "manual": "M91 FastHall users manual pp. 11-33, 43-57 (SCPI command summary from p. 81)"
   }
  },
  "signatone_quadpro2": {
   "role": "primary",
   "verbs": {
    "contact": {
     "probe": {
      "cap": "probe.set_contact",
      "arg": "contact",
      "pos_slot": "probe.position_m",
      "target_slot": "probe.target_m",
      "down_value": 0.0,
      "max_s": 60
     },
     "check_alternative": "the QuadPro2 has no separate contact check; every map point reports its own fit (see `result`)"
    },
    "move": {
     "xy": {
      "cap": "stage.move",
      "x_arg": "x_m",
      "y_arg": "y_m",
      "busy": [
       "stage.moving"
      ],
      "max_s": 120
     }
    },
    "temp": {
     "reads": [
      "thermal.indicated_k"
     ]
    },
    "method": {
     "calls": [
      {
       "cap": "method.configure",
       "keys": {
        "current": {
         "arg": "fixed_current_a",
         "kind": "current",
         "also": {
          "auto_current": false
         }
        },
        "auto": {
         "arg": "auto_current"
        },
        "min-current": {
         "arg": "current_min_a",
         "kind": "current"
        },
        "max-current": {
         "arg": "current_max_a",
         "kind": "current"
        },
        "vrange": {
         "arg": "voltage_range_v",
         "kind": "voltage"
        },
        "compliance": {
         "arg": "voltage_compliance_v",
         "kind": "voltage"
        },
        "vmin": {
         "arg": "target_voltage_min_v",
         "kind": "voltage"
        },
        "vmax": {
         "arg": "target_voltage_max_v",
         "kind": "voltage"
        },
        "phase": {
         "arg": "phase_duration_s",
         "kind": "duration"
        },
        "settle": {
         "arg": "settling_s",
         "kind": "duration"
        },
        "calibration": {
         "arg": "require_calibration"
        },
        "warmup": {
         "arg": "require_warmup"
        }
       },
       "defaults": {
        "auto_current": "example",
        "current_min_a": "example",
        "current_max_a": "example",
        "fixed_current_a": "example",
        "voltage_range_v": "example",
        "voltage_compliance_v": "example",
        "target_voltage_min_v": "example",
        "target_voltage_max_v": "example",
        "phase_duration_s": "example",
        "settling_s": "example",
        "require_calibration": "example",
        "require_warmup": "example"
       }
      },
      {
       "cap": "map.configure",
       "keys": {
        "point": {
         "arg": "points",
         "record": [
          [
           "x_m",
           "length"
          ],
          [
           "y_m",
           "length"
          ]
         ],
         "sep": ",",
         "example": "20mm,0mm"
        },
        "edge": {
         "arg": "edge_exclusion_m",
         "kind": "length"
        },
        "thickness": {
         "arg": "thickness_prior_m",
         "kind": "length"
        }
       },
       "need": [
        "point"
       ],
       "defaults": {
        "edge_exclusion_m": "example",
        "thickness_prior_m": "example"
       }
      }
     ]
    },
    "calibrate": {
     "cap": "calibration.start",
     "keys": {
      "ref": {
       "arg": "reference_sheet_resistance_ohm_sq",
       "kind": "sheet_resistance"
      }
     },
     "need": [
      "ref"
     ]
    },
    "start": {
     "cap": "acquisition.start"
    },
    "stop": {
     "cap": "acquisition.stop"
    },
    "result": {
     "cap": "acquisition.result",
     "show": {
      "statistics.mean_ohm_sq": [
       "mean sheet resistance",
       "sheet_resistance"
      ],
      "statistics.relative_std_percent": [
       "non-uniformity (%)",
       null
      ],
      "selected_current_a": [
       "current",
       "current"
      ],
      "calibration_gain": [
       "calibration gain",
       null
      ]
     },
     "per_item": {
      "path": "rows",
      "label": "point",
      "fields": {
       "x_m": [
        "x",
        "length"
       ],
       "y_m": [
        "y",
        "length"
       ],
       "sheet_resistance_ohm_sq": [
        "Rs",
        "sheet_resistance"
       ]
      }
     }
    },
    "analyze": {
     "default": "sheet",
     "models": {
      "sheet": {
       "cap": "analysis.sheet_resistance",
       "pick": {
        "key": "point",
        "path": "rows"
       },
       "min_rows": 1,
       "objects": {
        "observations": {
         "from": "it.observations",
         "fields": [
          "configuration",
          "current_a",
          "voltage_v"
         ]
        }
       },
       "scalars": {
        "x_m": "it:x_m",
        "y_m": "it:y_m",
        "calibration_gain": "result:calibration_gain|1.0"
       },
       "keys": {
        "point": {
         "ctl": "point",
         "kind": "number"
        },
        "diameter": {
         "arg": "diameter_m",
         "kind": "length"
        },
        "spacing": {
         "arg": "spacing_m",
         "kind": "length"
        },
        "thickness": {
         "arg": "thickness_prior_m",
         "kind": "length"
        }
       },
       "need": [
        "diameter"
       ],
       "defaults": {
        "spacing_m": "example",
        "thickness_prior_m": "example"
       }
      }
     },
     "example": "sheet diameter=100mm point=1"
    }
   },
   "slots": {
    "power": "power.enabled",
    "temp": "thermal.indicated_k",
    "phase": "acquisition.phase",
    "stage": "acquisition.stage",
    "points": "acquisition.points",
    "sample": "sample.present",
    "probe": "probe.position_m",
    "x": "stage.x_m",
    "y": "stage.y_m",
    "warmup": "source.warmup_ready",
    "calibration": "calibration.valid",
    "sheet": "measurement.last_sheet_resistance_ohm_sq"
   },
   "requires": {
    "contact-on": [
     {
      "slot": "power.enabled",
      "code": "POWER_OFF",
      "message": "{inst} is switched off.",
      "fix": "switch it on: `chemlab run {inst} power on`.",
      "label": "power on",
      "truthy": true
     },
     {
      "slot": "sample.present",
      "code": "NO_SAMPLE",
      "message": "no wafer is on the chuck of {inst}.",
      "fix": "the lab operator places the wafer; ask for it.",
      "label": "wafer on the chuck",
      "truthy": true
     },
     {
      "slot": "hood.angle_rad",
      "code": "HOOD_OPEN",
      "message": "the dark hood of {inst} is open; the probe goes down only with it closed.",
      "fix": "the lab operator closes the hood; ask for it.",
      "label": "hood closed",
      "max": 1e-09
     },
     {
      "slot": "stage.moving",
      "code": "MOVING",
      "message": "the stage of {inst} is still moving.",
      "fix": "wait (`chemlab wait 5`), then retry.",
      "label": "stage at rest",
      "falsy": true
     }
    ],
    "contact-off": [
     {
      "slot": "power.enabled",
      "code": "POWER_OFF",
      "message": "{inst} is switched off.",
      "fix": "switch it on: `chemlab run {inst} power on`.",
      "label": "power on",
      "truthy": true
     }
    ],
    "move-xy": [
     {
      "slot": "power.enabled",
      "code": "POWER_OFF",
      "message": "{inst} is switched off.",
      "fix": "switch it on: `chemlab run {inst} power on`.",
      "label": "power on",
      "truthy": true
     },
     {
      "slot": "probe.position_m",
      "code": "PROBE_DOWN",
      "message": "the probe of {inst} is down on the wafer; the stage moves only with it lifted.",
      "fix": "lift it: `chemlab run {inst} contact off`.",
      "label": "probe lifted",
      "min": 0.0099
     }
    ],
    "method": [
     {
      "slot": "power.enabled",
      "code": "POWER_OFF",
      "message": "{inst} is switched off.",
      "fix": "switch it on: `chemlab run {inst} power on`.",
      "label": "power on",
      "truthy": true
     }
    ],
    "calibrate": [
     {
      "slot": "power.enabled",
      "code": "POWER_OFF",
      "message": "{inst} is switched off.",
      "fix": "switch it on: `chemlab run {inst} power on`.",
      "label": "power on",
      "truthy": true
     }
    ],
    "start": [
     {
      "slot": "power.enabled",
      "code": "POWER_OFF",
      "message": "{inst} is switched off.",
      "fix": "switch it on: `chemlab run {inst} power on`.",
      "label": "power on",
      "truthy": true
     },
     {
      "slot": "sample.present",
      "code": "NO_SAMPLE",
      "message": "no wafer is on the chuck of {inst}.",
      "fix": "the lab operator places the wafer; ask for it.",
      "label": "wafer on the chuck",
      "truthy": true
     },
     {
      "slot": "hood.angle_rad",
      "code": "HOOD_OPEN",
      "message": "the dark hood of {inst} is open.",
      "fix": "the lab operator closes the hood; ask for it.",
      "label": "hood closed",
      "max": 1e-09
     }
    ]
   },
   "unsupported": {
    "set-field": "no magnet control: the field is set by the lab (or not used)",
    "set-temp": "no temperature chuck in this set-up (the TCR option is not fitted)",
    "wait-temp": "no set point to wait for"
   },
   "notes": {
    "method": [
     "method point=X,Y (repeatable) edge=3mm sets the map (map.configure); current=1mA switches to a fixed current (auto_current off)",
     "the example method requires a calibration (require_calibration=true): calibrate on a standard, or set calibration=false"
    ],
    "start": [
     "start runs the whole map: lift, move, lower, measure at every point (the stage and probe move by themselves)"
    ]
   },
   "params": {
    "manual": "QuadPro2 data sheet rev 1.7 pp. 1-6, 8-15; Keithley 2450 reference manual pp. 80-121"
   }
