  "lakeshore_8604vsm": {
   "role": "primary",
   "verbs": {
    "move": {
     "lift": {
      "cap": "sample.set_lift",
      "arg": "lift_m",
      "pos_slot": "sample.lift_m",
      "target_slot": "sample.target_lift_m",
      "max_s": 180
     },
     "angle": {
      "cap": "sample.set_angle",
      "arg": "angle_rad",
      "pos_slot": "sample.angle_rad",
      "target_slot": "sample.target_angle_rad",
      "max_s": 180
     }
    },
    "set-field": {
     "cap": "field.set_target",
     "arg": "field_t",
     "rate_arg": "ramp_rate_t_s"
    },
    "temp": {
     "reads": [
      "thermal.sample_k",
      "field.indicated_t"
     ]
    },
    "method": {
     "calls": [
      {
       "cap": "coil.configure",
       "keys": {
        "coupling": {
         "arg": "nominal_coupling_wb_per_a_m3"
        },
        "range": {
         "arg": "moment_range_a_m2",
         "kind": "moment"
        }
       },
       "defaults": {
        "nominal_coupling_wb_per_a_m3": "example",
        "moment_range_a_m2": "example"
       }
      },
      {
       "cap": "vibration.configure",
       "keys": {
        "vibrate": {
         "arg": "enabled"
        },
        "amplitude": {
         "arg": "amplitude_m",
         "kind": "length"
        },
        "vfreq": {
         "arg": "frequency_hz",
         "kind": "frequency"
        }
       },
       "defaults": {
        "enabled": {
         "value": true,
         "why": "vibration on"
        },
        "amplitude_m": "example",
        "frequency_hz": "example"
       }
      },
      {
       "cap": "method.configure",
       "keys": {
        "field": {
         "arg": "field_points_t",
         "kind": "magnetic_field",
         "list": true
        },
        "loop": {
         "arg": "field_points_t",
         "kind": "magnetic_field",
         "loop": true
        },
        "rate": {
         "arg": "ramp_rate_t_s",
         "kind": "field_rate"
        },
        "average": {
         "arg": "averaging_time_s",
         "kind": "duration"
        },
        "settle": {
         "arg": "settling_time_s",
         "kind": "duration"
        },
        "calibration": {
         "arg": "require_calibration"
        }
       },
       "need": [
        "field"
       ],
       "defaults": {
        "ramp_rate_t_s": "example",
        "averaging_time_s": "example",
        "settling_time_s": "example",
        "require_calibration": "example"
       }
      }
     ]
    },
    "calibrate": {
     "cap": "calibration.start",
     "keys": {
      "moment": {
       "arg": "reference_moment_a_m2",
       "kind": "moment"
      },
      "field": {
       "arg": "field_t",
       "kind": "magnetic_field"
      },
      "average": {
       "arg": "averaging_time_s",
       "kind": "duration"
      }
     },
     "need": [
      "moment"
     ],
     "defaults": {
      "field_t": "example",
      "averaging_time_s": "example"
     }
    },
    "start": {
     "cap": "acquisition.start"
    },
    "stop": {
     "cap": "acquisition.stop"
    },
    "result": {
     "cap": "acquisition.result",
     "columns": {
      "field_t": [
       "field",
       "magnetic_field"
      ],
      "moment_a_m2": [
       "moment",
       "moment"
      ]
     }
    },
    "analyze": {
     "default": "loop",
     "models": {
      "loop": {
       "cap": "analysis.loop",
       "pass_rows": "rows"
      }
     },
     "example": "loop"
    }
   },
   "slots": {
    "power": "power.enabled",
    "temp": "thermal.sample_k",
    "field": "field.indicated_t",
    "field_set": "field.target_t",
    "moment": "moment.indicated_a_m2",
    "phase": "acquisition.phase",
    "stage": "acquisition.stage",
    "points": "acquisition.points",
    "sample": "sample.present",
    "lift": "sample.lift_m",
    "vibration": "vibration.enabled",
    "calibration": "calibration.valid"
   },
   "requires": {
    "move-lift": [
     {
      "slot": "power.enabled",
      "code": "POWER_OFF",
      "message": "{inst} is switched off.",
      "fix": "switch it on: `chemlab run {inst} power on`.",
      "label": "power on",
      "truthy": true
     },
     {
      "slot": "vibration.enabled",
      "code": "VIBRATING",
      "message": "the sample rod of {inst} is vibrating; it moves only at rest.",
      "fix": "stop it: `chemlab run {inst} method vibrate=off`.",
      "label": "vibration off",
      "falsy": true
     },
