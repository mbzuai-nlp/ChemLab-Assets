    "stop": "no stop capability: each move is one atomic motion",
    "open": "no door or lid (the gripper closes with pick and opens with place)",
    "close": "no door or lid (the gripper closes with pick)"
   },
   "alternatives": {
    "start": "use `chemlab run INST move POSE`, `pick NAME`, `place NEST`"
   },
   "params": {
    "move_max_s": 60.0
   },
   "view": [
    {
     "label": "power",
     "slot": "power.enabled"
