{
 "class": "liquid",
 "adapter": "chemlab.compile.classes.liquid:LiquidAdapter",
 "about": "Liquid handling (the Flex pilot gate moved into the compile framework). The deck (labware, tips, trash) is lab-config data in the instrument's entry: \"deck\": {...} (chemlab/compile/deck.py), and the trusted host side is the entry's \"scene\": \"chemlab.compile.scenes.flex:FlexScene\". Without a deck only power, home, lights, status, protocols and the admin verbs work.",
 "membership": {
  "decided": "2026-10-22",
  "members": [
   "opentrons_flex_single_5_1000ul",
   "newera_ne1000"
  ],
  "newera_ne1000": "added 2026-10-22: syringe pump with its own adapter (classes/syringe_pump.py); the Flex verbs are unchanged"
 },
 "members": {
  "opentrons_flex_single_5_1000ul": {
   "role": "primary",
   "verbs": {
    "power": {
     "cap": "power.set",
     "arg": "enabled"
    },
    "home": {
     "cap": "robot.home"
    },
    "lights": {
     "cap": "robot.set_lights",
     "arg": "on"
    },
    "labware": {
     "reads": [
      "deck.fixtures"
     ]
    },
    "move-to": {
     "cap": "motion.move"
    },
    "pick-up-tip": {
     "move_cap": "motion.move",
     "cap": "tip.attach",
     "arg": "tip_id"
    },
    "drop-tip": {
     "move_cap": "motion.move",
     "cap": "tip.release",
     "arg": "target_slot_id"
    },
    "return-tip": {
     "move_cap": "motion.move",
     "cap": "tip.release",
     "arg": "target_slot_id"
    },
    "aspirate": {
     "move_cap": "motion.move",
     "cap": "sample.aspirate",
     "container_arg": "container_id",
     "volume_arg": "volume_m3"
    },
    "dispense": {
     "move_cap": "motion.move",
     "cap": "sample.dispense",
     "container_arg": "container_id",
     "volume_arg": "volume_m3"
    },
    "transfer": {
     "caps": [
      "motion.move",
      "tip.attach",
      "sample.aspirate",
      "sample.dispense",
      "tip.release"
     ]
    },
    "protocols": {
     "reads": [
      "protocols.list"
     ]
    },
    "run-protocol": {
     "setup_cap": "run.setup",
     "parameter_cap": "run.set_parameter",
     "confirm_cap": "run.confirm_parameters",
     "update_deck_cap": "run.update_deck",
     "offsets_cap": "run.apply_offsets",
     "play_cap": "run.play",
     "stop_cap": "run.stop"
    },
    "job": {
     "reads": [
      "run.state",
      "run.history"
     ]
    },
    "pause": {
     "cap": "run.pause"
    },
    "resume": {
     "cap": "run.play"
    },
    "cancel": {
     "cap": "run.stop"
    },
    "recover": {
     "cap": "run.recover",
     "arg": "action"
    },
    "pipettes": {
     "reads": [
      "instruments.mounts"
     ]
    },
    "calibrate-pipette": {
     "cap": "instrument.calibrate"
    },
    "attach-pipette": {
     "cap": "instrument.attach"
    },
    "detach-pipette": {
     "cap": "instrument.detach"
    },
    "deck-config": {
     "cap": "deck.configure"
    },
    "settings": {
     "cap": "robot.configure"
    },
    "set-name": {
     "cap": "robot.set_name"
    },
    "restart": {
     "cap": "robot.restart"
    },
    "shutdown": {
     "cap": "robot.shutdown"
    },
    "protocol-pin": {
     "cap": "protocol.pin"
    },
    "protocol-delete": {
     "cap": "protocol.delete"
    },
    "device-reset": {
     "cap": "robot.device_reset"
    }
   },
   "slots": {
    "power": "power.enabled",
    "tip": "tip.attached_id",
    "run": "run.state"
   },
   "unsupported": {
    "mix": "mixing is not modelled in this twin (sample.mix is unsupported); mixing after each addition is assumed ideal",
    "detect-liquid": "there is no liquid-level sensing in this twin (liquid_level.detect is unsupported); a refused aspirate tells you the source is short",
    "set-flow-rate": "flow rates are not modelled (velocity.set is unsupported); leave the defaults",
    "blow-out": "blow-out is not modelled: the volume ledger leaves no residue in the tip",
    "touch-tip": "touch-tip is not modelled and not needed in this twin",
    "air-gap": "air gaps are not modelled and not needed in this twin",
    "move-labware": "this Flex has no gripper; labware stays where the deck registry says (`labware`)",
    "distribute": "use `transfer` with one source and several destinations",
    "consolidate": "use `transfer` with several sources and one destination"
   },
   "alternatives": {
    "distribute": "chemlab run INST transfer --from reservoir:A1 --to plate:A1-A6 --volume 50",
    "consolidate": "chemlab run INST transfer --from plate:A1,plate:A2 --to tuberack:A1 --volume 50",
    "mix": "repeat aspirate / dispense in the same well if you must; the twin treats mixing as ideal"
   },
   "params": {
    "fixture_slots": {
     "trash_bin": [
      "A1",
      "B1",
      "C1",
      "D1",
      "A3",
      "B3",
      "C3",
      "D3"
     ],
     "staging_area": [
      "A3",
      "B3",
      "C3",
      "D3"
     ],
     "waste_chute": [
      "D3"
     ],
     "waste_chute_staging": [
      "D3"
     ]
    },
    "setting_values": {
     "brightness_level": [
      1,
      2,
      3,
      4,
      5,
      6
     ],
     "sleep_min": [
      "never",
      3,
      5,
      10,
      15,
      30,
      60
     ],
     "language": [
      "English",
      "Chinese"
     ],
     "update_channel": [
      "stable",
      "beta"
     ]
    }
   },
   "notes": {
    "transfer": [
     "chunks larger than the tip are split into equal trips; a tip lost on the way is reported, never silently replaced"
    ],
    "run-protocol": [
     "the run is a job: chemlab status|wait|cancel job-N; tips used by the run are confirmed by the lab's scene"
    ]
   }
  },
