njector_module","column_oven_module","detector_module"],"write_via":null},"column_oven.actual_temperature_k":{"meaning_zh":"实际柱温未建模，返回null；不能用目标温度冒充温度真值。","unit":"K","access":"read_only","origin":"derived","component_ids":["column_oven_module"],"write_via":null},"pump.actual_pressure_pa":{"meaning_zh":"实际泵压未建模，返回null；不能用600bar额定上限冒充实际压力。","unit":"Pa","access":"read_only","origin":"derived","component_ids":["pump_module"],"write_via":null},"run.status":{"meaning_zh":"本次运行状态idle/running/succeeded/cancelled；accepted仅表示开始运行。","unit":"1","access":"read_only","origin":"derived","component_ids":["pump_module","injector_module","column_oven_module","detector_module"],"write_via":null},"run.operation_id":{"meaning_zh":"当前实例运行标识；poll/cancel按操作所属身份约束。","unit":"1","access":"read_only","origin":"derived","component_ids":["pump_module","injector_module","column_oven_module","detector_module"],"write_via":null},"run.elapsed_s":{"meaning_zh":"由宿主绝对时间计算的已采集时长；查询不推进它。","unit":"s","access":"read_only","origin":"derived","component_ids":["pump_module","injector_module","column_oven_module","detector_module"],"write_via":null},"measurement.chromatogram":{"meaning_zh":"最后一次已开始运行的部分或最终合成色谱：时间s、无量纲任意信号、积分s；synthetic=true，纯度和校准浓度为null。","unit":"1","access":"read_only","origin":"derived","component_ids":["detector_module"],"write_via":null},"measurement.count":{"meaning_zh":"已完成到succeeded的运行次数；取消不增加计数。","unit":"1","access":"read_only","origin":"derived","component_ids":["detector_module"],"write_via":null}},"mechanisms":{"synthetic_chromatography":{"meaning_zh":"遵循装样、关门、方法、运行、返回色谱语义的合成过程；过程运行不等于真实LC流体、热或分离模型。","implementation":"numerical","equations":["s(t)=sum_j a_j*exp(-0.5*((t-c_j)/w_j)^2)，c_j、w_j、a_j为明确标synthetic的任意教学峰参数，不是物理保留时间/峰宽。","A=sum_i (s_i+s_(i-1))*(t_i-t_(i-1))/2，合成无量纲信号的梯形积分单位为s；不推断真实纯度或浓度。","elapsed=min(host_time-start_time,method.run_duration_s)；只有host_advance推进运行，read/poll不推进。"],"parameters":{"flow_minimum_m3_s":{"value":1.6666666666666667e-11,"unit":"m3/s","evidence":"documented","meaning_zh":"flow_minimum_m3_s"},"flow_maximum_m3_s":{"value":1.6666666666666668e-07,"unit":"m3/s","evidence":"documented","meaning_zh":"flow_maximum_m3_s"},"injection_volume_minimum_m3":{"value":1e-10,"unit":"m3","evidence":"documented","meaning_zh":"injection_volume_minimum_m3"},"injection_volume_maximum_m3":{"value":1e-07,"unit":"m3","evidence":"documented","meaning_zh":"injection_volume_maximum_m3"},"system_maximum_pressure_pa":{"value":60000000.0,"unit":"Pa","evidence":"documented","meaning_zh":"Whole-system ceiling; not a module pressure or predicted operating pressure."},"column_maximum_temperature_k":{"value":358.15,"unit":"K","evidence":"documented","meaning_zh":"column_maximum_temperature_K"},"column_minimum_temperature_offset_k":{"value":-10.0,"unit":"K","evidence":"documented","meaning_zh":"MCT catalog capability subject to ambient; model validates target only and does not establish exact MCT hardware configuration."},"wavelength_range_m":{"value":null,"unit":"m","evidence":"unknown","meaning_zh":"wavelength_range_m"},"actual_pressure_pa":{"value":null,"unit":"Pa","evidence":"unknown","meaning_zh":"actual_pressure_Pa"},"actual_temperature_k":{"value":null,"unit":"K","evidence":"unknown","meaning_zh":"actual_temperature_K"},"acquisition_duration_s":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"Run duration is supplied by caller; not an inferred vendor acquisition speed."},"door_maximum_angle_rad":{"value":1.5707963267948966,"unit":"rad","evidence":"assumption","meaning_zh":"door_maximum_angle_rad"},"door_loading_clearance_rad":{"value":1.0471975511965976,"unit":"rad","evidence":"assumption","meaning_zh":"door_loading_clearance_rad"},"door_closed_tolerance_rad":{"value":1e-06,"unit":"rad","evidence":"assumption","meaning_zh":"door_closed_tolerance_rad"},"default_host_ambient_k":{"value":298.15,"unit":"K","evidence":"assumption","meaning_zh":"default_host_ambient_K"},"maximum_run_duration_s":{"value":86400,"unit":"s","evidence":"assumption","meaning_zh":"maximum_run_duration_s"},"maximum_samples":{"value":10001,"unit":"1","evidence":"assumption","meaning_zh":"maximum_samples"},"default_gaussian_peaks":{"value":[[20.0,2.0,1.0],[40.0,3.0,0.7]],"unit":"s,s,1","evidence":"assumption","meaning_zh":"default_gaussian_peaks"}}}},"limitations":["full表示本次标准外形教学配置的全部已建功能组件已登记；并不表示厂家全套功能、精确模块SKU或动态真实性已完成。","396×660×468 mm标准堆叠与435×800×468 mm MCT配置尺寸分开记录。本模型采用标准外形，85°C/MCT能力保留其配置条件，不能据此认证标准几何含真实MCT模块。","四个功能模块单独建模；内部结构、面板、接口、样品瓶、托架和管路局部尺寸为仿真假设，非制造CAD。","整机与所有部件质量、密度、摩擦和真实惯量未知为null；仅给均匀包围盒每单位质量I/m系数。URDF无inertial，不能直接声称已完成动力学。","门采用连续URDF旋转关节以避免捏造effort/velocity；本软件0..π/2范围是教学假设，非厂商认证机械限位。","碰撞体仅使用box/cylinder/sphere基元；存在碰撞代理不等于已验证接触动力学或机器人可达性。","运行参数范围来自清单并换算SI；实际泵压力/温度、真实响应、噪声、校准浓度、真实纯度与故障概率未标定。","流量10mL/min与系统600bar是清单分别列出的上限，未建立联合性能包络；不宣称两个极值在同一运行条件下同时实现。","合成色谱必须标synthetic；不宣称进样体积守恒、梯度溶剂消耗或厂家检测性能。","准备动作保留上次运行波形，波形不会随新设定自动重算；取消保留部分数据，调用者须按运行记录关联样品与方法。","状态和命令按运行会话过滤；共享Python进程或文件系统不是安全隔离沙箱。read/poll不推进时间，异步运行由宿主管理时间。","机器人、真实硬件、碰撞接触动力学及物理性能标定均未运行。","官方III代系统手册已在线读取并记录版本；对应模块手册PDF归档与精确模块几何版本仍待补。下载尝试曾在审批长期挂起后被中止，本合同只按实际存在文件登记artifact，不把在线阅读写成已归档PDF。","All acquired signals are arbitrary synthetic Gaussian fixtures, unit 1; they are not calibrated absorbance, detector current, chemical identities or real sample response.","Flow, injection, gradient, wavelength and column-temperature settings are recorded and validated but do not parameterize the arbitrary fixture response.","No hydraulic, thermal, solvent transfer, injection-volume consumption, gradient mixing, equilibration, noise or fault-probability model.","Purity and calibrated concentration remain null; dedicated capabilities explicitly return unsupported.","Actual pressure and temperature remain null; pressure-limit settings alone do not prove a pressure safety interlock.","Host-owned time drives sampling; no implicit stepping in read, describe, poll or chromatogram retrieval.","Scene callback success needs independent evaluated-pose verification; no robot or hardware driver.","Access filtering is an API boundary, not protection against trusted Python-host introspection or filesystem access.","Request deduplication and operation ownership are per-instance, per-principal, in-memory only.","Synchronous callback failure leaves process uncommitted but may have unknown external scene side effects.","2026-10 模板路径：保留时间由 XLogP 推算（derived_assumption，非实测柱保留），死体积/塔板数/流通池光程为假设；仅吸光度曲线来自 NIST 实测谱。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["chromatography.get_chromatogram","chromatography.measure","chromatography.set_method","chromatography.stop","door.set_angle","mobile_phase.set_available","power.set","sample.load","sample.unload"],"unsupported":[],"note_zh":"桥接 basic40_runtime_analytical.AgilentHPLC1260Runtime（推进方式 host_advance_abs），24 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（1 个门/盖/阀等被动关节）；1 个门/盖/升降关节与运行层双向同步；接口点 4 个（孔位、放置面）；布局：台面、单人可搬、正面 −y、前方留空 0.25 m；面板为菜单/文字屏（待办）"}},"previews":["previews/agilent_hplc1260/preview_closed.webp","previews/agilent_hplc1260/preview_open.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t3_analytical/agilent_hplc1260/asset.contract.json","bytes":320703},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t3_analytical/agilent_hplc1260/collision_proxies.json","bytes":18988},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t3_analytical/agilent_hplc1260/geometry_manifest.json","bytes":40336},{"name":"model.blend","path":"assets/basic40_batch02/t3_analytical/agilent_hplc1260/model.blend","bytes":593359},{"name":"model.glb","path":"assets/basic40_batch02/t3_analytical/agilent_hplc1260/model.glb","bytes":1975504},{"name":"model.urdf","path":"assets/basic40_batch02/t3_analytical/agilent_hplc1260/model.urdf","bytes":18591}],"completeness":{"components":15,"with_collisions":14,"with_objects":15,"with_function":15,"with_mass":0,"joints_matching_component":1,"joints":1,"has_contract":true,"has_layout":true,"has_glb":true,