h":"宿主气温代理，不是温度传感器实测。","unit":"K","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"measurement.total_standard_volume_m3":{"meaning_zh":"本累计区间已积分的标准体积当前值；不代表宿主已完成气体库存转移。","unit":"m^3","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"measurement.standard_accuracy_bound_m3_s":{"meaning_zh":"归零且宿主确认平衡时计算max(0.006|Q|,0.001FS)；是规格界限表达，不是实测误差。","unit":"m^3/s","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"measurement.accuracy_conditions_met":{"meaning_zh":"合成模型中归零及宿主平衡条件成立标志；不是固定等待时长判据。","unit":"1","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"truth.standard_flow_m3_s":{"meaning_zh":"宿主合成过程的标准体积流量真值，限debug/evaluator。","unit":"m^3/s","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.total_standard_volume_m3":{"meaning_zh":"宿主合成过程的积分标准体积真值，限debug/evaluator。","unit":"m^3","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.upstream_pressure_pa":{"meaning_zh":"宿主提供上游绝压，限debug/evaluator。","unit":"Pa","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.downstream_pressure_pa":{"meaning_zh":"宿主提供下游绝压，限debug/evaluator。","unit":"Pa","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.temperature_k":{"meaning_zh":"宿主提供气体温度，限debug/evaluator。","unit":"K","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.equilibrium":{"meaning_zh":"宿主明确声明平衡，不由固定时间自动推出。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.no_flow":{"meaning_zh":"宿主明确声明无流，未知流量不能代替此条件。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.response_time_constant_s":{"meaning_zh":"宿主显式假设的一阶tau；缺省null，不默认采用30ms。","unit":"s","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null}},"mechanisms":{"synthetic_flow_process":{"meaning_zh":"有明确宿主气路边界与显式tau后的一阶合成流量过程；不求解真实压差流动或PID。","implementation":"lumped","equations":["Q_next = Q_target + (Q_old-Q_target)*exp(-dt/tau)，仅有明确tau、归零、有效温压与正向压差等前提时推进。","ΔV_std = Q_old*dt + (Q_target-Q_old)*(dt-tau*(1-exp(-dt/tau)))；累计量是积分账面值，不是宿主物质转移事务。","Q_actual = Q_std*(T/T_ref)*(P_ref/P_upstream)，理想气体、上游压力代理。","mass_flow = Q_std*P_ref*M/(R*T_ref)，M未知时返回null。","accuracy_bound = max(0.006*abs(Q),0.001*FS)，仅合成归零且宿主明确平衡时提供。"],"parameters":{"full_scale_standard_flow_m3_s":{"value":1.6666666666666667e-05,"unit":"m^3/s","evidence":"documented","meaning_zh":"full_scale_standard_flow_m3_s"},"minimum_positive_control_m3_s":{"value":1.666666666666667e-09,"unit":"m^3/s","evidence":"documented","meaning_zh":"minimum_positive_control_m3_s"},"fastest_control_t63_s":{"value":0.03,"unit":"s","evidence":"documented","meaning_zh":"配置与调整相关的最快T63，非稳定时间且不设为默认tau"},"default_reference_temperature_k":{"value":298.15,"unit":"K","evidence":"documented","meaning_zh":"default_reference_temperature_K"},"default_reference_pressure_pa":{"value":101325.0,"unit":"Pa","evidence":"documented","meaning_zh":"default_reference_pressure_Pa"},"default_dynamic_time_constant_s":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"default_dynamic_time_constant_s"},"gas_molar_mass_kg_mol":{"value":null,"unit":"kg/mol","evidence":"unknown","meaning_zh":"gas_molar_mass_kg_mol"},"valve_travel_m":{"value":null,"unit":"m","evidence":"unknown","meaning_zh":"valve_travel_m"},"pid_gains":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"实际参数结构及单位未知；1仅为此未知占位项的合同单位"},"operating_absolute_pressure_range":{"value":[79289.708871432,1103161.16690688],"unit":"Pa","evidence":"documented","meaning_zh":"工作绝压范围11.5–160PSIA，精确单位换算；并非压差。"},"operating_temperature_range":{"value":[263.15,333.15],"unit":"K","evidence":"documented","meaning_zh":"工作温度−10至60°C。"},"standard_accuracy_relative_reading":{"value":0.006,"unit":"1","evidence":"documented","meaning_zh":"标准精度读数比例项，须与FS项取较大绝对误差。"},"standard_accuracy_relative_full_scale":{"value":0.001,"unit":"1","evidence":"documented","meaning_zh":"标准精度FS比例项，需归零与平衡条件。"},"full_scale_air_pressure_drop":{"value":10342.135939752,"unit":"Pa","evidence":"documented","meaning_zh":"1SLPM满量程空气排大气时压降1.5PSID；不是所有气体、流量和背压下通用值。"},"documented_gas_count":{"value":98,"unit":"1","evidence":"documented","meaning_zh":"厂家可选气体数量；本批未复制数据库。"},"documented_mixture_definitions_maximum":{"value":20,"unit":"1","evidence":"documented","meaning_zh":"厂家混气定义数量上限；本批未实现混气数据库。"},"gas_viscosity":{"value":null,"unit":"Pa*s","evidence":"unknown","meaning_zh":"气体黏度未知，未虚构98种气体性质。"},"compressibility_factor":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"真实气体压缩因子未知；换算采用理想气体假设。"},"physical_settling_time":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"物理稳定时间未知，不从30ms T63编造。"}}},"gas_network_topology":{"meaning_zh":"上游节点→进气口→传感区→常闭调节阀→出气口→下游节点的功能拓扑。串联路径是模块接口抽象，非制造商内部流道结构复刻。","implementation":"qualitative","equations":[],"parameters":{}}},"limitations":["仅为合成过程与接口实现，无硬件驱动、机器人或真实阀动作。","气体兼容性由可信宿主登记；厂家98种气体和20个混气定义的数据库未实现。未知摩尔质量及性质保持null。","动态没有缺省时间常数。宿主必须给出明确假设及证据；最快T63 30 ms不是稳定时间，也不自动作为tau。","简化一阶模型仅在有效供压/背压和温度条件下使用。阀特性、压降曲线、PID、真实稳定判据和非理想气体性质未实现。","模型读数均为estimated；压力使用上游边界代理，温度使用宿主气温代理。不是实测传感器或厂家精度验证。","精度界限仅在归零且宿主声明平衡时计算 max(0.006|Q|,0.001FS)；不生成误差分布，不从固定时长推断平衡。","标准流量和累计标准体积使用当前参考条件；改气体/参考条件使归零和读数失效并开启新累计量区间。","参考条件配置采用仿真定义：1 SLPM数值量程按当前参考条件解释；不声称复现厂商改变标准温压后内部标度处理。","气路节点引用由宿主保管。本适配器不做气源库存、守恒物质转移或压力网络求解，后续气路宿主需接入这些过程。","重放去重仅当前宿主内存有效，不声称跨重启恰好一次。API过滤不是Python或文件系统隔离。","所有外露部件采用刚性固定装配。无可靠内部阀行程，不制造可动关节；按钮位移与真实触碰未实现。","外形遵守91.1×26.7×103.3mm标称尺寸；局部艺术细节、端口端面x位置及法线方向为建模假设，不是加工图。","整机质量约0.5kg；URDF只有聚合根使用该质量与均匀盒近似惯量，单部件mass/inertia均null，不能重复计重。","URDF碰撞体只采用盒、柱、球基元；文件结构或Blender姿态验证不等于物理接触、稳定放置、碰撞或摩擦性能验证。","静态显示屏和流向标识不与运行观测自动同步。GLB/OBJ为场景交换输出；本批未声称任何引擎中的物理求解兼容性。","整机搬运的attach/release由宿主约束事件负责；事件在合同中声明，未实现抓取、附着、释放或机器人动作。","合同稳定状态ID使用小写；真实运行API保留温度K和压力Pa后缀。请按runtime_state_id_map映射或使用read_binding，不能直接把规范ID当作真实API参数。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["flow.read","flow.reset_total","flow.set_setpoint","flow.zero","gas.select","gas.set_reference_conditions","power.set"],"unsupported":["control.set_pid"],"note_zh":"桥接 basic40_runtime_automation.AlicatMCRuntime（推进方式 host_step_dt），25 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（7 个按键（碰到即触发））；接口点 0 个（无）；布局：台面、机器人可搬、正面 −y、前方留空 0.25 m；面板读数 flow(4)"}},"previews":["previews/alicat_mc_1slpm_rev6/preview_front.webp","previews/alicat_mc_1slpm_rev6/preview_inlet.webp","previews/alicat_mc_1slpm_rev6/preview_perspective.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t5_automation/alicat_mc/asset.contract.json","bytes":262852},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t5_automation/alicat_mc/collision_proxies.json","bytes":1513},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t5_automation/alicat_mc/geometry_manifest.json","bytes":13710},{"name":"model.blend","path":"assets/basic40_batch02/t5_automation/alicat_mc/model.blend","bytes":200026},{"name":"model.glb","path":"assets/basic40_batch02/t5_automation/alicat_mc/model.glb","bytes":515748},{"name":"model.urdf","path":"assets/basic40_batch02/t5_automation/alicat_mc/model.urdf","bytes":4759}],"completeness":{"components":11,"with_collisions":0,"with_objects":11,"with_function":11,"with_mass":0,"joints_matching_component":0,"joints":7,"has_contract":true,"has_layout":true,"has_glb":true,"checks_present":["articulation_check","coverage","validation_summary","contract_validation","runtime_validation","scene_validation"]},"slug":"alicat_mc_1slpm_rev6","chem_id":"CHEM-180","name_en":"Gas mass-flow controller","maker":"Alicat Scientific","model":"MC, 1 SLPM full scale, Rev6","domain":"automation","domain_name":"Automation & Gas/Liquid Supply","path":"ass