hardware":"absent"},"input":["percent"]},"fault.inject":{"function_zh":"评测者：注入手册p.6的状态消息ADC（模数转换器错误），主显示在读数右侧显示ADC，直到fault.clear；用于测试视觉agent对状态消息的处理（手册未写其它行为）。","kind":"simulation","availability":"implemented","component_ids":["display_screen","sensor_block"],"implementation":{"process":"verified","host":"verified","scene":"absent","robot":"absent","hardware":"absent"},"input":["code"]},"fault.clear":{"function_zh":"评测者：清除注入的ADC状态。","kind":"simulation","availability":"implemented","component_ids":["display_screen","sensor_block"],"implementation":{"process":"verified","host":"verified","scene":"absent","robot":"absent","hardware":"absent"},"input":[]}},"state_slots":{"power.enabled":{"meaning_zh":"仿真供电开关；不代表电气硬件。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["electrical_connector"],"write_via":"power.set"},"gas.selected_id":{"meaning_zh":"宿主登记的气体标识，或物性模板库气体ID（template.list）。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["sensor_block"],"write_via":"gas.select"},"gas.reference_temperature_k":{"meaning_zh":"标准体积参考温度；默认298.15K。","unit":"K","access":"read_only","origin":"setpoint","component_ids":["sensor_block"],"write_via":null},"gas.reference_pressure_pa":{"meaning_zh":"标准体积参考绝压；默认101325Pa。","unit":"Pa","access":"read_only","origin":"setpoint","component_ids":["sensor_block"],"write_via":null},"flow.setpoint_m3_s":{"meaning_zh":"标准体积流量目标；0为关闭目标，正目标范围0.01–100%FS。","unit":"m^3/s","access":"read_write","origin":"setpoint","component_ids":["valve_housing","control_pad"],"write_via":"flow.set_setpoint"},"flow.zeroed":{"meaning_zh":"合成归零记录；需要宿主确认无流与平衡。","unit":"1","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"ports.upstream_node_id":{"meaning_zh":"实例连接的上游气路节点标识。","unit":"1","access":"read_only","origin":"scene","component_ids":["gas_inlet"],"write_via":null},"ports.downstream_node_id":{"meaning_zh":"实例连接的下游气路节点标识。","unit":"1","access":"read_only","origin":"scene","component_ids":["gas_outlet"],"write_via":null},"simulation.dynamic_model_configured":{"meaning_zh":"宿主是否提供显式一阶时间常数与证据。","unit":"1","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"measurement.standard_flow_m3_s":{"meaning_zh":"合成标准体积流量观测；quality=estimated，不是独立实测。","unit":"m^3/s","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"measurement.actual_flow_m3_s":{"meaning_zh":"实际体积流量代理：宿主登记气体按理想气体换算；库气体按所选气体NIST真实气体密度换算。","unit":"m^3/s","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"measurement.mass_flow_kg_s":{"meaning_zh":"由标准流量与已知摩尔质量换算的质量流率；未知气体摩尔质量时为null。；库气体为Q_std×所选气体在参考温压下的NIST/派生密度。","unit":"kg/s","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"measurement.pressure_pa":{"meaning_zh":"上游绝压边界代理，不是压力传感器实测。","unit":"Pa","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"measurement.temperature_k":{"meaning_zh":"宿主气温代理，不是温度传感器实测。","unit":"K","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"measurement.total_standard_volume_m3":{"meaning_zh":"本累计区间已积分的标准体积当前值；不代表宿主已完成气体库存转移。","unit":"m^3","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"measurement.standard_accuracy_bound_m3_s":{"meaning_zh":"归零且宿主确认平衡时计算max(0.006|Q|,0.001FS)；是规格界限表达，不是实测误差。","unit":"m^3/s","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"measurement.accuracy_conditions_met":{"meaning_zh":"合成模型中归零及宿主平衡条件成立标志；不是固定等待时长判据。","unit":"1","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"truth.standard_flow_m3_s":{"meaning_zh":"宿主合成过程的标准体积流量真值，限debug/evaluator。","unit":"m^3/s","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.total_standard_volume_m3":{"meaning_zh":"宿主合成过程的积分标准体积真值，限debug/evaluator。","unit":"m^3","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.upstream_pressure_pa":{"meaning_zh":"宿主提供上游绝压，限debug/evaluator。","unit":"Pa","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.downstream_pressure_pa":{"meaning_zh":"宿主提供下游绝压，限debug/evaluator。","unit":"Pa","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.temperature_k":{"meaning_zh":"宿主提供气体温度，限debug/evaluator。","unit":"K","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.equilibrium":{"meaning_zh":"宿主明确声明平衡，不由固定时间自动推出。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.no_flow":{"meaning_zh":"宿主明确声明无流，未知流量不能代替此条件。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"truth.response_time_constant_s":{"meaning_zh":"宿主显式假设的一阶tau；缺省null，不默认采用30ms。","unit":"s","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null},"device.settings":{"meaning_zh":"前面板菜单的全部设备设置（自动归零、设定来源、上电设定值、上下限、控制回路、斜坡、单位、平均、零带、串口、显示）；menu.configure写入","unit":"1","access":"read_only","origin":"setpoint","component_ids":["control_pad","display_screen"],"write_via":null},"flow.active_setpoint_m3_s":{"meaning_zh":"控制器当前生效的目标（斜坡中的设定值；质量流量控制为标准流量，体积流量控制为入口实际流量）","unit":"m^3/s","access":"read_only","origin":"derived","component_ids":["valve_housing"],"write_via":null},"flow.ramp_rate_m3_s2":{"meaning_zh":"设定值斜坡最大速率 delta/time（0为关闭）","unit":"m^3/s^2","access":"read_only","origin":"derived","component_ids":["valve_housing"],"write_via":null},"setpoint.analog_input_v":{"meaning_zh":"Mini-DIN第4脚模拟设定输入电压（0–5 V，宿主给定；默认0 V即未接）","unit":"V","access":"read_only","origin":"scene","component_ids":["electrical_connector"],"write_via":null},"totalizer.batch_size_m3":{"meaning_zh":"总量器批量（标准体积；null为-NONE-）","unit":"m^3","access":"read_write","origin":"setpoint","component_ids":["display_screen","valve_housing"],"write_via":"totalizer.set_batch"},"totalizer.batch_remaining_m3":{"meaning_zh":"批量剩余（标准体积，示值）；0为-DONE-","unit":"m^3","access":"read_only","origin":"derived","component_ids":["display_screen"],"write_via":null},"totalizer.elapsed_s":{"meaning_zh":"总量器计时器（RESET或上电清零，最大9999:59:59）","unit":"s","access":"read_only","origin":"derived","component_ids":["display_screen"],"write_via":null},"display.backlight_on":{"meaning_zh":"单色LCD背光是否点亮","unit":"1","access":"read_write","origin":"setpoint","component_ids":["display_screen","logo_key"],"write_via":"display.set_backlight"},"display.locked":{"meaning_zh":"前面板是否被串口命令锁定（LCK）","unit":"1","access":"read_write","origin":"setpoint","component_ids":["display_screen"],"write_via":"display.set_lock"},"gas.user_mixes":{"meaning_zh":"COMPOSER自定义混气（编号236–255、短名、长名、2–5种成分摩尔百分比）","unit":"1","access":"read_only","origin":"setpoint","component_ids":["sensor_block"],"write_via":null},"gas.recent_ids":{"meaning_zh":"Gas Select的Recent列表（最近选用的5种气体）","unit":"1","access":"read_only","origin":"derived","component_ids":["sensor_block"],"write_via":null},"valve.drive_percent":{"meaning_zh":"阀驱动%=控制器输出：线性阀假设下当前流量所需驱动（100 %在1.5 PSID压差下通过满量程）；无流或反压而有设定时100 %，断电或零设定无流0 %；流量未定义时null","unit":"%","access":"read_only","origin":"derived","component_ids":["valve_housing"],"write_via":null},"valve.drive_setpoint_percent":{"meaning_zh":"控制变量为阀驱动时的设定值（阀驱动%，0–100）；valve.set_drive_setpoint或面板SETPT（%）写入；切换控制变量时按满量程百分比换算","unit":"%","access":"read_write","origin":"setpoint","component_ids":["valve_housing","control_pad"],"write_via":"valve.set_drive_setpoint"},"device.alarms":{"meaning_zh":"主显示状态消息（手册p.6）：ADC（评测者注入）、POV（宿主进口压力高于160 PSIA）、TOV（气温超出−10…60 °C）；未上电为空","unit":"1","access":"read_only","origin":"derived","component_ids":["display_screen","sensor_block"],"write_via":null},"truth.adc_fault":{"meaning_zh":"评测者注入的模数转换器错误（ADC，仅debug/evaluator可读）","unit":"1","access":"read_only","origin":"process_truth","component_ids":["sensor_block"],"write_via":null}},"mechanisms":{"synthetic_flow_process":{"meaning_zh":"有明确宿主气路边界与显式tau后的一阶合成流量过程；不求解真实压差流动或PID。","implementation":"lumped","equations":["Q_next = Q_target + (Q_old-Q_target)*exp(-dt/tau)，仅有明确tau、归零、有效温压与正向压差等前提时推进。","ΔV_std = Q_old*dt + (Q_target-Q_old)*(dt-tau*(1-exp(-dt/tau)))；累计量是积分账面值，不是宿主物质转移事务。","Q_actual = Q_std*(T/T_ref)*(P_ref/P_upstream)，理想气体、上游压力代理。","mass_flow = Q_std*P_ref*M/(R*T_ref)，M未知时返回null。","accuracy_bound = max(0.006*abs(Q),0.001*FS)，仅合成归零且宿主明确平衡时提供。"],"parameters":{"full_scale_standard_flow_m3_s":{"value":1.6666666666666667e-05,"unit":"m^3/s","evidence":"documented","meaning_zh":"full_scale_standard_flow_m3_s"},"minimum_positive_control_m3_s":{"value":1.666666666666667e-09,"unit":"m^3/s","evidence":"documented","meaning_zh":"minimum_positive_control_m3_s"},"fastest_control_t63_s":{"value":0.03,"unit":"s","evidence":"documented","meaning_zh":"配置与调整相关的最快T63，非稳定时间且不设为默认tau"},"default_reference_temperature_k":{"value":298.15,"unit":"K","evidence":"documented","meaning_zh":"default_reference_temperature_K"},"default_reference_pressure_pa":{"value":101325.0,"unit":"Pa","evidence":"documented","meaning_zh":"default_reference_pressure_Pa"},"default_dynamic_time_constant_s":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"default_dynamic_time_constant_s"},"gas_molar_mass_kg_mol":{"value":null,"unit":"kg/mol","evidence":"unknown","meaning_zh":"gas_molar_mass_kg_mol"},"valve_travel_m":{"value":null,"unit":"m","evidence":"unknown","meaning_zh":"valve_travel_m"},"pid_gains":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"实际参数结构及单位未知；1仅为此未知占位项的合同单位"},"operating_absolute_pressure_range":{"value":[79289.708871432,1103161.16690688],"unit":"Pa","evidence":"documented","meaning_zh":"工作绝压范围11.5–160PSIA，精确单位换算；并非压差。"},"operating_temperature_range":{"value":[263.15,333.15],"unit":"K","evidence":"documented","meaning_zh":"工作温度−10至60°C。"},"standard_accuracy_relative_reading":{"value":0.006,"unit":"1","evidence":"documented","meaning_zh":"标准精度读数比例项，须与FS项取较大绝对误差。"},"standard_accuracy_relative_full_scale":{"value":0.001,"unit":"1","evidence":"documented","meaning_zh":"标准精度FS比例项，需归零与平衡条件。"},"full_scale_air_pressure_drop":{"value":10342.135939752,"unit":"Pa","evidence":"documented","meaning_zh":"1SLPM满量程空气排大气时压降1.5PSID；不是所有气体、流量和背压下通用值。"},"documented_gas_count":{"value":98,"unit":"1","evidence":"documented","meaning_zh":"厂家可选气体数量；本批未复制数据库。"},"documented_mixture_definitions_maximum":{"value":20,"unit":"1","evidence":"documented","meaning_zh":"厂家混气定义数量上限；本批未实现混气数据库。"},"gas_viscosity":{"value":null,"unit":"Pa*s","evidence":"unknown","meaning_zh":"气体黏度未知，未虚构98种气体性质。"},"compressibility_factor":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"真实气体压缩因子未知；换算采用理想气体假设。"},"physical_settling_time":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"物理稳定时间未知，不从30ms T63编造。"}}},"gas_network_topology":{"meaning_zh":"上游节点→进气口→传感区→常闭调节阀→出气口→下游节点的功能拓扑。串联路径是模块接口抽象，非制造商内部流道结构复刻。","implementation":"qualitative","equations":[],"parameters":{}},"template_gas_property_flow":{"meaning_zh":"选用库气体时，用NIST真实气体密度做标准/实际/质量流量换算；理想层流元件按黏度把真实流量换成指示流量（宿主声明错气时生效）。","implementation":"lumped","equations":["rho(T,P)：纯气体=P·M/(Z·R·T)，Z与μ在NIST网格上线性插值（T与P），低于最低节点时Z线性趋于1；P≥p_sat(T)视为凝结→不可用。","混气：rho_mix=Σ rho_i(T, x_i·P)（Dalton）；μ_mix=Wilke(μ_i(T,x_i·P), M_i)；Σ x_i·P/p_sat,i≥1→不可用。","Q_act = Q_std,ind·rho_sel(T_ref,P_ref)/rho_sel(T,P_up)；m_dot = Q_std,ind·rho_sel(T_ref,P_ref)。","k = (μ_line/μ_sel)·(rho_sel,act/rho_sel,std)·(rho_line,std/rho_line,act)；Q_std,ind = k·Q_std,true；控制器目标Q_std,true→setpoint/k；未声明管路气体时k=1。","指示累计量 = Σ k·ΔV_true（与真值累计量同步推进）。"],"parameters":{"template_grid_temperature_range_k":{"value":[253.15,343.15],"unit":"K","evidence":"documented","meaning_zh":"库网格温度范围"},"template_grid_pressure_range_pa":{"value":[10000.0,1200000.0],"unit":"Pa","evidence":"documented","meaning_zh":"库网格压力范围"},"lfe_constant":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"层流元件常数C未知；理想Poiseuille假设下在比值k中抵消"}}}},"limitations":["仅为合成过程与接口实现，无硬件驱动、机器人或真实阀动作。","气体可由宿主登记（旧路径，性质null）或选用物性模板库：54种NIST SRD 69纯气体（真实气体密度、黏度、饱和线）与82种按Alicat公布组成（及干空气）派生的混气（Dalton+Wilke）；覆盖标准MC Gas Select 98项中的97项（乙炔无NIST流体模型）。S系列专用/未列出的库气体须宿主批准；20个COMPOSER自定义混气槽已实现（gas.create_mix，成分须为库气体）。","动态没有缺省时间常数。宿主必须给出明确假设及证据；最快T63 30 ms不是稳定时间，也不自动作为tau。","简化一阶闭环模型仅在有效供压/背压和温度条件下使用：时间常数=宿主tau×(167/P)×(D/1280)（PD/PDF；PD2I用P+I），出厂增益即宿主tau，下限30 ms；阀按线性阀假设（100 %驱动在规格书满量程压降1.5 PSID下通过满量程），流量受此饱和。真实阀曲线、超调/振荡、真实稳定判据和非理想气体性质未实现。","模型读数均为estimated；压力使用上游边界代理，温度使用宿主气温代理。不是实测传感器或厂家精度验证。","精度界限仅在归零且宿主声明平衡时计算 max(0.006|Q|,0.001FS)；不生成误差分布，不从固定时长推断平衡。","标准流量和累计标准体积使用当前参考条件；改气体/参考条件使归零和读数失效并开启新累计量区间。","参考条件配置采用仿真定义：1 SLPM数值量程按当前参考条件解释；不声称复现厂商改变标准温压后内部标度处理。","气路节点引用由宿主保管。本适配器不做气源库存、守恒物质转移或压力网络求解，后续气路宿主需接入这些过程。","重放去重仅当前宿主内存有效，不声称跨重启恰好一次。API过滤不是Python或文件系统隔离。","所有外露部件采用刚性固定装配。无可靠内部阀行程，不制造可动关节；按钮位移与真实触碰未实现。","外形遵守91.1×26.7×103.3mm标称尺寸；局部艺术细节、端口端面x位置及法线方向为建模假设，不是加工图。","整机质量约0.5kg；URDF只有聚合根使用该质量与均匀盒近似惯量，单部件mass/inertia均null，不能重复计重。","URDF碰撞体只采用盒、柱、球基元；文件结构或Blender姿态验证不等于物理接触、稳定放置、碰撞或摩擦性能验证。","3D模型中的显示屏和流向标识不与运行观测自动同步（屏幕画面由panel.capture按前面板层渲染）。GLB/OBJ为场景交换输出；本批未声称任何引擎中的物理求解兼容性。","整机搬运的attach/release由宿主约束事件负责；事件在合同中声明，未实现抓取、附着、释放或机器人动作。","模板路径中仍属假设/合成：一阶动态tau、理想Poiseuille层流元件（ΔP∝μ·Q，用于宿主声明的错气情形）、无传感器噪声/漂移/阀容量；混气性质为混合规则派生，非Alicat内部REFPROP数值。","前面板（panel.*）：按操作手册（MC系列固件9v，Rev.4）实现单色背光LCD、上下各三个软键与标志背光键；主显示、总量器、主菜单、CONTROL/SETUP/ABOUT列表、选项列表、逐位数值输入、Gas Select类别与气体表、COMPOSER混气、确认画面和LCK锁定；每个面板动作都调用本运行层的能力（没有第二份仪器逻辑）。","面板背后的设备功能已在运行层实现：自动归零（零设定保持延时后、宿主确认无流与平衡时）、设定来源串口/模拟（0–5 V输入，超限按限值）、上电设定值、设定值上下限、质量或体积流量控制、设定值斜坡（delta/time、升/降、上电与零设定选项）、批量给气（达到批量后阀关闭）与总量计时器、工程单位、流量/压力平均（一阶滞后）、零带、背光、对比度、屏幕倒置、COMPOSER混气（库纯气体按Dalton/Wilke求物性）、Recent列表、LCK锁定与Factory Restore。","串口设置（Unit ID、Modbus地址与超时动作、波特率）只作为设备设置保存与显示；仿真API不是Alicat ASCII/Modbus命令集，没有模拟串口或Modbus主站。","工程单位只提供手册单位表中的标准体积与实际体积子集（无N开头的标准态单位与真质量单位，因此NTP菜单不出现）；流量与压力平均对宿主瞬时改变的边界同样按一阶滞后显示，两步之间读数保持；平均与零带默认0（厂家默认值未写）。","控制变量绝对压力未仿真：上下游压力是宿主给出的边界，没有被阀充入或排出的过程容积（宿主未提供下游容积/压力模型），menu.configure对其返回unsupported；流量限制器与控制死区只在压力控制时起作用，因此只保存显示。控制变量阀驱动已实现（手册p.14；串口统计45“设定值直接驱动所选阀”）：设定值为阀驱动百分比（valve.set_drive_setpoint，面板SETPT以%输入），绕过流量闭环，流量按线性阀=驱动×1.5 PSID满量程流量×压差比例并以宿主tau一阶响应；切换控制变量时设定值按满量程百分比换算（假设，手册对设定值上下限如此说明）；阀驱动模式下flow.set_setpoint被拒，模拟输入0–5 V对应0–100 %驱动，上电保持上次驱动设定（假设），斜坡不作用于驱动。PD/PDF、PD2I增益作用于闭环响应（见上）；阀驱动百分比=控制器输出（所需驱动，0–100 %），主屏可显示。","主显示状态消息（手册p.6）：POV/TOV在宿主给出的进口压力高于160 PSIA或气温超出−10…60 °C（规格书）时显示（此时读数不可用）；ADC（模数转换器错误）由评测者fault.inject注入、fault.clear清除，只显示状态消息（手册未写其它行为与处理，读数照常为假设）；EXH（MCD双阀）、HLD（串口阀保持命令）与TMF（压力控制）不出现。","前面板层（panel.*）：按panel_ui.json（手册固件9v Rev.4页码证据）实现单色背光LCD（22×10字符，大号数字）、上下各三个软键与标志背光键；主显示（压力/温度/设定值/高亮参数/气体/状态码LCK、MOV、VOV、OVR）、总量器（TOTAL/TIMER、批量、RESET）、主菜单、CONTROL/SETUP/ABOUT列表、选项列表、逐位数值输入（SELECT DIGIT、CLEAR、SET）、Gas Select类别与气体表（PAGE、INFO）、COMPOSER混气、确认画面、对比度画面与LCK解锁；每个面板动作都调用本运行层的同名能力（没有第二份仪器逻辑）。","面板假设（手册未写）：显示22×10字符；列表中两态行（Autotare、斜坡选项）按SELECT切换；选项列表光标停在当前值；PAGE每次移动7行并循环；Recent保存5种；解锁需四个外侧键按住≥1 s；被拒命令（超限、模拟来源、流量未停时换气、宿主未确认无流时归零）不显示消息；ABOUT中序列号/日期/校准人未知显示为短横；ACTION菜单为Highlight与Engineering Units两项。","面板背后的设备功能已在运行层实现（见menu.configure等能力；P/D/I增益作用于闭环响应，阀驱动%为控制器输出；控制变量阀驱动以%设定值直接驱动阀）；控制变量绝对压力（宿主给定压力边界，无被阀充入的过程容积模型）、控制死区菜单（仅压力控制）、Register Status/Edit Register/Device Properties（服务菜单）、气压计TARE PRESS、IPC旋钮与彩色TFT不在本配置或未仿真，面板显示手册对应的画面或不响应。","面板不含3D联动：屏幕纹理（render()）与按键关节触发手势属于后续Matterix步骤；本版本只在过程层与会话API层验证（panel_ui_validation）。","状态消息（手册p.6）：POV/TOV由宿主边界产生（进口压力高于160 PSIA、气温超出−10…60 °C，此时读数不可用）；ADC由评测者fault.inject注入、fault.clear清除，只显示状态消息（手册未写其它行为与处理）；EXH（MCD双阀）、HLD（串口阀保持命令）、TMF（压力控制）在本配置不出现。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["flow.read","flow.reset_total","flow.set_setpoint","flow.zero","gas.select","gas.set_reference_conditions","power.set"],"unsupported":["control.set_pid"],"note_zh":"桥接 basic40_runtime_automation.AlicatMCRuntime（推进方式 host_step_dt），25 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（7 个按键（碰到即触发））；接口点 0 个（无）