nal_plate","plate_carriage"],"write_via":null},"plate.plate_id":{"meaning_zh":"当前宿主外部板ID；没有板时null。","unit":"1","access":"read_only","origin":"scene","component_ids":["external_plate"],"write_via":null},"plate.height_m":{"meaning_zh":"宿主明确提供的板高，范围0.003–0.060 m；宿主须配置同高度场景fixture。","unit":"m","access":"read_only","origin":"scene","component_ids":["external_plate"],"write_via":null},"plate.attachment_constraint_id":{"meaning_zh":"宿主True确认attach事件后登记的世界约束ID；release确认后清空；机器人层未实现。","unit":"1","access":"read_only","origin":"scene","component_ids":["external_plate"],"write_via":null},"plate.simulated_sealed":{"meaning_zh":"当前板满足抽象封膜时间/温度/接触条件的模拟状态；不证明强度、气密或耐溶剂。","unit":"1","access":"read_only","origin":"derived","component_ids":["external_plate"],"write_via":null},"film.roll_id":{"meaning_zh":"当前兼容膜卷的宿主ID，初始null。","unit":"1","access":"read_only","origin":"scene","component_ids":["film_roll"],"write_via":null},"film.width_m":{"meaning_zh":"宿主提供的兼容膜宽0.075–0.085 m，初始null；没有隐含材料或质量。","unit":"m","access":"read_only","origin":"scene","component_ids":["film_roll"],"write_via":null},"film.remaining_seals":{"meaning_zh":"宿主显式给定的剩余封膜配额0–5000；初始null；每次accepted即减1，失败或取消不返还。","unit":"1","access":"read_only","origin":"derived","component_ids":["film_roll"],"write_via":null},"scene.press_displacement_m":{"meaning_zh":"压合展示关节位移q，单位m、正方向向下；q=0..0.074是几何假设，非厂家行程。","unit":"m","access":"read_write","origin":"scene","component_ids":["press_head"],"write_via":"scene.set_press_displacement"},"sealing.status":{"meaning_zh":"当前板最近一轮模拟封膜状态；idle/running/succeeded/cancelled/failed。","unit":"1","access":"read_only","origin":"derived","component_ids":["press_head","external_plate"],"write_via":null},"sealing.elapsed_s":{"meaning_zh":"当前轮已累计的有效压合时间，单位s；取消或失温失败保留部分值。","unit":"s","access":"read_only","origin":"derived","component_ids":["press_head"],"write_via":null},"sealing.progress":{"meaning_zh":"elapsed_s/本轮press_time_s的无量纲进度；不代表真实粘接完成比例。","unit":"1","access":"read_only","origin":"derived","component_ids":["press_head"],"write_via":null},"truth.temperature_k":{"meaning_zh":"仅debug/evaluator可读的合成过程温度；初始null，不冒充实测。","unit":"K","access":"read_only","origin":"process_truth","component_ids":["press_head"],"write_via":null},"truth.thermal_rate_k_s":{"meaning_zh":"仅debug/evaluator可读的宿主显式线性接近速率；初始null，不从整机质量或均匀性推断。","unit":"K/s","access":"read_only","origin":"process_truth","component_ids":["press_head"],"write_via":null}},"mechanisms":{"thermal_process":{"meaning_zh":"宿主显式初值和速率驱动的集中线性温度代理；未校准热物理模型。","implementation":"lumped","equations":["供电开启且T、Tset、r均非null时：T_next=T+sign(Tset-T)*min(abs(Tset-T),r*dt)。否则不自行补温度或速率。","measurement.temperature_K=T（仅供电时），quality=estimated；未供电或无T时null。","thermal.target_reached=power.enabled and T,Tset已配置 and abs(T-Tset)<=1e-9 K；1e-9仅为数值比较容差。"],"parameters":{"temperature_range":{"value":[373.15,468.15],"unit":"K","evidence":"documented","meaning_zh":"用户表封膜范围100–195°C换算为SI。"},"block_uniformity":{"value":1.0,"unit":"K","evidence":"documented","meaning_zh":"厂家加热块均匀性±1°C；不是目标误差、升温速率或本模型就绪阈值。"},"thermal_rate":{"value":null,"unit":"K/s","evidence":"unknown","meaning_zh":"宿主每实例提供正有限线性速率及证据；没有厂家响应曲线或默认系数。"},"initial_temperature":{"value":null,"unit":"K","evidence":"unknown","meaning_zh":"宿主显式温度初值；未知时保持null。"},"numeric_equality_tolerance":{"value":1e-09,"unit":"K","evidence":"assumption","meaning_zh":"浮点相等的实现容差，非物理温度精度。"},"heater_power":{"value":null,"unit":"W","evidence":"unknown","meaning_zh":"整机与加热器功率未在用户表明确，未补值。"},"heat_capacity":{"value":null,"unit":"J/K","evidence":"unknown","meaning_zh":"未知加热块热容；不得由整机27kg冒充加热块参数。"}}},"sealing_process":{"meaning_zh":"将几何接触、温度模型就绪、持续时间和膜配额组合为抽象封膜状态；没有密封材料力学。","implementation":"qualitative","equations":["q_contact=0.077m-plate.height_m；压头底面z=0.105m-q；板顶z=0.028m+plate.height_m。这些均为本资产几何假设。","sealing.start被接受时remaining_seals_next=remaining_seals-1，elapsed=0，progress=0，status=running；不能使未完成板提前sealed。","运行中保持温度代理达到目标时，elapsed_next=min(press_time_s,elapsed+dt)，progress=elapsed/press_time_s。","elapsed达到本轮press_time_s则status=succeeded且当前板simulated_sealed=True；取消、断电或失温保留已用时间、消耗膜和q，未完成板为False。"],"parameters":{"press_time_range":{"value":[0.1,10.0],"unit":"s","evidence":"documented","meaning_zh":"用户表压合时间范围。"},"plate_height_range":{"value":[0.003,0.06],"unit":"m","evidence":"documented","meaning_zh":"用户表板高范围；宿主场景必须具备相符板高度。"},"film_width_range":{"value":[0.075,0.085],"unit":"m","evidence":"documented","meaning_zh":"用户表兼容膜宽范围。"},"maximum_seals_per_roll":{"value":5000,"unit":"1","evidence":"documented","meaning_zh":"一卷最多5000次为上限；不表示默认实际剩余量。"},"press_display_travel":{"value":[0,0.074],"unit":"m","evidence":"assumption","meaning_zh":"本模型压合展示行程；没有厂家关节行程数据。"},"plate_seat_z":{"value":0.028,"unit":"m","evidence":"assumption","meaning_zh":"台面局部板座顶面的模型位置。"},"platen_home_bottom_z":{"value":0.105,"unit":"m","evidence":"assumption","meaning_zh":"压头底面零位模型位置。"},"press_pressure":{"value":null,"unit":"Pa","evidence":"unknown","meaning_zh":"表内未提供实际压合压力，且不支持任意编程。"},"seal_strength":{"value":null,"unit":"Pa","evidence":"unknown","meaning_zh":"未知膜与板材料粘接强度。"},"leak_rate":{"value":null,"unit":"m^3/s","evidence":"unknown","meaning_zh":"未知泄漏规律；没有气密质量推断。"},"film_feed_distance":{"value":null,"unit":"m","evidence":"unknown","meaning_zh":"每轮实际进膜距离未知，仅记一次可用封膜配额。"}}}},"limitations":["温度100–195°C、时间0.1–10s、板高3–60mm、膜宽75–85mm来自CHEM-176三表；SI接口采用K、s、m。","热初始值和热速率没有缺省值；温度推进只采用宿主明确给定且附证据的线性接近设定值模型，无热容、功率、冷却曲线或PID推断。","measurement.temperature_K为理想化过程代理且quality=estimated；target_reached只比较模型目标，不是实测稳定性或厂家互锁。±1K均匀性只作为规格，不作为目标公差。","压合q=0..0.074m、压头底z=.105-q、板顶z=.028+height和接触q=.077-height均是几何假设，非厂家行程或接触力学。","一卷最多5000次是上限；宿主须提供实际剩余次数，默认null。每次已接受封膜消耗1次膜配额；取消或失败不退回膜。未推断膜长度或实际进给距离。","film_roll_position_id与plate_adapter_id引用宿主装载的兼容配置；真实位置坐标和厂家适配器枚举未知，不生成任意假坐标。","simulated_sealed仅表示配置、温度代理、压合接触与持续时间条件满足，不预测粘接强度、泄漏、耐溶剂性或真实密封质量。压力不可任意编程且未建模。","scene_adapter与attach/release需宿主True确认；robot与hardware absent，未实现接触抓取、力控制或实际输送。","去重仅当前宿主内存有效；API身份过滤不是Python、文件系统或进程安全隔离。取消保留已经消耗时间、膜与压头位置。","外形依据标称尺寸与公开外观简化；尺寸是否包含膜卷来源未明，本模型采用无卷本体口径假设。内部压头外露用于功能可见性，不是厂家拆机复原。","URDF只有整机包围盒惯量；各组件质量、摩擦、接触刚度、热容和真实行程未知。属于可动运动学资产，未验证动力学接触。","默认本体及示例板/膜的OBJ坐标为装配零位；URDF使用相同坐标与向下关节，不可当成各部件质心坐标。","膜进给/切断、托盘内外自动输送、触摸屏动态显示未联动，封膜API只在已确认接触的压头位置累计时间。","性能范围来自清单；公开图只支持粗外形，所有内部零件、膜卷直径、接头位置均为假设。","封膜逻辑假定板在名义座位对准，仅检查板高和压合q。宿主若移动或旋转板，需自行核对实际空间重叠；本次场景验证只覆盖名义座位。","示例96孔板的孔位是无碰撞视觉标记，不包含实际孔腔、样品体积或液体自由表面；宿主管理样品内容。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["configuration.set","power.set","scene.set_press_displacement","sealing.cancel","sealing.poll","sealing.read","sealing.start","thermal.set_temperature"],"unsupported":["sealing.set_pressure"],"note_zh":"桥接 basic40_runtime_automation.AzentaHeatSealerRuntime（推进方式 host_step_dt_world），22 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（1 个按键（碰到即触发））；1 个关节跟随运行层状态；接口点 1 个（板位）；布局：台面、单人可搬、正面 −y、前方留空 0.25 m；面板读数 temp(3)"}},"previews":["previews/azenta_automated_roll_heat_sealer_a4s/preview_front.webp","previews/azenta_automated_roll_heat_sealer_a4s/preview_pressed.webp","previews/azenta_automated_roll_heat_sealer_a4s/preview_rear.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t5_automation/azenta_heat_sealer/asset.contract.json","bytes":221285},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t5_automation/azenta_heat_sealer/collision_proxies.json","bytes":8111},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t5_automation/azenta_heat_sealer/geometry_manifest.json","bytes":16776},{"name":"model.blend","path":"assets/basic40_batch02/t5_automation/azenta_heat_sealer/model.blend","bytes":183997},{"name":"model.glb","path":"assets/basic40_batch02/t5_automation/azenta_heat_sealer/model.glb","bytes":2061532},{"name":"model.urdf","path":"assets/basic40_batch02/t5_automation/azenta_heat_sealer/model.urdf","bytes":11873},{"name":"scene_adapter.py","path":"assets/basic40_batch02/t5_automation/azenta_heat_sealer/scene_adapter.py","bytes":3829}],"completeness":{"components":17,"with_collisions":15,"with_objects":17,"with_function":17,"wi