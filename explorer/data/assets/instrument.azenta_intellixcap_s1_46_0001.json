ed","component_ids":["controller"],"write_via":null},"cycle.host_confirmed":{"meaning_zh":"宿主显式确认的螺纹结果，未确认是null","unit":"1","access":"read_only","origin":"derived","component_ids":["controller"],"write_via":null},"truth.thread_state":{"meaning_zh":"宿主确认的管盖开闭真值；运行层不自行计算","unit":"1","access":"read_only","origin":"process_truth","component_ids":["sample_interface"],"write_via":null}},"mechanisms":{"kinematic_cycle":{"meaning_zh":"显式合成运动参数驱动的半自动夹持—旋转—松夹状态机，阶段之间接受宿主附着与螺纹结果；仅为运动学示范","implementation":"numerical","equations":["f=clamp((host_time-phase_start)/host_supplied_duration,0,1)","clamping_gap=(1-f)*open_gap+f*closed_gap","rotation=rotation_start+sign(mode)*host_supplied_delta*f","releasing_gap=(1-f)*closed_gap+f*open_gap","gap映射到左右夹爪局部X：±(gap/2+0.003)；0.003m为几何半厚度假设"],"parameters":{"open_gap":{"value":null,"unit":"m","evidence":"unknown","meaning_zh":"无默认值；必须由可信宿主提供显式仿真假设与证据"},"closed_gap":{"value":null,"unit":"m","evidence":"unknown","meaning_zh":"无默认值；必须由可信宿主提供显式仿真假设与证据"},"rotation_delta":{"value":null,"unit":"rad","evidence":"unknown","meaning_zh":"无默认值；必须由可信宿主提供显式仿真假设与证据"},"clamp_duration":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"无默认值；必须由可信宿主提供显式仿真假设与证据"},"rotation_duration":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"无默认值；必须由可信宿主提供显式仿真假设与证据"},"release_duration":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"无默认值；必须由可信宿主提供显式仿真假设与证据"}}},"thread_and_contact":{"meaning_zh":"真实螺纹开封盖结果和接触夹持需外部力学/耗材验证；此资产只接受宿主确认","implementation":"absent","equations":[],"parameters":{"torque_threshold":{"value":null,"unit":"N*m","evidence":"unknown","meaning_zh":"封盖扭矩阈值未知"},"clamp_force":{"value":null,"unit":"N","evidence":"unknown","meaning_zh":"夹持力未知"},"friction_coefficient":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"盖/夹爪及螺纹摩擦未知"},"thread_pitch":{"value":null,"unit":"m","evidence":"unknown","meaning_zh":"具体耗材螺距未知"}}}},"limitations":["仅实现半自动单管状态机与合成运动；完整无人流程需要宿主样品转运。robot 和 hardware 层 absent。","所有行程、转角和阶段时长必须由可信宿主给出显式仿真假设与证据；没有厂家运动缺省值。","典型周期小于3秒随耗材变化；该规格不是此仿真每次周期的保证，也不用作默认运动或超时参数。","11–40 mm仅为盖径兼容范围；15/50 mL是已列兼容管容量类别，不能据容量推导管形或螺距。","夹持和旋转仅提供位姿状态；扭矩、夹力、螺纹摩擦、转速和实际行程未知且不求解。","attach/release事件需宿主实际建立/解除外部约束后确认；本运行层只登记constraint_id，不创建物理约束。","运动结束后必须等待宿主螺纹结果；结果属于宿主断言，不是本资产自行检测到的真实开封盖成功。","取消保留关节当前位置及已确认附着；不得假定盖已释放、样品状态回滚或自动复位。","read/poll不推进时间；host_step推进同一运行宿主中全部实例。实例数据互相隔离。","去重只在当前宿主内存中有效；API可见性过滤不构成Python反射或共享文件系统隔离。","整体URDF使用assembly根链接上的3.8kg均匀包围盒惯性代理；其他运动链接质量与惯量未知，不写虚构默认1kg。该URDF为动力学信息不完整的运动学描述；prismatic limit省略未知effort/velocity，部分严格URDF加载器可能拒绝，严格加载与动力学导入均not_run。宿主需补足有证据的质量、惯量、effort和velocity后再评估加载。","场景内置展示姿态、爪厚和布局均为重建假设；运行默认状态仍是未配置的null，不能把模型初始姿态当厂家参数。","场景夹口显示范围0..0.050m、URDF q=gap/2为0..0.025m均是仿真几何限制，不是厂家实际行程；场景适配器拒绝超出该域的运行快照。","该设备无已证实气体/液体物料端口；分类名包含气液供给不构成气路存在的证据。","sample_interface是定位Empty，无视觉网格和碰撞体；其OBJ仅占位文件头，不属于可见分件。","已验证原生Blender与GLB回导的SI包围盒及Z向上约定；GLB文件遵循glTF标准Y-up序列化。","scene_adapter.resolve_attachment_frame已验证将逻辑gripper事件映射到旋转spindle；不创建、删除或求解真实外部约束。","表内开盖/封盖与周期状态范围已实现。手册更多模式、按压触发和三档厂家周期没有绑定为完整硬件等价功能。","预览面板文字与绿色指示点属于静态外观；未声明随供电或周期切换的显示联动。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["consumable.select","cycle.read","cycle.set_mode","cycle.start","power.set"],"unsupported":["torque.set_limit"],"note_zh":"桥接 basic40_runtime_automation.IntelliXcapS1Runtime（推进方式 host_step_dt），13 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（5 个按键（碰到即触发）、3 个门/盖/阀等被动关节）；3 个关节跟随运行层状态；接口点 1 个（夹持）；布局：台面、单人可搬、正面 −y、前方留空 0.25 m"}},"previews":["previews/azenta_intellixcap_s1_46_0001/preview.webp","previews/azenta_intellixcap_s1_46_0001/preview_front.webp","previews/azenta_intellixcap_s1_46_0001/preview_motion.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t5_automation/azenta_intellixcap_s1/asset.contract.json","bytes":156042},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t5_automation/azenta_intellixcap_s1/collision_proxies.json","bytes":8914},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t5_automation