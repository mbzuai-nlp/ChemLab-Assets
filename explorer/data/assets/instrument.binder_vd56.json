vidence":"assumption","meaning_zh":"Nominal 22 deg C selected within official empty-chamber test condition +22+/-3 deg C, standard aluminium shelves, chamber pressure <20 mbar"},"reference_heating_time_s":{"value":4800.0,"unit":"s","evidence":"documented","meaning_zh":"https://www.binder-world.com/int-en/products/drying-ovens/vacuum-drying-chambers/product/vd-56; heating-up to 100 deg C: 80 min"},"maximum_door_angle_rad":{"value":1.7453292519943295,"unit":"rad","evidence":"assumption","meaning_zh":"Scene limit; not measured manufacturer travel"},"door_open_loss_w_k":{"value":20.0,"unit":"W/K","evidence":"assumption","meaning_zh":"Uncalibrated extra lumped heat loss at fully open door"},"door_open_heater_fraction":{"value":0.0,"unit":"1","evidence":"assumption","meaning_zh":"Heater derates linearly with door angle to zero at full opening; simulation behavior, not manufacturer interlock"},"chamber_volume_m3":{"value":0.055,"unit":"m^3","evidence":"documented","meaning_zh":"CHEM-012 workbook: 55 L; gas mass is not solved"},"isolated_pressure_rise_pa_s":{"value":0.2777777777777778,"unit":"Pa/s","evidence":"documented","meaning_zh":"CHEM-012: 0.01 bar/h interpreted as isolated-chamber pressure rise, not mass leak rate"},"reference_pressure_pa":{"value":5000.0,"unit":"Pa","evidence":"documented","meaning_zh":"CHEM-012: pressure fluctuation reference 50 mbar absolute"},"reference_pressure_fluctuation_pa":{"value":100.0,"unit":"Pa","evidence":"documented","meaning_zh":"CHEM-012: +/-1 mbar at 50 mbar, not general absolute accuracy"},"pressure_proxy_period_s":{"value":60.0,"unit":"s","evidence":"assumption","meaning_zh":"Synthetic sine-wave indication period, not manufacturer-specified response"},"pressure_proxy_activation_tolerance_pa":{"value":1.0,"unit":"Pa","evidence":"assumption","meaning_zh":"5000 Pa display ripple activated only within 1 Pa of the explicit external 5000 Pa boundary"},"vent_time_constant_s":{"value":15.0,"unit":"s","evidence":"assumption","meaning_zh":"First-order backfill toward host atmospheric absolute pressure; no gas composition or mass flow"},"door_pressure_tolerance_pa":{"value":100.0,"unit":"Pa","evidence":"assumption","meaning_zh":"Scene opening requires pressure within 100 Pa of host atmosphere; not a hardware safety claim"},"external_pump_speed_m3_s":{"value":null,"unit":"m^3/s","evidence":"unknown","meaning_zh":"No pump included/selected; explicit host boundary and time constant are required, no pump curve inferred"}}}},"limitations":["full只表示本次标准单铝搁板配置全部功能组件已登记；不表示所有厂家模式、过程机制或机器人/硬件已实现。","几何参考官方外形及内腔尺寸重建，局部尺寸、材质和100°门行程为图片估计或建模假设，不是厂家CAD。","整机96kg与标称包围盒近似惯量登记在root；所有未知部件质量/惯量/摩擦为null。URDF按固定基座运动学使用，接触动力学未运行。","单搁板配置；载荷60kg是整机总载荷上限，不分配给某个部件或当作自身质量。","本机未包含外置真空泵；真空源只作为宿主配置边界。压力程序为declared/unsupported，保压只表示关闭两阀后按漏率演化。","温度模型以1400W、100°C稳态180W及22→100°C空载80min反推等效参数；厂家性能条件为空载、标准铝架、环境22±3°C、腔内低于2000Pa。未校准装样工况、接触热阻和局部温差，亦未同时拟合220°C的160min/560W工况。","100°C均匀性按用户表格、现行目录和产品页采用±1.2K；2025手册为±1.5K，厂商资料存在冲突；单节点模型不计算空间均匀性。","未实现压力—蒸发耦合、样品失重、湿度、传质、气体组分、惰性纯度、干燥终点、厂家限温报警与真实硬件保护。","50mbar时±1mbar压力波动与0.01bar/h漏率均登记SI；合成显示不是厂家性能复现或实际传感器精度证明。","VD标准版本的厂家适用限制以source_notes/原手册为准；不由仿真推断具体样品或挥发物兼容性。","公共会话过滤过程真值与实例访问；共享Python进程和工作区可读文件不构成隔离，不能向不可信调用者暴露宿主/debug文件。","Blender是可执行场景绑定；GLB/OBJ只保存导出姿态和文字快照。本次GLB按任务Z向上约定导出，未转为glTF惯用Y向上，宿主需遵照几何清单坐标加载。","机器人抓取、运动规划、真实硬件、接触动力学、密封接触及真实样品试验均not_run。"],"sources":[],"checks":{"coverage":{"status":"full","implemented":["power.set","thermal.set_temperature","scene.set_door","vacuum.set_valve","vent.set_valve"],"unsupported":["pressure.program"],"note_zh":"热核心 + 真空腔压力（外接泵、隔离上升、放空）一致：温度差 ≤0.034 K，压力差 ≤1.7 Pa；初始目标温度默认值（环境+9 K）与运行层不同，需对齐；关节化 USD（4 个按键（碰到即触发）、3 个门/盖/阀等被动关节）；接口点 6 个（放置面）；布局：台面、固定、正面 −y、前方留空 0.692 m；面板读数 temp(3)"}},"previews":["previews/binder_vd56/thermal_binder_vd56_closed.webp","previews/binder_vd56/thermal_binder_vd56_open.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t1_thermal/binder_vd56/asset.contract.json","bytes":181773},{"name":"collision_pro