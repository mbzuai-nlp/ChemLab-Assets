ibration Mode 0）；出厂设置恢复同样包含它","kind":"device_command","availability":"implemented","component_ids":["electronics","pressure_sensor"],"implementation":{"process":"verified","host":"verified","scene":"absent","robot":"absent","hardware":"absent"},"input":[]},"sensor.configure_error":{"function_zh":"评测者设定传感器误差（偏置Pa、相对增益、漂移Pa/s；默认0即理想）：信号=真实表压×(1+增益)+偏置+累积漂移；面板与直接读数用同一模型；不研究真实容差","kind":"simulation","availability":"implemented","component_ids":["pressure_sensor"],"implementation":{"process":"verified","host":"verified","scene":"absent","robot":"absent","hardware":"absent"},"input":["offset_error_Pa","gain_error","drift_error_Pa_s"]},"fault.inject":{"function_zh":"评测者注入严重故障（手册p.21：红灯常亮，仪器须维修后才能使用）：控制器停止、阀处于安全状态（关闭），除电源、评测者功能与模拟输入外的命令与开关功能被拒，断电重启后仍在；读数照常（假设）。用于测试视觉agent对LED故障图案的处理。","kind":"device_command","availability":"implemented","component_ids":["control_valve","electronics"],"implementation":{"process":"verified","host":"verified","scene":"absent","robot":"absent","hardware":"absent"},"input":["code"]},"fault.clear":{"function_zh":"评测者清除严重故障（代表维修完成）：控制器按当前控制模式恢复。","kind":"device_command","availability":"implemented","component_ids":["electronics"],"implementation":{"process":"verified","host":"verified","scene":"absent","robot":"absent","hardware":"absent"},"input":[]}},"state_slots":{"power.enabled":{"meaning_zh":"模拟供电开关；断电时过程出口开度置零是场景假设，非厂家失电阀状态。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["electronics"],"write_via":"power.set"},"pressure.setpoint_pa":{"meaning_zh":"目标上游表压；本配置只接受 100000–500000 Pa，未设置时为 null。","unit":"Pa","access":"read_write","origin":"setpoint","component_ids":["electronics"],"write_via":"pressure.set_setpoint"},"pressure.active_setpoint_pa":{"meaning_zh":"控制器跟随的活动目标（按控制模式取数字设定、模拟输入、100 %/0 %或报警新设定，斜坡后）；0为0 %设定。","unit":"Pa","access":"read_only","origin":"derived","component_ids":["electronics"],"write_via":null},"pressure.reading_pa":{"meaning_zh":"上游表压指示值=传感器信号（真实表压×(1+增益误差)+偏置误差+累积漂移，误差默认0即理想）减自动调零存储的零点；quality=estimated；未建噪声/延迟模型。断电、FLASH模式或量程有效段以外返回 null。控制器与报警用同一指示值。","unit":"Pa","access":"read_only","origin":"sensor","component_ids":["pressure_sensor"],"write_via":null},"pressure.deviation_pa":{"meaning_zh":"理想化压力读数减活动目标，quality=estimated；缺观测或缺目标返回 null。","unit":"Pa","access":"read_only","origin":"derived","component_ids":["electronics"],"write_via":null},"control.mode":{"meaning_zh":"manual/automatic：由Control Mode派生（控制器运行的模式为automatic）；control.set_mode自动=模式0、手动=模式20。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["electronics"],"write_via":"control.set_mode"},"control.gain_per_pa_s":{"meaning_zh":"仿真积分输出增益，由宿主初始显式提供，可通电修改；非厂家控制参数。","unit":"1/(Pa*s)","access":"read_write","origin":"setpoint","component_ids":["electronics"],"write_via":"control.set_gain"},"control.ramp_rate_pa_s":{"meaning_zh":"活动目标斜坡速率；null 表示下一宿主步直接到目标，0 表示保持当前活动目标。","unit":"Pa/s","access":"read_write","origin":"setpoint","component_ids":["electronics"],"write_via":"control.set_ramp_rate"},"control.status":{"meaning_zh":"模拟控制状态；超出有效测量段时保持过程开度并报告sensor_unavailable；FLASH模式为program_stopped；严重故障为critical_error。","unit":"1","access":"read_only","origin":"derived","component_ids":["electronics"],"write_via":null},"valve.opening":{"meaning_zh":"过程线性节流的归一化有效开度估计；手动模式可写，自动模式由控制器更新。不是测得的真实阀行程。","unit":"1","access":"read_write","origin":"derived","component_ids":["control_valve"],"write_via":"valve.set_opening"},"scene.valve_position":{"meaning_zh":"独立归一化展示阀芯位置；仅通过场景能力修改，不映射过程 valve.opening。","unit":"1","access":"read_write","origin":"scene","component_ids":["control_valve"],"write_via":"scene.set_valve_position"},"process.upstream_absolute_pressure_pa":{"meaning_zh":"受信宿主上游过程体积内的绝对压力真值，pV=nRT。","unit":"Pa","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.upstream_moles_mol":{"meaning_zh":"受信宿主过程体积内的 N2 摩尔数真值。","unit":"mol","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.inflow_mol_s":{"meaning_zh":"外部宿主显式提供的恒定步内流入摩尔流率。","unit":"mol/s","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.downstream_absolute_pressure_pa":{"meaning_zh":"外部宿主显式提供的下游绝压边界。","unit":"Pa","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.outflow_mol_s":{"meaning_zh":"当前状态的瞬时线性节流出口摩尔流率。","unit":"mol/s","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.integrated_inflow_mol":{"meaning_zh":"创建实例后累计进入此过程体积的摩尔量。","unit":"mol","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.integrated_outflow_mol":{"meaning_zh":"创建实例后累计从此过程体积排出的摩尔量。","unit":"mol","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"control.control_mode":{"meaning_zh":"Control Mode（p.34）；初始20（阀门导引：运行层原有的手动开度起点）。","unit":"1","access":"read_only","origin":"setpoint","component_ids":["electronics"],"write_via":null},"control.default_control_mode":{"meaning_zh":"默认控制模式（出厂按订货为0或1，本资产假设0数字）；开关改模式时同时设定。","unit":"1","access":"read_only","origin":"setpoint","component_ids":["electronics"],"write_via":null},"setpoint.analog_input_fraction":{"meaning_zh":"模拟设定输入（量程分数；null为无信号）；低于2 %视为0 %（p.28）。","unit":"1","access":"read_only","origin":"sensor","component_ids":["electrical_connector"],"write_via":null},"alarm.mode":{"meaning_zh":"Alarm Mode：off/absolute/response/power_up（p.38）。","unit":"1","access":"read_only","origin":"setpoint","component_ids":["electronics"],"write_via":null},"alarm.min_limit_pa":{"meaning_zh":"最小报警限（Pa表压；response模式为低于目标的偏差）。","unit":"Pa","access":"read_only","origin":"setpoint","component_ids":["electronics"],"write_via":null},"alarm.max_limit_pa":{"meaning_zh":"最大报警限（Pa表压；response模式为高于目标的偏差）。","unit":"Pa","access":"read_only","origin":"setpoint","component_ids":["electronics"],"write_via":null},"alarm.delay_s":{"meaning_zh":"Alarm Delay Time（s）：报警触发与自动解除均延时（p.39）。","unit":"s","access":"read_only","origin":"setpoint","component_ids":["electronics"],"write_via":null},"alarm.new_setpoint_pa":{"meaning_zh":"报警期间的新（安全）设定直到复位；null为不改设定（p.40）。","unit":"Pa","access":"read_only","origin":"setpoint","component_ids":["electronics"],"write_via":null},"alarm.reset_enable":{"meaning_zh":"Reset Alarm Enable：switch（开关）、command（参数Reset）、automatic（条件消失）（p.40）。","unit":"1","access":"read_only","origin":"setpoint","component_ids":["electronics"],"write_via":null},"alarm.active":{"meaning_zh":"报警中：绿/红灯1 s交替慢闪（p.21）；只在宿主步进时评估。","unit":"1","access":"read_only","origin":"derived","component_ids":["electronics","status_leds"],"write_via":null},"alarm.info":{"meaning_zh":"报警类型：minimum、maximum、response、power_up（Alarm Info，p.39）。","unit":"1","access":"read_only","origin":"derived","component_ids":["electronics"],"write_via":null},"device.configuration_mode":{"meaning_zh":"配置模式：绿灯长闪2 s亮/0.1 s灭（p.21, p.23）。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["electronics","electrical_connector","status_leds"],"write_via":"device.set_configuration_mode"},"device.flash_mode":{"meaning_zh":"FLASH模式：程序不运行、双灯灭、下次上电恢复（p.23）。","unit":"1","access":"read_only","origin":"derived","component_ids":["electronics","status_leds"],"write_via":null},"sensor.zero_offset_pa":{"meaning_zh":"自动调零存储的零点（Pa，传感器信号）；出厂零点0；读数=信号-零点。","unit":"Pa","access":"read_only","origin":"setpoint","component_ids":["pressure_sensor","electronics"],"write_via":null},"sensor.calibration_mode":{"meaning_zh":"Calibration Mode结果（p.34）：0空闲或调零成功，255上次调零出错。","unit":"1","access":"read_only","origin":"derived","component_ids":["electronics"],"write_via":null},"sensor.offset_error_pa":{"meaning_zh":"传感器偏置误差（评测者设定，默认0即理想）。","unit":"Pa","access":"read_only","origin":"process_truth","component_ids":["pressure_sensor"],"write_via":null},"sensor.gain_error":{"meaning_zh":"传感器相对增益误差（评测者设定，默认0即理想）。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["pressure_sensor"],"write_via":null},"sensor.drift_error_pa_s":{"meaning_zh":"传感器漂移速率（评测者设定，默认0即理想）。","unit":"Pa/s","access":"read_only","origin":"process_truth","component_ids":["pressure_sensor"],"write_via":null},"sensor.drift_offset_pa":{"meaning_zh":"累积漂移（宿主步进时累加）。","unit":"Pa","access":"read_only","origin":"process_truth","component_ids":["pressure_sensor"],"write_via":null},"device.critical_error":{"meaning_zh":"严重故障（评测者注入）：红灯常亮、绿灯灭，控制器停止、阀关闭，命令被拒，直到维修（fault.clear）（p.21）。","unit":"1","access":"read_only","origin":"derived","component_ids":["electronics","status_leds"],"write_via":null}},"mechanisms":{"isothermal_backpressure":{"meaning_zh":"上游受压容积经出口节流泄压；背压控制器不生成压力。N2 等温理想气体与线性阀是显式数值近似。","implementation":"lumped","equations":["p_abs*V=n*R*T; dn/dt=q_in-q_out","q_out=C*u*max(p_abs-p_down_abs,0); 0<=u<=1","每一步先按宿主 dt 更新活动目标与控制输出；步内固定开度、流入及下游压力，用解析指数解积分气体平衡。","u_next=clip(u+gain*(pressure_reading-active_setpoint)*dt,0,1); 压力过高则增大出口开度。","处于下游压力以下时只累积输入，达到下游压力后才进入正向出口流分支。"],"parameters":{"valve_conductance_mol_s_pa":{"value":null,"unit":"mol/(s*Pa)","evidence":"unknown","meaning_zh":"线性导通系数 C；必须由宿主显式提供，不能代替厂家 Kv。"},"vendor_valve_kv":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"此配置真实阀容量未给定。"},"upstream_volume_m3":{"value":null,"unit":"m^3","evidence":"unknown","meaning_zh":"上游外部过程体积，宿主必填；非仪器内部死体积。"},"temperature_k":{"value":null,"unit":"K","evidence":"unknown","meaning_zh":"等温气体场景温度，宿主必填；工作范围 263.15–343.15 K。"},"control_gain_per_pa_s":{"value":null,"unit":"1/(Pa*s)","evidence":"unknown","meaning_zh":"仿真积分控制增益，宿主必填；非厂家 PID 参数。"},"pressure_reference_pa":{"value":null,"unit":"Pa","evidence":"unknown","meaning_zh":"表压对应的参考绝压，宿主必填。"}}}},"limitations":["选定型号为 CHEM-181 Bronkhorst EL-PRESS P-702CV；传感器固定 0–500000 Pa 表压且 N2 为本次配置假设，未确认工厂完整订货号。不能以系列 400 bar 作为上限。","保留厂家 P-600/P-700 标准准确度、重复性、量程比及典型稳定性条件；未混用 P-800 性能，也未证明本模型满足厂商精度。","厂家 2 ms 仅传感器响应，未建传感器动态延迟或完整闭环响应模型。实际阀 Kv、真实阀行程、内部死体积及闭环稳定时间为 null。","外形按 A77/B127/C47/H123/K25 mm 解释：A、B、C 同沿 X，H 沿 Z，K 沿 Y；C47 不是整机宽度。局部布局、端口高度、内构件和放大展示行程是重建假设。","URDF 仅使用 box/cylinder/sphere 碰撞体，整机 0.7 kg 和包围盒惯量集中于 base_link；子件质量、惯量、摩擦未知。碰撞文件存在不证明机器人接触或动力学可用。","URDF 展示棱柱关节的 effort=0/velocity=0 是禁用驱动的元数据占位，不是厂家额定参数；该关节只供运动学示意。","展示 scene.valve_position 与过程 valve.opening 是两个不同状态。无过程到几何联动；场景求值验证与过程测试独立记录。","robot/hardware 均 absent；夹持、attach/release、接触抓取、安装约束、真实气路连接由宿主承担且未执行验证。","需先固定传感器压力量程、气体和阀容量；补容积-流量-压力耦合，不能把系列最高400 bar用作此型号上限。 2 ms仅传感器响应，不可作为整个压力闭环的稳定时间。","Host must supply process volume, temperature, initial absolute pressure, downstream absolute pressure, inflow, linear valve conductance, gauge reference and control gain; these are scenario values, not vendor component specifications.","Ideal isothermal N2 gas only: no liquid, real-gas, choking, reverse flow, leakage, noise, hysteresis or calibrated valve characteristic.","Discrete integral output control is a simulation assumption; stability and step size depend on explicit host parameters.","Power-off forces modeled outlet opening to zero as a scenario assumption; unpowered gas accumulation still occurs. Real fail-safe state is unknown.","Scene valve position is independent normalized explanatory state; no process-to-scene actuation or physical valve stroke is claimed.","Agent API filtering is implemented; trusted Python host introspection and file access are outside this boundary.","Idempotency is per principal and instance in memory only; no cross-restart exactly-once promise.","不可用：网络设置（短按3/5次：需现场总线，本RS-232/模拟版无）、FLOW-BUS自动安装与从站模式2/13、自动调零（仅流量仪表）、校准模式9；通信链路、通信丢失/严重故障/Wink图案不建模。","手动控制（panel.*）：按说明书9.17.101（panel_ui.json页码证据）实现顶部多功能开关与绿（Mode）/红（Error）两个LED；开关为瞬动按钮，以panel.switch pressed/released表示，按住时长为两次手势之间的仿真时间，按住期间可看到手册的LED图案序列。","开关功能与背后的仪器功能已在运行层实现：按住1-4 s报警复位、4-8 s仪器复位、12-16 s FLASH模式；上电按住4-8 s恢复出厂、12-16 s配置模式；短按2次读出、4次修改控制模式（亦设默认模式）；控制模式0/1/3/4/7/8/10/12/18/20/21/22、报警（绝对/响应/上电，延时、新设定、复位方式）、模拟设定输入。","不可用：网络设置（短按3/5次：需现场总线，本RS-232/模拟版无）、FLOW-BUS自动安装与从站模式2/13；控制模式9的调零即自动调零（sensor.calibrate_zero），不单独提供；通信链路、通信丢失/Wink图案不建模（需现场总线或主机命令）。","严重故障（手册p.21红灯常亮：须维修后才能使用）由评测者fault.inject注入、fault.clear清除：绿灯灭、红灯常亮，控制器停止、阀处于安全状态（关闭），除电源、评测者功能与模拟输入外的命令与开关功能被拒（PRECONDITION_FAILED，无额外指示），断电重启后仍在；读数照常（假设）。","传感器误差模型：读数=真实表压×(1+增益误差)+偏置误差+累积漂移-存储零点；误差默认0（理想），只能由评测者经sensor.configure_error设定；自动调零（开关8-12 s）把参考条件下的信号存为零点，偏离超过±2 % FS（假设）时Calibration Mode 255。直接读数、偏差、控制器、报警与面板使用同一模型。真实测量误差留给后续校准/仿真-现实差距任务。","面板假设（手册未写）：控制模式读出闪烁0.5 s亮/0.5 s灭、每步后1 s暗；动作开始快闪持续1 s；按住序列每16 s重复；输入不存在的控制模式时保持原模式且无指示；报警只在宿主步进时评估。","顶部LED与多功能开关为按手册p.20俯视图比例估计的几何（透镜Φ2.8 mm、按钮帽Φ2.5 mm，平齐顶面）；开关行程0.5 mm与弹簧为假设；Matterix中按下/松开经PanelInput发panel.switch，Isaac/GPU场景未核对。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["control.set_gain","control.set_mode","control.set_ramp_rate","power.set","pressure.set_setpoint","scene.set_valve_position","simulation.set_boundary","simulation.step","valve.set_opening"],"unsupported":[],"note_zh":"桥接 basic40_runtime_automation.P702CVRuntime（推进方式 step_dt_world），18 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（1 个按键（碰到即触发））；1 个门/盖/升降关节与运行层双向同步；接口点 0 个（无）；布局：台面、单人可搬、正面 −y、前方留空 0.25 m"}},"previews":["previews/bronkhorst_p702cv_5bar_gauge_n2/preview.webp","previews/bronkhorst_p702cv_5bar_gauge_n2/preview_cutaway.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t5_automation/bronkhorst_p702cv/asset.contract.json","bytes":357591},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t5_automation/bronkhorst_p702cv/collision_proxies.json","bytes":17035},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t5_automation/bronkhorst_p702cv/geometry_manifest.json","bytes":32095},{"name":"model.blend","path":"assets/basic40_batch02/t5_automation/bronkhorst_p702cv/model.blend","bytes":147802},{"name":"model.glb","path":"assets/basic40_batch02/t5_automation/bronkhorst_p702cv/model.glb","bytes":855416},{"name":"model.urdf","path":"assets/basic40_batch02/t5_automation/bronkhorst_p702cv/model.urdf","bytes":15933},{"name":"panel_ui.json","path":"assets/basic40_batch02/t5_automation/bronkhorst_p702cv/panel_ui.json","bytes":47411}],"completeness":{"components":13,"with_collisions":8,"with_objects":13,"with_function":13,"with_mass":0,"joints_matching_component":2,"joints":2,"has_contract":true,"has_layout":true,"has_glb":true,"checks_present":["articulation_check","coverage","contract_validation","runtime_validation","scene_validation"]},"slug":"bronkhorst_p702cv_5bar_gauge_n2","chem_id":"CHEM-181","name_en":"Electronic back-pressure controller","maker":"Bronkhorst","model":"EL-PRESS P-702CV","domain":"automation","domain_name":"Automation & Gas/Liquid Supply","path":"assets/basic40_batch02/t5_automation/bronkhorst_p702cv","glb_up":"z","has_contract":true,"contract":"assets/basic40_batch02/t5_automation/bronkhorst_p702cv/asset.contract.json","runtime":"scripts/basic40_runtime_automation.py"}