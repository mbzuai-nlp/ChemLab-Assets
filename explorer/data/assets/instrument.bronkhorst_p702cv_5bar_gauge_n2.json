t":"absent","hardware":"absent","host":"verified"},"input":["opening"]},"scene.set_valve_position":{"function_zh":"设置独立归一化展示阀芯位置","kind":"simulation","availability":"implemented","component_ids":["control_valve"],"implementation":{"process":"not_applicable","scene":"verified","robot":"absent","hardware":"absent","host":"verified"},"input":["position"]},"simulation.step":{"function_zh":"由受信宿主推进指定共同时间步与背压过程","kind":"simulation","availability":"implemented","component_ids":["flow_body","control_valve","pressure_sensor","electronics"],"implementation":{"process":"verified","scene":"not_applicable","robot":"absent","hardware":"absent","host":"verified"},"input":["dt_s","world_time_s"]},"simulation.set_boundary":{"function_zh":"由受信宿主更新上游流入与下游绝压边界","kind":"simulation","availability":"implemented","component_ids":["flow_body"],"implementation":{"process":"verified","scene":"not_applicable","robot":"absent","hardware":"absent","host":"verified"},"input":["inflow_mol_s","downstream_absolute_pressure_Pa"]}},"state_slots":{"power.enabled":{"meaning_zh":"模拟供电开关；断电时过程出口开度置零是场景假设，非厂家失电阀状态。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["electronics"],"write_via":"power.set"},"pressure.setpoint_pa":{"meaning_zh":"目标上游表压；本配置只接受 100000–500000 Pa，未设置时为 null。","unit":"Pa","access":"read_write","origin":"setpoint","component_ids":["electronics"],"write_via":"pressure.set_setpoint"},"pressure.active_setpoint_pa":{"meaning_zh":"经过斜坡的活动表压目标；初次设定直接建立目标，以后仅宿主 step 更新。","unit":"Pa","access":"read_only","origin":"derived","component_ids":["electronics"],"write_via":null},"pressure.reading_pa":{"meaning_zh":"理想化上游表压观测，quality=estimated；未建噪声/精度/延迟模型。断电或量程有效段以外返回 null。","unit":"Pa","access":"read_only","origin":"sensor","component_ids":["pressure_sensor"],"write_via":null},"pressure.deviation_pa":{"meaning_zh":"理想化压力读数减活动目标，quality=estimated；缺观测或缺目标返回 null。","unit":"Pa","access":"read_only","origin":"derived","component_ids":["electronics"],"write_via":null},"control.mode":{"meaning_zh":"manual/automatic；自动模式要求供电、已有目标与有效压力读数。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["electronics"],"write_via":"control.set_mode"},"control.gain_per_pa_s":{"meaning_zh":"仿真积分输出增益，由宿主初始显式提供，可通电修改；非厂家控制参数。","unit":"1/(Pa*s)","access":"read_write","origin":"setpoint","component_ids":["electronics"],"write_via":"control.set_gain"},"control.ramp_rate_pa_s":{"meaning_zh":"活动目标斜坡速率；null 表示下一宿主步直接到目标，0 表示保持当前活动目标。","unit":"Pa/s","access":"read_write","origin":"setpoint","component_ids":["electronics"],"write_via":"control.set_ramp_rate"},"control.status":{"meaning_zh":"模拟控制状态；超出有效测量段时保持过程开度并报告 sensor_unavailable，非厂家故障逻辑。","unit":"1","access":"read_only","origin":"derived","component_ids":["electronics"],"write_via":null},"valve.opening":{"meaning_zh":"过程线性节流的归一化有效开度估计；手动模式可写，自动模式由控制器更新。不是测得的真实阀行程。","unit":"1","access":"read_write","origin":"derived","component_ids":["control_valve"],"write_via":"valve.set_opening"},"scene.valve_position":{"meaning_zh":"独立归一化展示阀芯位置；仅通过场景能力修改，不映射过程 valve.opening。","unit":"1","access":"read_write","origin":"scene","component_ids":["control_valve"],"write_via":"scene.set_valve_position"},"process.upstream_absolute_pressure_pa":{"meaning_zh":"受信宿主上游过程体积内的绝对压力真值，pV=nRT。","unit":"Pa","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.upstream_moles_mol":{"meaning_zh":"受信宿主过程体积内的 N2 摩尔数真值。","unit":"mol","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.inflow_mol_s":{"meaning_zh":"外部宿主显式提供的恒定步内流入摩尔流率。","unit":"mol/s","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.downstream_absolute_pressure_pa":{"meaning_zh":"外部宿主显式提供的下游绝压边界。","unit":"Pa","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.outflow_mol_s":{"meaning_zh":"当前状态的瞬时线性节流出口摩尔流率。","unit":"mol/s","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.integrated_inflow_mol":{"meaning_zh":"创建实例后累计进入此过程体积的摩尔量。","unit":"mol","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null},"process.integrated_outflow_mol":{"meaning_zh":"创建实例后累计从此过程体积排出的摩尔量。","unit":"mol","access":"read_only","origin":"process_truth","component_ids":["flow_body"],"write_via":null}},"mechanisms":{"isothermal_backpressure":{"meaning_zh":"上游受压容积经出口节流泄压；背压控制器不生成压力。N2 等温理想气体与线性阀是显式数值近似。","implementation":"lumped","equations":["p_abs*V=n*R*T; dn/dt=q_in-q_out","q_out=C*u*max(p_abs-p_down_abs,0); 0<=u<=1","每一步先按宿主 dt 更新活动目标与控制输出；步内固定开度、流入及下游压力，用解析指数解积分气体平衡。","u_next=clip(u+gain*(pressure_reading-active_setpoint)*dt,0,1); 压力过高则增大出口开度。","处于下游压力以下时只累积输入，达到下游压力后才进入正向出口流分支。"],"parameters":{"valve_conductance_mol_s_pa":{"value":null,"unit":"mol/(s*Pa)","evidence":"unknown","meaning_zh":"线性导通系数 C；必须由宿主显式提供，不能代替厂家 Kv。"},"vendor_valve_kv":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"此配置真实阀容量未给定。"},"upstream_volume_m3":{"value":null,"unit":"m^3","evidence":"unknown","meaning_zh":"上游外部过程体积，宿主必填；非仪器内部死体积。"},"temperature_k":{"value":null,"unit":"K","evidence":"unknown","meaning_zh":"等温气体场景温度，宿主必填；工作范围 263.15–343.15 K。"},"control_gain_per_pa_s":{"value":null,"unit":"1/(Pa*s)","evidence":"unknown","meaning_zh":"仿真积分控制增益，宿主必填；非厂家 PID 参数。"},"pressure_reference_pa":{"value":null,"unit":"Pa","evidence":"unknown","meaning_zh":"表压对应的参考绝压，宿主必填。"}}}},"limitations":["选定型号为 CHEM-181 Bronkhorst EL-PRESS P-702CV；传感器固定 0–500000 Pa 表压且 N2 为本次配置假设，未确认工厂完整订货号。不能以系列 400 bar 作为上限。","保留厂家 P-600/P-700 标准准确度、重复性、量程比及典型稳定性条件；未混用 P-800 性能，也未证明本模型满足厂商精度。","厂家 2 ms 仅传感器响应，未建传感器动态延迟或完整闭环响应模型。实际阀 Kv、真实阀行程、内部死体积及闭环稳定时间为 null。","外形按 A77/B127/C47/H123/K25 mm 解释：A、B、C 同沿 X，H 沿 Z，K 沿 Y；C47 不是整机宽度。局部布局、端口高度、内构件和放大展示行程是重建假设。","URDF 仅使用 box/cylinder/sphere 碰撞体，整机 0.7 kg 和包围盒惯量集中于 base_link；子件质量、惯量、摩擦未知。碰撞文件存在不证明机器人接触或动力学可用。","URDF 展示棱柱关节的 effort=0/velocity=0 是禁用驱动的元数据占位，不是厂家额定参数；该关节只供运动学示意。","展示 scene.valve_position 与过程 valve.opening 是两个不同状态。无过程到几何联动；场景求值验证与过程测试独立记录。","robot/hardware 均 absent；夹持、attach/release、接触抓取、安装约束、真实气路连接由宿主承担且未执行验证。","需先固定传感器压力量程、气体和阀容量；补容积-流量-压力耦合，不能把系列最高400 bar用作此型号上限。 2 ms仅传感器响应，不可作为整个压力闭环的稳定时间。","Host must supply process volume, temperature, initial absolute pressure, downstream absolute pressure, inflow, linear valve conductance, gauge reference and control gain; these are scenario values, not vendor component specifications.","Ideal isothermal N2 gas only: no liquid, real-gas, choking, reverse flow, leakage, noise, hysteresis or calibrated valve characteristic.","Discrete integral output control is a simulation assumption; stability and step size depend on explicit host parameters.","Power-off forces modeled outlet opening to zero as a scenario assumption; unpowered gas accumulation still occurs. Real fail-safe state is unknown.","Scene valve position is independent normalized explanatory state; no process-to-scene actuation or physical valve stroke is claimed.","Agent API filtering is implemented; trusted Python host introspection and file access are outside this boundary.","Idempotency is per principal and instance in memory only; no cross-restart exactly-once promise."],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["control.set_gain","control.set_mode","control.set_ramp_rate","power.set","pressure.set_setpoint","scene.set_valve_position","simulation.set_boundary","simulation.step","valve.set_opening"],"unsupported":[],"note_zh":"桥接 basic40_runtime_automation.P702CVRuntime（推进方式 step_dt_world），18 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（1 个按键（碰到即触发））；1 个门/盖/升降关节与运行层双向同步；接口点 0 个（无）；布局：台面、单人可搬、正面 −y、前方留空 0.25 m"}},"previews":["previews/bronkhorst_p702cv_5bar_gauge_n2/preview.webp","previews/bronkhorst_p702cv_5bar_gauge_n2/preview_cutaway.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t5_automation/bronkhorst_p702cv/asset.contract.json","bytes":172719},{"name":"collision_p