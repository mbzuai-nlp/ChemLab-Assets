":[]},"sample.attach":{"function_zh":"已登记容器、已登记约束、端口位置与负载检查通过后，调用宿主attach约束并记录明确回执。","kind":"device_command","availability":"implemented","component_ids":["gripper"],"implementation":{"process":"verified","scene":"verified","robot":"absent","hardware":"absent","host":"verified"},"input":["container_id","constraint_id"]},"sample.release":{"function_zh":"在已登记接收端口调用宿主release约束，确认后登记容器拓扑与事件。","kind":"device_command","availability":"implemented","component_ids":["gripper"],"implementation":{"process":"verified","scene":"verified","robot":"absent","hardware":"absent","host":"verified"},"input":["receiver_port_id"]},"robot.contact_grasp":{"function_zh":"接触抓取、机器人规划和真实夹爪驱动未实现。","kind":"robot_skill","availability":"unsupported","component_ids":["gripper"],"implementation":{"process":"absent","scene":"not_applicable","robot":"absent","hardware":"absent","host":"absent"},"input":[]},"motion.set_tcp_velocity":{"function_zh":"无轨迹执行器，典型整机TCP速度不作为可执行的速度设定。","kind":"device_command","availability":"unsupported","component_ids":["controller"],"implementation":{"process":"absent","scene":"not_applicable","robot":"absent","hardware":"absent","host":"absent"},"input":["velocity_m_s"]},"simulation.commit_pose":{"function_zh":"可信宿主直接调用：写入四轴模型并校验依赖图求值的关节、TCP和末端包围盒；匹配目标才确认到位。","kind":"simulation","availability":"implemented","component_ids":["lift","upper_arm","forearm","wrist","gripper"],"implementation":{"process":"implemented","scene":"verified","host":"implemented","robot":"absent","hardware":"absent"},"input":["joints","world_time_s"]}},"state_slots":{"power.enabled":{"meaning_zh":"power.enabled；见运行层语义和访问边界。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["controller"],"write_via":"power.set"},"motion.target_joints":{"meaning_zh":"motion.target_joints；见运行层语义和访问边界。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["controller"],"write_via":"motion.set_joints"},"motion.status":{"meaning_zh":"motion.status；见运行层语义和访问边界。","unit":"1","access":"read_only","origin":"derived","component_ids":["controller"],"write_via":null},"scene.joints":{"meaning_zh":"scene.joints；见运行层语义和访问边界。","unit":"1","access":"read_only","origin":"scene","component_ids":["controller"],"write_via":null},"scene.tcp_position_m":{"meaning_zh":"scene.tcp_position_m；见运行层语义和访问边界。","unit":"m","access":"read_only","origin":"scene","component_ids":["controller"],"write_via":null},"scene.tool_yaw_rad":{"meaning_zh":"scene.tool_yaw_rad；见运行层语义和访问边界。","unit":"rad","access":"read_only","origin":"scene","component_ids":["controller"],"write_via":null},"scene.end_effector_aabb_m":{"meaning_zh":"scene.end_effector_aabb_m；见运行层语义和访问边界。","unit":"m","access":"read_only","origin":"scene","component_ids":["controller"],"write_via":null},"scene.sample_time_s":{"meaning_zh":"scene.sample_time_s；见运行层语义和访问边界。","unit":"s","access":"read_only","origin":"scene","component_ids":["controller"],"write_via":null},"sample.attached_container_id":{"meaning_zh":"sample.attached_container_id；见运行层语义和访问边界。","unit":"1","access":"read_only","origin":"scene","component_ids":["gripper"],"write_via":null},"sample.constraint_id":{"meaning_zh":"sample.constraint_id；见运行层语义和访问边界。","unit":"1","access":"read_only","origin":"scene","component_ids":["gripper"],"write_via":null},"sample.events":{"meaning_zh":"sample.events；见运行层语义和访问边界。","unit":"1","access":"read_only","origin":"scene","component_ids":["gripper"],"write_via":null},"sample.container_ids":{"meaning_zh":"sample.container_ids；见运行层语义和访问边界。","unit":"1","access":"read_only","origin":"scene","component_ids":["gripper"],"write_via":null},"sample.receiver_port_ids":{"meaning_zh":"sample.receiver_port_ids；见运行层语义和访问边界。","unit":"1","access":"read_only","origin":"scene","component_ids":["gripper"],"write_via":null},"host.scene_bound":{"meaning_zh":"host.scene_bound；见运行层语义和访问边界。","unit":"1","access":"read_only","origin":"derived","component_ids":["controller"],"write_via":null},"truth.registered_payloads":{"meaning_zh":"truth.registered_payloads；见运行层语义和访问边界。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["controller"],"write_via":null}},"mechanisms":{"kinematics":{"meaning_zh":"假设连杆几何的4轴正运动学；末端8角经累计yaw旋转得包围盒。","implementation":"numerical","equations":["yaw=shoulder+elbow+wrist","x=L1*cos(shoulder)+L2*cos(shoulder+elbow)+tool_x*cos(yaw)","y=L1*sin(shoulder)+L2*sin(shoulder+elbow)+tool_x*sin(yaw)","z=z_home+qz"],"parameters":{"l1":{"value":0.25,"unit":"m","evidence":"assumption","meaning_zh":"作者定义的模型几何，不是厂家部件规格。"},"l2":{"value":0.25,"unit":"m","evidence":"assumption","meaning_zh":"作者定义的模型几何，不是厂家部件规格。"},"tool_x":{"value":0.079,"unit":"m","evidence":"assumption","meaning_zh":"作者定义的模型几何，不是厂家部件规格。"},"z_home":{"value":0.2,"unit":"m","evidence":"assumption","meaning_zh":"作者定义的模型几何，不是厂家部件规格。"}}}},"limitations":["目标关节写入是同步设定，不表示实际运动完成。可信宿主提供共同时间并通过求值场景回调确认关节、TCP与末端包围盒。没有轨迹、动力学或碰撞规避。","典型TCP速度0.5 m/s、最大加速度2 m/s²、重复定位±90 µm只作为整机证据，不推导各关节速度、部件误差、碰撞或运动时长。","attach/release由预注册宿主约束回调执行；容器、端口、位置容差、gross payload及证据由宿主明确登记；没有接触抓取、夹爪力、摩擦或硬件驱动。","清单Rev B原文为with Servo Gripper的0.5 kg负载；不同文档版本的口径仍需按实物配置核验。gross_payload_kg保守记录容器、内容物、额外夹具，以及宿主按配置计入的末端工具总外载；宿主必须明确提供，未给则null且不可attach。本模拟不授予实机载荷使用许可。","J1范围0..0.4 m，J2±93°、J3±168°、J4±960°来自Rev B网页索引；直接PDF失效，图纸尺寸尚未可靠取得。两段0.25 m连杆和0.079 m腕到TCP偏置是明确的代理几何假设，真实部件尺寸仍为null。","目标位姿通过有界关节目标与正运动学表达；尚无逆运动学、任务队列调度、原厂设备握手协议或可执行的TCP速度设定。宿主求值与约束回执仅为本仿真适配接口。","样品拓扑仅搬运完整容器；不改变内容物或推断其组成。容器/端口唯一性与跨仪器约束一致性由外层世界注册表保证。","本模块无气路端口。整机20 kg与0.5 kg额定负载不能代替连杆质量、惯量、夹具重量或材料参数；未知属性保持null。","回调异常后外部副作用未知，motion.status=fault阻止重复附着和移动；只能由可信宿主在外部状态核实后恢复。","身份来自可信宿主；API过滤不是Python或共享文件系统隔离。请求去重仅当前进程内存有效。","分件OBJ和GLB保存导出姿态；原生可编辑关节在Blender及URDF。","URDF为运动学/碰撞代理描述，碰撞只盒柱球；没有未知连杆质量对应的inertial。各link绝对惯量为null，单位质量包围盒系数和整机姿态包围盒惯量为assumption。","伺服夹爪外形已建，夹指开合行程/力未校准，当前固定开口；attach/release由外部宿主约束。","真实图纸外形核对、真实硬件、接触碰撞、轨迹时间、机器人路径规划均not_run。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["motion.forward_kinematics","motion.set_joints","power.set","sample.attach","sample.release","state.read"],"unsupported":["motion.set_tcp_velocity","robot.contact_grasp","simulation.commit_pose"],"note_zh":"桥接 basic40_runtime_automation.PreciseFlex400Runtime（推进方式 host_set_clock_abs），15 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（4 个门/盖/阀等被动关节）；接口点 1 个（夹持）；布局：台面、单人可搬、正面 −y、前方留空 0.25 m"}},"previews":["previews/brooks_preciseflex_400/preview_articulated.webp","previews/brooks_preciseflex_400/preview_neutral.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t5_automation/preciseflex_400/asset.contract.json","bytes":188298},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t5_automation/preciseflex_400/collision_proxies.json","bytes":7559},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t5_automation/preciseflex_400/geometry_manifest.json","bytes":35698},{"name":"model.blend","path":"assets/basic40_batch02/t5_automation/preciseflex_400/model.blend","bytes":135067},{"name":"model.glb","path":"assets/basic40_batch02/t5_automation/preciseflex_400/model.glb","bytes":1490228},{"name":"model.urdf","path":"assets/basic40_batch02/t5_automation/preciseflex_400/model.urdf","bytes":9712}],"completeness":{"components":12,"with_collisions":11,"with_objects":12,"with_function":12,"with_mass":0,"joints_matching_component":4,"joints":4,"has_contract":true,"has_layout":true,"has_glb":true,"checks_present":["articulation_check","coverage","validation_summary","contract_validation","runtime_validation","scene_validation"]},"slug":"brooks_preciseflex_400","chem_id":"CHEM-178","name_en":"Lab sample-transfer robot arm","maker":"Brooks Automation","model":"PreciseFlex 400","domain":"automation","domain_name":"Automation & Gas/Liquid Supply","path":"assets/basic40_batch02/t5_automation/preciseflex_400","glb_up":"z","has_contract":true,"contract":"assets/basic40_batch02/t5_automation/preciseflex_400/asset.contract.json","runtime":"scripts/basic40_runtime_automation.py"}