,"display"],"write_via":null},"water.dispensed_volume_m3":{"meaning_zh":"本次实际转移的合成过程真值","unit":"m^3","access":"read_only","origin":"process_truth","component_ids":["nozzle","display"],"write_via":null},"water.total_dispensed_volume_m3":{"meaning_zh":"实例创建以来累计转移给接收容器的合成体积","unit":"m^3","access":"read_only","origin":"process_truth","component_ids":["nozzle","display"],"write_via":null},"water.feed_volume_m3":{"meaning_zh":"外部进水边界剩余体积","unit":"m^3","access":"read_only","origin":"process_truth","component_ids":["fluid_ports"],"write_via":null},"water.buffer_volume_m3":{"meaning_zh":"宿主净水缓冲边界剩余体积；不是已知内部储罐参数","unit":"m^3","access":"read_only","origin":"process_truth","component_ids":["reservoir","ro_module"],"write_via":null},"water.receiver_volume_m3":{"meaning_zh":"外部接收容器当前体积","unit":"m^3","access":"read_only","origin":"process_truth","component_ids":["nozzle","display"],"write_via":null},"water.waste_volume_m3":{"meaning_zh":"RO浓水与冲洗排水的累计合成体积","unit":"m^3","access":"read_only","origin":"process_truth","component_ids":["fluid_ports"],"write_via":null},"water.ro_product_volume_m3":{"meaning_zh":"累计RO补充的净水体积","unit":"m^3","access":"read_only","origin":"process_truth","component_ids":["reservoir","ro_module"],"write_via":null},"consumables.cumulative_throughput_m3":{"meaning_zh":"实例创建以来流经抛光回路的体积；复位不清除此审计量","unit":"m^3","access":"read_only","origin":"process_truth","component_ids":["purification_pack","display"],"write_via":null}},"mechanisms":{"water_balance":{"meaning_zh":"有限进水、缓冲与接收容器之间的分段水量转移；engineering_assumption。循环模式的RO补水、定量与冲洗互斥。","implementation":"lumped","equations":["dispense_dV=min(Q_set*dt, target_remaining, buffer_available, receiver_free)","flush_dV=min(Q_flush_host*dt, buffer_available); waste += flush_dV","recirculate_ro_dV=min(Q_ro*dt, buffer_free, feed_available*recovery_fraction); feed -= ro_dV/recovery_fraction; waste += feed_used-ro_dV"],"parameters":{"maximum_dispense_flow":{"value":3.3333333333333335e-05,"unit":"m^3/s","evidence":"documented","meaning_zh":"清单额定整机取水上限。"},"maximum_ro_makeup_flow":{"value":5.555555555555556e-06,"unit":"m^3/s","evidence":"documented","meaning_zh":"清单额定RO补水上限。"},"calibrated_quality_flow_relation":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"未补齐水质、耗材寿命与流量关联。"},"real_reservoir_capacity":{"value":null,"unit":"m^3","evidence":"unknown","meaning_zh":"宿主缓冲为场景边界，不声明厂家内部容量。"}}}},"limitations":["Engineering-assumption volume bookkeeping only; not a manufacturer controller, purification, hydraulics, thermal, contaminant, microbial or filter-life model.","The host explicitly supplies qualified feed, available purified-water buffer and receiver boundaries; buffer capacity is a simulation boundary, not a claimed internal tank specification.","RO replenishment occurs only in recirculate mode; dispense, flush and RO replenishment are mutually exclusive engineering simplifications. RO recovery fraction and recirculation/flush rates require host provenance and have no manufacturer default.","The 10 L/day catalog usage figure is a nominal application rating, not an enforced daily quota. Dispense flow is capped at 2 L/min and RO product flow at 20 L/h.","Resistivity, temperature and TOC remain null until a trusted host supplies observations with provenance. 182000 ohm*m at 298.15 K is the catalog reference, never an automatically guaranteed output; typical TOC <5 ppb is feed-dependent, not a default reading.","Consumable lifetime, remaining fraction and performance degradation remain unknown/null. Throughput is a synthetic cumulative counter; reset requires a one-use trusted-host replacement confirmation.","Arm height is a manually positioned simulation configuration with 0..0.12 m travel from the catalog overall height span; no powered arm, robot action, collision or hardware driver is claimed.","Device commands are synchronous state transitions; water transfer happens only on the shared host step. Stop, power-off, buffer exhaustion and receiver-full retain partial transferred volume.","Scene callbacks receive public observations only; a command callback failure leaves process state unchanged but scene effects unknown. Host-step callback failure retains committed material transfers and time.","Session filtering is an API boundary, not Python memory/filesystem/process isolation; trusted host methods and debug snapshots must remain outside agent transport.","Request deduplication is in memory per principal and instance and does not survive restart. This water asset has no vacuum dependency.","清单外未知物性保持null；场景尺寸为估计而非厂家CAD。","23kg工作质量只记整机；均匀包围盒惯量是engineering_assumption。子连杆未给惯性，接触动力学未验证。","URDF effort=1、velocity=0.05仅用于语法交换的engineering_assumption占位；真实臂推力和速度为null，禁止将占位当厂家或部件参数。","本配置无外部真空口，不创建或依赖共用真空泵。","未默认配置POU/Biofilter，不保证微生物、内毒素或颗粒指标。","18.2MΩ·cm及TOC<5ppb为清单额定/典型指标，实例默认读数null，不能以模拟值证明水质。","GLB与OBJ保存低位静态状态；动态联动须加载原生Blender并注册本目录scene_adapter。","API权限过滤不隔离Python对象内存或本地文件；不受信任代理部署仍需受信任宿主进程边界。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["arm.set_height","consumables.reset","power.set","water.set_flow_rate","water.set_mode","water.set_volume","water.start","water.stop"],"unsupported":[],"note_zh":"桥接 basic40_runtime_vacuum.PurelabHost（推进方式 step_dt），26 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（5 个按键（碰到即触发）、1 个门/盖/阀等被动关节）；1 个门/盖/升降关节与运行层双向同步；接口点 1 个（出液位）；布局：台面或挂墙、单人可搬、正面 −y、前方留空 0.25 m；面板为菜单/文字屏（待办）"}},"previews":["previews/elga_purelab_flex3/preview.webp","previews/elga_purelab_flex3/preview_operating.webp","previews/elga_purelab_flex3/preview_rear.webp","previews/elga_purelab_flex3/preview_service.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t2_vacuum/elga_purelab_flex3/asset.contract.json","bytes":175405},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t2_vacuum/elga_purelab_flex3/collision_proxies.json","bytes":22767},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t2_vacuum/elga_purelab_flex3/geometry_manifest.json","bytes":50159},{"name":"model.blend","path":"