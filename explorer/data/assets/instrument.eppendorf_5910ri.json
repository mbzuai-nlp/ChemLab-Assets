ia":null},"display.temperature_k":{"meaning_zh":"显式合成过程温度的理想显示投影，非厂商传感器。","unit":"K","access":"read_only","origin":"derived","component_ids":["display"],"write_via":null},"alarm.imbalance":{"meaning_zh":"显式合成槽位向量、样品质量和阈值推导的告警；缺配置为null。","unit":"1","access":"read_only","origin":"derived","component_ids":["lid_lock","display"],"write_via":null},"run.status":{"meaning_zh":"异步合成运行生命周期；stopping时仍不可开盖。","unit":"1","access":"read_only","origin":"derived","component_ids":["drive","display"],"write_via":null},"run.operation_id":{"meaning_zh":"当前实例和调用身份拥有的操作标识。","unit":"1","access":"read_only","origin":"derived","component_ids":["drive","display"],"write_via":null},"run.elapsed_s":{"meaning_zh":"当前运行相对起始时间；read/poll不推进。","unit":"s","access":"read_only","origin":"derived","component_ids":["drive","display"],"write_via":null},"measurement.curve":{"meaning_zh":"synthetic速度/温度/相对时间历史；physical_separation_model始终null。","unit":"1","access":"read_only","origin":"derived","component_ids":["display"],"write_via":null},"process.truth":{"meaning_zh":"未投影的合成过程内部状态，仅受信任debug/evaluator。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["drive","refrigeration"],"write_via":null}},"mechanisms":{"synthetic_centrifugation":{"meaning_zh":"显式配置的速度/温度过程、运行盖锁和装载失衡告警；不求解真实沉降。","implementation":"lumped","equations":["速度使用宿主给定的分级线性加速/制动率；转子相位对速度积分。","T(t+dt)=Ttarget+(T(t)-Ttarget) exp(-dt/tau)，tau必须由宿主显式提供synthetic值。","U=norm(sum_i(m_i * r_i_xy))；比较显式合成失衡阈值，真实厂家阈值未知。","RCF和沉降模型未实现；运行曲线physical_separation_model=null。"],"parameters":{"speed_range_rad_s":{"value":[10.471975511965978,1466.0765716752367],"unit":"rad/s","evidence":"documented","meaning_zh":"speed_range_rad_s"},"temperature_range_k":{"value":[262.15,313.15],"unit":"K","evidence":"documented","meaning_zh":"temperature_range_k"},"duration_range_s":{"value":[10,359940],"unit":"s","evidence":"documented","meaning_zh":"duration_range_s"},"acceleration_levels":{"value":10,"unit":"1","evidence":"documented","meaning_zh":"acceleration_levels"},"braking_levels":{"value":10,"unit":"1","evidence":"documented","meaning_zh":"braking_levels"},"maximum_rcf_fixed_angle":{"value":22132,"unit":"1","evidence":"documented","meaning_zh":"Fixed-angle category only; not an enabled rotor operating limit or radius inference."},"maximum_capacity_large_capacity_m3":{"value":0.004,"unit":"m^3","evidence":"documented","meaning_zh":"4 x 0.001 m^3, rotor-dependent; exact rotor/model/configuration unknown; cannot combine with maximum RCF."},"lid_maximum_angle_rad":{"value":1.5707963267948966,"unit":"rad","evidence":"assumption","meaning_zh":"lid_maximum_angle_rad"},"loading_clearance_rad":{"value":1.0471975511965976,"unit":"rad","evidence":"assumption","meaning_zh":"loading_clearance_rad"},"lid_closed_tolerance_rad":{"value":1e-06,"unit":"rad","evidence":"assumption","meaning_zh":"lid_closed_tolerance_rad"},"rotor_radius_m":{"value":null,"unit":"m","evidence":"unknown","meaning_zh":"No manufacturer/component value inferred; synthetic host fixtures are separate."},"rotor_mass_kg":{"value":null,"unit":"kg","evidence":"unknown","meaning_zh":"No manufacturer/component value inferred; synthetic host fixtures are separate."},"rotor_inertia_kg_m2":{"value":null,"unit":"kg*m^2","evidence":"unknown","meaning_zh":"No manufacturer/component value inferred; synthetic host fixtures are separate."},"loaded_sample_mass_kg":{"value":null,"unit":"kg","evidence":"unknown","meaning_zh":"No manufacturer/component value inferred; synthetic host fixtures are separate."},"imbalance_threshold_kg_m":{"value":null,"unit":"kg*m","evidence":"unknown","meaning_zh":"No manufacturer/component value inferred; synthetic host fixtures are separate."},"acceleration_rad_s2":{"value":null,"unit":"rad/s^2","evidence":"unknown","meaning_zh":"No manufacturer/component value inferred; synthetic host fixtures are separate."},"braking_rad_s2":{"value":null,"unit":"rad/s^2","evidence":"unknown","meaning_zh":"No manufacturer/component value inferred; synthetic host fixtures are separate."},"temperature_time_constant_s":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"No manufacturer/component value inferred; synthetic host fixtures are separate."},"sedimentation_rate":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"No manufacturer/component value inferred; synthetic host fixtures are separate."},"slot_count":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"No manufacturer/component value inferred; synthetic host fixtures are separate."}}}},"limitations":["本资产为本批次结构与合成过程范围，非制造商CAD或可操作真实仪器的驱动。","最高22132×g固定角转子与最大4×1000mL容量不能跨转子组合；具体转子型号、半径、单转子限速和真实槽位配置未知。","闭盖72×68×37cm、开盖85cm和109kg来自清单；所有局部示意尺寸与材料外观标为visual_proxy。","整机均匀包围盒惯量仅为assumption/derived；部件质量、惯量、接触摩擦未知为null，没有把整机参数分配给零件。","离心曲线和样品效果为synthetic；未知真实沉降模型、热响应、加减速率和失衡阈值，显式宿主测试配置不等于厂家数据。","机器人抓放、接触动力学、真实沉降结果、真实硬件和厂商安全性能验证均not_run。","GLB/OBJ保存导出时静态姿态与文字；运行联动入口位于原生Blender场景适配器。","GLB默认显示未装样的大容量类别几何代理；默认rotor/rotor_slots OBJ与URDF不叠加固定角转子。备用rotor_fixed_angle.obj是独立几何，不是已标定的另一额定转子配置。URDF静态显示4个样品载体代理；实时逐槽装卸与显隐由原生Blender适配器实现。","当前Blender场景仅支持slot_1至slot_4四个示意装载位置；这不是任一真实转子的槽数或容量配置声明。","当前Blender适配器以固定对象绑定一个场景内的一台仪器，并拒绝其他实例标识；同场景多台仪器的实例化与隔离验证未执行。运行层双实例测试单独取证。","URDF显式使用version=1.2，仅用于运动学与碰撞基元。根链接惯量是109kg整机闭盖均匀盒近似，子链接惯量省略。未知effort/velocity省略后，现代urdfdom1.2会视为无软件上限，不代表真实物理无限能力；物理上限在合同中为null，具体解析器导入与接触动力学not_run。","进程内访问过滤不构成文件系统或不可信Python代码的安全隔离；不向代理发布真实样品真值文件。","No sample sedimentation/separation, RCF control, hardware or robot execution is implemented.","Curve is synthetic velocity/temperature history, not a spectrum and not measured telemetry; derived display uses an explicit ideal synthetic observation projection.","First-order temperature and linear acceleration/braking require explicit trusted-host synthetic parameters; no physical rotor inertia/torque solution is claimed.","Method duration is synthetic total time from start until braking begins; manufacturer timer-mode details are unknown.","Slot vectors and imbalance threshold are host synthetic fixtures; sample masses/truth and numerical imbalance stay private.","Public API filtering is not a sandbox against Python host introspection or filesystem access.","Scene callback success alone does not establish Blender evaluated-pose verification.","Idempotency is in-memory per principal and instance; no restart persistence or real material transfer is claimed.","Balance is a pre-run static mass-moment check; no changing load, vibration dynamics, or in-run imbalance sensor noise is simulated.","At most 10000 regularly spaced post-start curve samples plus one exact final sample are retained. If an unusually slow host-configured power-off coast extends the duration beyond that grid, the explicit time axis has a gap before the final point; no interpolated samples are fabricated.","Power-off during an existing braking segment preserves that segment's synthetic deceleration. It always keeps the lid locked until the terminal stop event."],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["centrifuge.get_curve","centrifuge.measure","centrifuge.set_method","centrifuge.stop","lid.set_angle","power.set","rotor.select","sample.load","sample.unload"],"unsupported":[],"note_zh":"桥接 basic40_runtime_analytical.Eppendorf5910Ri（推进方式 host_advance_abs），21 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（2 个门/盖/阀等被动关节）；1 个门/盖/升降关节与运行层双向同步，1 个关节跟随运行层状态；接口点 24 个（孔位）；布局：落地、固定、正面 −y、前方留空 0.25 m；面板读数 rpm(5)、temp(3)"}},"previews":["previews/eppendorf_5910ri/preview_closed.webp","previews/eppendorf_5910ri/preview_open.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t3_analytical/eppendorf_5910ri/asset.contract.json","bytes":241109},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t3_analytical/eppendorf_5910ri/collision_proxies.json","bytes":14765},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t3_analytical/eppendorf_5910ri/geometry_manifest.json","bytes":35242},{"name":"model.blend","path":"assets/basi