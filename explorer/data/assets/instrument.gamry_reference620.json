ull表示未连接，不证明接触或机器人接线已完成。","unit":"1","access":"read_write","origin":"scene","component_ids":["reference_electrode_slot"],"write_via":"slot.set_connection"},"slot.counter_electrode.connection_id":{"meaning_zh":"宿主场景连接槽的逻辑引用；null表示未连接，不证明接触或机器人接线已完成。","unit":"1","access":"read_write","origin":"scene","component_ids":["counter_electrode_slot"],"write_via":"slot.set_connection"},"slot.cell.connection_id":{"meaning_zh":"宿主场景连接槽的逻辑引用；null表示未连接，不证明接触或机器人接线已完成。","unit":"1","access":"read_write","origin":"scene","component_ids":["cell_slot"],"write_via":"slot.set_connection"},"waveform.program":{"meaning_zh":"显式离散命令程序；电位与电流互斥；采样间隔须不小于表列最小时间基准。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["root"],"write_via":"electrochem.configure_waveform"},"waveform.status":{"meaning_zh":"离散播放状态，不代表真实样本实验完成。","unit":"1","access":"read_only","origin":"derived","component_ids":["root"],"write_via":null},"waveform.running":{"meaning_zh":"是否等待宿主推进来播放剩余命令。","unit":"1","access":"read_only","origin":"derived","component_ids":["root"],"write_via":null},"waveform.sample_count":{"meaning_zh":"已播放命令点数。","unit":"1","access":"read_only","origin":"derived","component_ids":["root"],"write_via":null},"waveform.elapsed_s":{"meaning_zh":"本次播放已推进的有效时间，完成后停在最后命令点。","unit":"s","access":"read_only","origin":"derived","component_ids":["root"],"write_via":null},"output.commanded_potential_v":{"meaning_zh":"当前合成电位命令；停止或使用电流模式时为null。","unit":"V","access":"read_only","origin":"derived","component_ids":["root"],"write_via":null},"output.commanded_current_a":{"meaning_zh":"当前合成电流命令；停止或使用电位模式时为null。","unit":"A","access":"read_only","origin":"derived","component_ids":["root"],"write_via":null},"acquisition.series":{"meaning_zh":"按时间排列的命令回放序列；两种实测通道均为null。","unit":"1","access":"read_only","origin":"derived","component_ids":["root"],"write_via":null},"acquisition.synthetic":{"meaning_zh":"本适配器产生的序列始终标记synthetic。","unit":"1","access":"read_only","origin":"derived","component_ids":["root"],"write_via":null},"measurement.potential_v":{"meaning_zh":"未接入真实电位传感器；无响应模型。","unit":"V","access":"read_only","origin":"sensor","component_ids":["root"],"write_via":null},"measurement.current_a":{"meaning_zh":"未接入真实电流传感器；无响应模型。","unit":"A","access":"read_only","origin":"sensor","component_ids":["root"],"write_via":null},"method.scan_rate_v_s":{"meaning_zh":"未配置连续扫描速率；本批仅显式离散程序。","unit":"V/s","access":"read_only","origin":"setpoint","component_ids":["root"],"write_via":null},"method.frequency_hz":{"meaning_zh":"未配置EIS频率；EIS执行不支持。","unit":"Hz","access":"read_only","origin":"setpoint","component_ids":["root"],"write_via":null},"method.amplitude_v":{"meaning_zh":"未配置EIS振幅；无虚构默认值。","unit":"V","access":"read_only","origin":"setpoint","component_ids":["root"],"write_via":null},"method.ir_compensation_ohm":{"meaning_zh":"未提供iR补偿参数，保持未知。","unit":"ohm","access":"read_only","origin":"setpoint","component_ids":["root"],"write_via":null},"scheduler.started_at_s":{"meaning_zh":"宿主内部调度起点；仅debug/evaluator可见。","unit":"s","access":"read_only","origin":"process_truth","component_ids":["root"],"write_via":null}},"mechanisms":{"synthetic_command_playback":{"meaning_zh":"宿主时间驱动的显式离散命令回放；只是synthetic序列，不计算样本电化学响应。","implementation":"numerical","equations":["t_k = t_start + k * sample_interval_s","内部时间输入按最短十进制表示转换为精确有理数后累计和比较；完整对外浮点时间戳计划须有限且严格递增。","command_k = program.values[k]；电位模式单位V，电流模式单位A；另一命令通道为null。","measured_potential_v = null；measured_current_a = null；synthetic = true。"],"parameters":{"maximum_program_samples":{"value":10000,"unit":"1","evidence":"assumption","meaning_zh":"本地资源预算；不是厂家的最大采样点数。"},"minimum_program_interval":{"value":3.333e-06,"unit":"s","evidence":"assumption","meaning_zh":"engineering_assumption：将表列最小时间基准作为软件程序最小点间隔，不声称固件采样或实时性能。"},"cell_resistance":{"value":null,"unit":"ohm","evidence":"unknown","meaning_zh":"真实电池电阻未知；未使用欧姆定律制造响应。"},"electrode_area":{"value":null,"unit":"m^2","evidence":"unknown","meaning_zh":"真实电极面积未知。"}}}},"limitations":["本批仅建立Gamry Reference 620标称外形、固定装配与波形/返回序列；full不等于厂家全功能完成。","所有返回测量结果均标synthetic；没有真实电极/样本响应、噪声、校准曲线、故障概率或真实电化学动力学。","清单EIS频率范围保留为整机规格，electrochem.eis为unsupported；频率扫描、阻抗谱、iR补偿与真实性能验证未实现。","仅单一Cell Cable设备端接口及外部三电极/池逻辑槽；没有虚构电极实体、池体、试样材料或容积。","整机尺寸与3 kg质量来自清单；局部几何和连接帧是示意。所有未知部件物性为null，渲染材质不证明真实材料。","URDF仅用盒/柱/球碰撞基元；3 kg质量与包围盒近似惯量集中在整机单刚体。分件均固定且不赋假质量。","包围盒惯量、参考质心与合成信号为engineering_assumption；未实现Nernst或库仑机理求解。","无可动关节、无过程到场景联动；静态求值姿态检查不能代替操作动画或碰撞动力学验证。","机器人插拔、抓取、接触动力学、真实硬件通信和厂家仪器性能验证均not_run。","协议能力的绑定说明实际Python入口；未把它宣称为真实硬件SDK或已部署跨进程安全隔离。","标称9×27×19 cm为机箱主体约束；电池接口、背面接口和文字存在毫米级外凸。实际可视包围盒见geometry_manifest，不将其覆盖为厂家标称尺寸。","BLEND/OBJ/URDF采用SI、Z向上；GLB遵守glTF的Y向上存储，经导入器恢复到本合同Z向上坐标；此往返已在几何记录单独验证。","工程数值约定：宿主时间输入按最短十进制字符串转为精确有理数累计和比较，保证十进制时间步拆分一致；对外时间戳仍为浮点数，开始前须验证完整计划的时间戳有限且逐点严格递增，否则原子拒绝。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["electrochem.configure_waveform","electrochem.read_series","electrochem.start","electrochem.stop","power.set","slot.set_connection"],"unsupported":["electrochem.eis"],"note_zh":"桥接 basic40_runtime_measure.GamryReference620Runtime（推进方式 step_dt），21 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（无可动关节）；接口点 0 个（无）；布局：台面、机器人可搬、正面 −y、前方留空 0.25 m；面板为菜单/文字屏（待办）"}},"previews":["previews/gamry_reference620/preview_front.webp","previews/gamry_reference620/preview_rear.webp","previews/gamry_reference620/preview_slots_schematic.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t4_measure/gamry_ref620/asset.contract.json","bytes":178234},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t4_measure/gamry_ref620/collision_proxies.json","bytes":4876},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t4_measure/gamry_ref620/geometry_manifest.json","bytes":25019},{"name":"meshes.zip","path":"assets/basic40_batch02/t4_measure/gamry_ref620/meshes.zip","bytes":415334},{"name":"model.blend","path":"assets/basic40_batch02/t4_measure/gamry_ref620/model.blend","bytes":526335},{"name":"model.glb","path":"assets/basic40_batch02/t4_me