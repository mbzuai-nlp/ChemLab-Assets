pectrum":{"meaning_zh":"最近一次合成光谱；含wavelength_m、absorbance、transmittance和signal。全谱显式synthetic=true、quality=estimated；未测量或准备/控制操作后缓存失效为null。","unit":"1","access":"read_only","origin":"derived","component_ids":["optical_module","display"],"write_via":null},"measurement.count":{"meaning_zh":"本实例成功测量次数；无隐式时间推进。","unit":"1","access":"read_only","origin":"derived","component_ids":["optical_module","display"],"write_via":null}},"mechanisms":{"synthetic_spectroscopy":{"meaning_zh":"即时确定性合成光谱；用于装样/关盖/测量流程验证，不对应指定化学物质。","implementation":"numerical","equations":["A(lambda) = baseline + sum(amplitude_i * exp(-0.5*((lambda-center_i)/width_i)^2))","T(lambda) = 10^(-A(lambda)); transmittance为比例，百分数需显式×100","lambda_i=start+i*step，i=0..floor((stop-start)/step)，不保证未落格的stop端点被采样"],"parameters":{"default_peak_centers":{"value":[2.75e-07,5.2e-07],"unit":"m","evidence":"assumption","meaning_zh":"默认测试样品两个人工高斯峰中心。"},"default_peak_widths":{"value":[2.4e-08,6.5e-08],"unit":"m","evidence":"assumption","meaning_zh":"默认高斯宽度参数；不是厂家光谱带宽。"},"default_peak_amplitudes":{"value":[0.75,1.2],"unit":"1","evidence":"assumption","meaning_zh":"默认高斯吸光度幅值。"},"default_sample_baseline":{"value":0.02,"unit":"1","evidence":"assumption","meaning_zh":"默认人工样品吸光度基线。"},"default_blank_baseline":{"value":0.0,"unit":"1","evidence":"assumption","meaning_zh":"默认人工空白谱基线；数值零为显式fixture而不是缺测。"},"loading_clearance":{"value":1.0471975511965976,"unit":"rad","evidence":"assumption","meaning_zh":"允许装卸样品的仿真盖角下限。"},"closed_tolerance":{"value":1e-06,"unit":"rad","evidence":"assumption","meaning_zh":"闭盖判定数值容差。"},"measurement_duration":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"真实测量时长未知；本批即时返回且不推进世界时间。"},"noise_model":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"真实样品噪声模型未标定。"},"concentration_calibration":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"真实校准曲线及浓度换算未知。"}}}},"limitations":["full表示本批外形与功能组件全部登记，未实现厂家所有操作模式。原始三表整行与型号配置保留在来源快照。","局部外观和内部光学盒体为几何近似，不是厂商CAD；局部尺寸、转轴和槽位没有实测证据。","11 kg只归整机根节点；URDF集中整机包围盒惯量属于假设，其他部件真实质量/惯量/摩擦/阻尼等未知为null。","URDF只提供盒/柱/球碰撞体；盖轴使用continuous，只由宿主将q限制在[0,π/2]；URDF没有机械限位或safety_controller，未编造effort/velocity或控制器参数。资产未声称动力学引擎可直接用于真实分件运动。","190–1100 nm可用于合成波长轴；±1 nm准确度和±3 Abs光度范围仅200–900 nm适用，本批没有光学精度验证。","合成谱显式synthetic，不是实际样品或厂商标定结果；真实噪声、校准曲线、浓度定量与故障概率未实现。","透射率比例仅由合成吸光度作T=10^(-A)换算；浓度、方法、厂家校准和时间扫描等未实现条目明确unsupported。","样品与空白在同一插槽顺序装卸；比色皿光程、样品体积/浓度未提供则保持未知。","机器人、真实硬件、接触动力学、真实样品与光学标定验证均not_run。","GLB/OBJ为静态交换资产；交互绑定以原生Blender对象及Python运行模块为准。GLB按任务用export_yup=False保留Z向上；标准glTF查看器若假设Y向上可能需要显式坐标转换。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["lid.set_angle","power.set","sample.load","sample.unload","spectroscopy.measure","spectroscopy.set_mode","spectroscopy.set_scan","spectroscopy.set_wavelength"],"unsupported":[],"note_zh":"桥接 basic40_runtime_analytical.HachDR6000（推进方式 None），14 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（1 个门/盖/阀等被动关节）；1 个门/盖/升降关节与运行层双向同步；接口点 1 个（孔位）；布局：台面、单人可搬、正面 −y、前方留空 0.25 m；面板读数 count(3)"}},"previews":["previews/hach_dr6000/preview_closed.webp","previews/hach_dr6000/preview_open.webp","previews/hach_dr6000/preview_rear.webp","previews/hach_dr6000/preview_runtime.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t3_analytical/hach_dr6000/asset.contract.json","bytes":219221},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t3_analytical/hach_dr6000/collision_proxies.json","bytes":14719},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t3_analytical/hach_dr6000/geometry_manifest.json","bytes":23329},{"name":"model.blend","path":"assets/basic40_batch02/t3_analytical/hach_dr6000/model.blend","bytes":246801},{"name":"model.glb","path":"assets/basic40_batch02/t3_analytical/hach_dr6000/model.glb","bytes":1192236},{"name":"model.urdf","path":"assets/basic40_batch02/t3_analytical/hach_dr6000/model.urdf","bytes":12150}],"completeness":{"components":14,"with_collisions":13,"with_objects":14,"with_function":14,"with_mass":0,"joints_matchin