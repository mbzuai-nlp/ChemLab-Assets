rite_via":null},"evaporation.evaporated_mass_kg":{"meaning_zh":"当前装料配置开始累计的经验蒸发质量真值；无配置时null。","unit":"kg","access":"read_only","origin":"process_truth","component_ids":["evaporating_flask","receiving_flask","vertical_condenser"],"write_via":null},"evaporation.uncondensed_mass_kg":{"meaning_zh":"当前装料配置开始累计未冷凝的质量真值；只用于经验质量守恒账本。","unit":"kg","access":"read_only","origin":"process_truth","component_ids":["evaporating_flask","receiving_flask","vertical_condenser"],"write_via":null},"recovery.condensate_mass_kg":{"meaning_zh":"经验效率分配得到的累计冷凝质量真值；无配置时null，不是相变求解结果。","unit":"kg","access":"read_only","origin":"process_truth","component_ids":["evaporating_flask","receiving_flask","vertical_condenser"],"write_via":null},"recovery.indicated_condensate_mass_kg":{"meaning_zh":"按1e-6kg舍入的经验冷凝质量观测，quality=estimated；不是称量硬件读数。","unit":"kg","access":"read_only","origin":"derived","component_ids":["evaporating_flask","receiving_flask","vertical_condenser"],"write_via":null},"recovery.condensate_volume_m3":{"meaning_zh":"没有密度模型，冷凝液体积始终null/unavailable；不把质量改名为体积。","unit":"m^3","access":"read_only","origin":"derived","component_ids":["evaporating_flask","receiving_flask","vertical_condenser"],"write_via":null}},"mechanisms":{"lift_motion":{"meaning_zh":"电动升降：目标与位置独立，只有宿主step推进位置。","implementation":"lumped","equations":["0 <= q_lift <= 0.14 m；实际升降速度未知，仿真速率必须显式标记工程假设。"],"parameters":{"lift_travel_m":{"value":0.14,"unit":"m","evidence":"documented","meaning_zh":"lift_travel_m"},"default_lift_speed_m_s":{"value":0.02,"unit":"m/s","evidence":"assumption","meaning_zh":"default_lift_speed_m_s"}}},"rotation_motion":{"meaning_zh":"旋转过程与升降独立；理想转速与累计角度由宿主step推进。","implementation":"lumped","equations":["theta(t+dt)=theta(t)+omega*dt；omega_target=RPM*2*pi/60；允许运行速度5–280rpm。"],"parameters":{"rotation_minimum_rad_s":{"value":0.5235987755982988,"unit":"rad/s","evidence":"documented","meaning_zh":"5 rpm*pi/30"},"rotation_maximum_rad_s":{"value":29.321531433504735,"unit":"rad/s","evidence":"documented","meaning_zh":"280 rpm*pi/30"}}},"bath_thermal":{"meaning_zh":"浴温集中热模型与机械运动独立，需宿主提供热容、环境、初温和热损失。","implementation":"lumped","equations":["C*dT/dt=P_heater-UA*(T-T_ambient)；0<=P_heater<=1350W；目标上限453.15K。"],"parameters":{"bath_maximum_temperature_k":{"value":453.15,"unit":"K","evidence":"documented","meaning_zh":"bath_maximum_temperature_k"},"rated_heating_power_w":{"value":1350.0,"unit":"W","evidence":"documented","meaning_zh":"rated_heating_power_w"},"default_ambient_temperature_k":{"value":293.15,"unit":"K","evidence":"assumption","meaning_zh":"default_ambient_temperature_k"},"bath_effective_heat_capacity_j_k":{"value":null,"unit":"J/K","evidence":"unknown","meaning_zh":"Must be supplied by trusted host; no inferred part mass or fluid constants"}}},"evaporation_and_condensation":{"meaning_zh":"宿主提供装料质量、经验恒定蒸发率、冷凝效率和证据后，按质量账本计算剩余、冷凝和未冷凝量。缺任何配置时质量为null。","implementation":"lumped","equations":["启动条件：宿主已配置装料、经验质量速率和效率，已配置浴温且供电/旋转/加热开启，已登记外部真空源且存在压力快照。","dm=min(m_remaining, configured_rate_kg_s*dt)；m_remaining-=dm；m_evaporated+=dm。","m_condensate+=eta*dm；m_uncondensed+=(1-eta)*dm；m_initial=m_remaining+m_condensate+m_uncondensed。","速率与效率均为宿主显式经验输入，未从温度、压力、转速或厂家最大功率推断；体积无密度不能计算。"],"parameters":{"configured_charge_mass":{"value":null,"unit":"kg","evidence":"unknown","meaning_zh":"类型合同无实例装料值；由受信任宿主显式提供。"},"configured_empirical_rate":{"value":null,"unit":"kg/s","evidence":"unknown","meaning_zh":"无默认蒸发率；宿主必须给出数值和证据，运行配置属于engineering_assumption。"},"configured_condensation_efficiency":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"无默认效率；宿主必须给出0–1系数和证据。"},"vapor_pressure_curve":{"value":null,"unit":"Pa","evidence":"unknown","meaning_zh":"溶剂蒸气压随温度关系未指定。"},"latent_heat":{"value":null,"unit":"J/kg","evidence":"unknown","meaning_zh":"潜热未知。"},"fluid_density":{"value":null,"unit":"kg/m^3","evidence":"unknown","meaning_zh":"密度未知；冷凝体积始终null。"},"heat_transfer_coefficient":{"value":null,"unit":"W/(m^2*K)","evidence":"unknown","meaning_zh":"热/质传递系数未知。"},"bumping_model":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"暴沸模型未实现。"},"condenser_efficiency":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"冷凝效率未知。"}}}},"limitations":["full表示本次明确标准配置的功能组件登记；没有把厂商全部模式、选件、机器人或真实硬件写成已实现。","500×430×440mm是W×H×D非玻璃本体名义尺寸；轴顺序转换为XYZ=500×440×430mm。装配玻璃最高实物包络仍未知null，模型求值包络仅engineering_assumption。","32.36kg只记整机一次；所有部件质量、惯量、真实壁厚和摩擦未知null。URDF只有根link采用整机均匀包围盒惯性近似，不能用作已校准接触动力学。","URDF关节力和速度中为解析器提供的有限占位数若存在，仅engineering_assumption；实际升降力/速度和转矩仍null。","升降、旋转和浴温为独立简化过程；宿主配置和step控制时间，read与invoke不隐式推进世界。","室温由宿主环境定义；浴温范围仅至180°C，不同浴液的实际安全温度范围、热容和热损失需另有资料，模型未声称安全验证。","真空明确依赖外部instrument.vacuubrand_pc3001_vario_select；没有在RV10内部复制泵，外部压力不是本设备自主抽气预测。","仅提供宿主显式配置的经验恒速蒸发质量账本，速率与效率无默认值；缺配置质量null。没有蒸气压、传热传质、潜热耦合或暴沸模型，体积始终null。","外部压力是快照，旧值随宿主时钟标stale；RV10不推进外部泵，也不按压力大小或陈旧性校正经验蒸发率。","厂家计时/间歇/换向等完整模式只按运行层实际接口登记；未实现部分为declared/unsupported或明确缺口。","玻璃内部、真空密封件和软管按可见结构近似；真实容积、壁厚与气路压力损失未校准。","模型接口身份过滤覆盖运行返回；同一Python进程及本地文件访问不是部署级安全隔离。","GLB保持本任务+Z向上，是导出姿态快照；后续宿主交互使用Blender场景适配器。","碰撞体仅盒、柱、球；碰撞接触动力学、机器人执行、真实硬件连接和实验效果验证均not_run。","scripts/basic40_runtime_vacuum.py和tests/test_basic40_vacuum.py是并发追加共享文件，整文件sha256设为null；RV10专属定义摘要与入口可调用检查记在chemistry_lab.shared_append_only_sources，其他不可变交付物保留完整哈希。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["lift.set_position","power.set","rotation.set_speed","rotation.start","rotation.stop","thermal.set_temperature","thermal.start","thermal.stop"],"unsupported":["timer.set_duration","vacuum.set_pressure"],"note_zh":"桥接 basic40_runtime_vacuum.RV10Host（推进方式 step_dt），26 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（2 个按键（碰到即触发）、1 个旋钮（可转动）、2 个门/盖/阀等被动关节）；1 个门/盖/升降关节与运行层双向同步，1 个关节跟随运行层状态；接口点 2 个（磨口/挂接、放置面）；布局：台面、两人搬、正面 −y、前方留空 0.25 m；面板读数 rpm(3)、bath(3)"}},"previews":["previews/ika_rv10_digital_v/preview.webp","previews/ika_rv10_digital_v/preview_left.webp","previews/ika_rv10_digital_v/preview_raised.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t2_vacuum/ika_rv10/asset.contract.json","byte