; T is a dimensionless ratio","Background(sigma_i)=1 for 512 points; acquisition establishes a logical readiness gate","OPD_j=(j-128)/(2*stop), j=0..256; OPD in m","I(OPD_j)=sum(T(sigma_i)*cos(2*pi*sigma_i*OPD_j))/512; synthetic forward cosine sum, not FFT of measured interferograms"],"parameters":{"wavenumber_min_m_inv":{"value":35000,"unit":"m^-1","evidence":"documented","meaning_zh":"运行元数据参数：wavenumber_min_m_inv"},"wavenumber_max_m_inv":{"value":780000,"unit":"m^-1","evidence":"documented","meaning_zh":"运行元数据参数：wavenumber_max_m_inv"},"highest_resolution_m_inv":{"value":40,"unit":"m^-1","evidence":"documented","meaning_zh":"运行元数据参数：0.4 cm^-1 highest resolution; setpoint validation only, not a lineshape model"},"signal_to_noise_ratio":{"value":35000,"unit":"1","evidence":"documented","meaning_zh":"运行元数据参数：Conditional vendor specification; source conditions must be preserved, not simulated noise"},"optional_fast_scan_frequency_hz":{"value":10,"unit":"Hz","evidence":"documented","meaning_zh":"运行元数据参数：Optional fast scan at 16 cm^-1 = 1600 m^-1; unsupported by runtime"},"measurement_duration_s":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"运行元数据参数：measurement_duration_s"},"sample_path_length_m":{"value":null,"unit":"m","evidence":"unknown","meaning_zh":"运行元数据参数：sample_path_length_m"},"atr_penetration_depth_m":{"value":null,"unit":"m","evidence":"unknown","meaning_zh":"运行元数据参数：atr_penetration_depth_m"},"maximum_lid_angle_rad":{"value":1.5707963267948966,"unit":"rad","evidence":"assumption","meaning_zh":"运行元数据参数：maximum_lid_angle_rad"},"loading_clearance_rad":{"value":1.0471975511965976,"unit":"rad","evidence":"assumption","meaning_zh":"运行元数据参数：loading_clearance_rad"},"lid_closed_tolerance_rad":{"value":1e-06,"unit":"rad","evidence":"assumption","meaning_zh":"运行元数据参数：lid_closed_tolerance_rad"},"scan_count_limit":{"value":1024,"unit":"1","evidence":"assumption","meaning_zh":"运行元数据参数：Software input bound, not a vendor limit; no scan averaging model"},"synthet