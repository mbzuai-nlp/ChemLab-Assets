Hz","evidence":"documented","meaning_zh":"Classic整机半高线宽严格小于0.4Hz；不用于生成合成T2。"},"tail_linewidth_specification_hz":{"value":16,"unit":"Hz","evidence":"documented","meaning_zh":"Classic整机0.55%峰高线宽严格小于16Hz；不作为合成响应参数。"},"sensitivity_ratio_lower_bound":{"value":200,"unit":"1","evidence":"documented","meaning_zh":"整机双通道1H灵敏度>200:1，条件1%乙苯；未实现噪声与灵敏度验证。"},"max_points":{"value":512,"unit":"1","evidence":"assumption","meaning_zh":"engineering_assumption：本Python DFT计算资源上限，不是厂商规格。"},"manufacturer_pulse_duration_s":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"清单未提供真实响应证据；保持null。"},"manufacturer_t1_s":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"清单未提供真实响应证据；保持null。"},"manufacturer_t2_s":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"清单未提供真实响应证据；保持null。"},"noise_amplitude":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"清单未提供真实响应证据；保持null。"},"calibration_accuracy_hz":{"value":null,"unit":"Hz","evidence":"unknown","meaning_zh":"清单未提供真实响应证据；保持null。"},"fault_probability":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"清单未提供真实响应证据；保持null。"}}},"host_timed_scanning":{"meaning_zh":"engineering_assumption：由共享宿主绝对时钟推进离散完整扫描。","implementation":"numerical","equations":["cycle=T_relax+T_acq; completed_scans=min(scans,floor((host_time-start_time)/cycle)); progress=min(1,elapsed/(scans*cycle))"],"parameters":{}}},"limitations":["所有FID、1D频谱与数值积分均为synthetic；工程假设教学模型不能声称复现Spinsolve响应、Classic线宽、灵敏度或真实测量。","只实现1H/13C单脉冲1D、宿主显式扫描计时与无噪声平均；2D、耦合多重峰自动求解、解耦、梯度、结构约束、定量核磁、真实校准与故障概率未实现。","每扫描耗时=用户弛豫延迟+用户采集时间；不模拟T1饱和恢复、脉冲时宽、接收器死区、磁场漂移或厂商固件。","幅度任意且无量纲，积分单位Hz；积分不是浓度或核数。13C载频未知，不输出ppm横轴。","样品槽仅逻辑关联；插入占比为示意映射，不执行机器人插入、接触或真实磁场作用。","注册样品、共同绝对时钟由可信宿主管理；公开session过滤是API边界，不是同进程Python或文件系统沙箱。请求幂等缓存仅在内存中。","可选scene_adapter失败时过程不提交；外部场景可能已部分修改，需宿主协调恢复。","coverage=full仅表示本批手动进样配置的功能组件登记完整；不表示所有表列实验、输出、真实物理或硬件能力已完成。","灰色椭圆筒外形和部件位置依据资料作视觉近似；机体轴向[X,Y,Z]=[0.58, 0.4, 0.43] m是明确假设，源表只给原次序58×43×40cm。","原点位于台面投影中心、Z向上；未将模型坐标约定写成厂商长宽高证据。","根部集中惯量是包围盒近似；部件质量与真实惯量为null。URDF仅盒/柱/球碰撞代理，存在文件不代表已做接触、稳定性或碰撞求解验证。","磁体内部、磁场分布、杂散场与真实安全半径未建模；不得由本几何模型推断真实仪器安全边界。","主机没有新增实体屏幕；display.text与acquisition.progress仅作外部host可读属性。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["acquisition.configure","acquisition.start","acquisition.stop","nmr.integrate","nmr.read_fid","nmr.read_spectrum","power.set","sample.insert","sample.remove"],"unsupported":[],"note_zh":"桥接 basic40_runtime_measure.MagritekSpinsolve80Runtime（推进方式 host_step_abs），24 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（1 个门/盖/阀等被动关节）；1 个关节跟随运行层状态；接口点 1 个（孔位）；布局：台面、两人搬、正面 −y、前方留空 0.25 m；面板为菜单/文字屏（待办）"}},"previews":["previews/magritek_spinsolve80/preview_assembled.webp","previews/magritek_spinsolve80/preview_rear.webp","previews/magritek_spinsolve80/preview_sample_raised.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t4_measure/magritek_spinsolve80/asset.contract.json","bytes":226489},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t4_measure/magritek_spinsolve80/collision_proxies.json","bytes":13691},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t4_measure/magritek_spinsolve80/geometry_manifest.json","bytes":28468},{"name":"model.blend","path":"assets/basic40_batch02/t4_measure/magritek_spinsolve80/model.blend","bytes":420957},{"name":"model.glb","path":"assets/basic40_batch02/t4_measure/magritek_spinsolve80/model.glb","bytes":1122216},{"name":"model.urdf","path":"assets/basic40_batch02/t4_measure/magritek_spinsolve80/model.urdf","bytes":14109},{"name":"scene_adapter.py","path":"assets/basic40_batch02/t4_measure/magritek_spinsolve80/scene_adapter.py","bytes":3488}],"completeness":{"components":13,"with_collisions":8,"with_objects":13,"with_function":13,"with_mass":0,"joints_matching_component":1,"joints":1,"has_contract":true,"has_layout":true,"has_glb":true,"checks_present":["articulation_check","coverage","validation_summary","contract_validation"]},"slug":"magritek_spinsolve80","chem_id":"CHEM-068","nam