etry.configure"},"settings.stirring_level":{"meaning_zh":"搅拌档位−15至+15；无数值转速转换","unit":"1","access":"read_write","origin":"setpoint","component_ids":["stirrer"],"write_via":"coulometry.configure"},"settings.sample_mass_kg":{"meaning_zh":"用户显式输入样品质量，未知时null","unit":"kg","access":"read_write","origin":"setpoint","component_ids":["display"],"write_via":"coulometry.configure"},"settings.endpoint_hold_s":{"meaning_zh":"理想耗尽后的保持时间，必须显式配置，不推断厂家默认","unit":"s","access":"read_write","origin":"setpoint","component_ids":["display"],"write_via":"coulometry.configure"},"slot.cell.installed":{"meaning_zh":"卡尔费休滴定池已安装；宿主逻辑状态和位姿/显隐映射","unit":"1","access":"read_write","origin":"scene","component_ids":["cell"],"write_via":"slot.set_installed"},"slot.generator.installed":{"meaning_zh":"无隔膜发生电极（配置补充假设）已安装；宿主逻辑状态和位姿/显隐映射","unit":"1","access":"read_write","origin":"scene","component_ids":["generator"],"write_via":"slot.set_installed"},"slot.indicator.installed":{"meaning_zh":"指示电极已安装；宿主逻辑状态和位姿/显隐映射","unit":"1","access":"read_write","origin":"scene","component_ids":["indicator"],"write_via":"slot.set_installed"}},"mechanisms":{"coulometric_water":{"meaning_zh":"engineering_assumption：两电子法库仑计量和漂移补偿。萃取阶段仅累积漂移，滴定阶段累计电荷，耗尽后用理想占空比抵消漂移并保持；不是厂商固件或真实试剂动力学。","implementation":"lumped","equations":["Q = integral(I_effective dt)","m_generated = Q*M_H2O/(2*F)","m_indicated=max(0,m_generated-drift_compensation_kg_s*elapsed_s)","water_fraction=m_indicated/sample_mass_kg (null when sample_mass_kg unknown)"],"parameters":{"current_choices_a":{"value":[0.1,0.2,0.4],"unit":"A","evidence":"documented","meaning_zh":"CHEM-102 参数与来源第107行；自动电流策略未实现"},"initial_current_a":{"value":0.1,"unit":"A","evidence":"assumption","meaning_zh":"合成初始设定，不宣称厂家默认"},"initial_extraction_time_s":{"value":0.0,"unit":"s","evidence":"assumption","meaning_zh":"合成初始设定；合法范围 0–999999 s"},"start_drift_default_kg_s":{"value":3.333333333333333e-10,"unit":"kg/s","evidence":"documented","meaning_zh":"CHEM-102 参数与来源第107行；20 µg/min"},"faraday_c_mol":{"value":96485.33212331001,"unit":"C/mol","evidence":"assumption","meaning_zh":"理想两电子库仑换算参数；不是厂家整机或部件测量"},"water_molar_mass_kg_mol":{"value":0.01801528,"unit":"kg/mol","evidence":"assumption","meaning_zh":"约定水摩尔质量用于合成化学计量"},"electrode_response_s":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"缺实测响应"},"current_efficiency":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"未知真实电流效率；模型明确使用理想100%假设"},"endpoint_hold_s":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"由仿真任务显式配置，不套用厂家终点默认"},"cell_capacity_m3":{"value":null,"unit":"m3","evidence":"unknown","meaning_zh":"不得从照片推断容量"},"modeled_current_efficiency":{"value":1,"unit":"1","evidence":"assumption","meaning_zh":"模型假设100%电流效率；真实电流效率仍为null。"},"documented_start_drift_range":{"value":[1.6666666666666667e-11,1.665e-08],"unit":"kg/s","evidence":"documented","meaning_zh":"清单启动漂移1–999 µg/min，统一换算SI。"},"documented_extraction_time_range":{"value":[0,999999],"unit":"s","evidence":"documented","meaning_zh":"清单萃取时间范围；未借此定义真实萃取速率。"},"documented_generation_rate_range":{"value":[2.5e-11,3.7349999999999994e-08],"unit":"kg/s","evidence":"documented","meaning_zh":"清单最大生成速率1.5–2241.0 µg/min的SI表示；只登记规格，不用该范围拟合未知自动电流算法。"},"documented_stirring_level_range":{"value":[-15,15],"unit":"1","evidence":"documented","meaning_zh":"清单搅拌档位范围；不是rad/s。"},"documented_default_stirring_level":{"value":8,"unit":"1","evidence":"documented","meaning_zh":"清单默认8档；运行初始设定使用同一档位。"},"documented_approx_speed_at_default_level":{"value":104.71975511965977,"unit":"rad/s","evidence":"documented","meaning_zh":"清单默认8档约1000 rpm的SI换算；不是所有档位通用转速映射，过程不使用该转速。"}}}},"limitations":["本次覆盖CHEM-102指定Metrohm 899配置及11个功能组件；full不代表所有厂家功能、硬件、机器人或真实动力学已实现。","滴定池、电极、干燥管、加样口与局部外形是手册图photo_estimate；完整安装高度没有厂家核实尺寸。","厂家195 mm指含支架高度；完整玻璃池与电极模型可高于该值。","2.8 kg是整机含电源质量；部件质量、真实惯量、摩擦、恢复系数、未记载材料参数及滴定池容量保持null。仅壳体PBT和底座1.4301材料分区另有手册证据。","聚合惯量用额定含支架包围盒0.1435×0.2815×0.195 m和含电源质量作engineering_assumption；不使用玻璃装配总高，不分配成未知部件惯量。","碰撞体仅使用盒、圆柱、球；未运行接触、稳定性、插拔力或刚体求解验证。","转速档位默认8约1000 rpm只是清单规格；未据此构造其余档位转速映射。","真实样本响应、噪声、校准曲线、准确度、故障概率、自动发生电流策略和电极电位终点均未实现。","固体/气体转移附件及外部电源未单独建模；外部真实服务需进一步集成。","All results synthetic; ideal stoichiometry, 100% modeled current efficiency and ideal depletion endpoint are engineering_assumption.","Manual 100/200/400 mA only; automatic current firmware, reagent chemistry, electrode potential endpoint, noise, accuracy, hardware and robots not implemented.","Stirring level is a setting only; no hydrodynamics or invented speed map. Cell capacity and component parameters stay null.","API truth filtering is not a Python/filesystem sandbox. Keep trusted host and sample fixtures in a separate process for untrusted agents.","Optional scene callback must be synchronous and atomic; callback tests do not prove evaluated Blender pose or contact physics.","Floating-point overflow is rejected before state/time mutation; excessively large requested steps may be conservatively rejected before endpoint clipping.","Failed scene callback outcomes are cached by logical request ID; retry does not replay the callback. A new request after reconciliation is explicit host/operator action.","Host step commits process/time together, but callbacks across scene instances are not transactional. A later callback failure can leave earlier scene instances changed; host must reconcile every affected scene instance.","Positive host increments and nonzero acquisition intervals that cannot be represented at the current floating-point time are rejected before callbacks or process mutation.","Slot installation/removal is a powered-off, idle scene configuration with cell-before-electrode dependencies. It does not simulate handling force, reagent spills, physical transfers or sample-container identity changes.","GLB按用户要求保留原始+Z向上坐标（export_yup=false），常规glTF加载器默认+Y向上；Blender导入后需对根施加X=-pi/2的逆坐标转换。geometry_validation已验证转换后的网格，消费端须遵守geometry_manifest坐标声明。","URDF固定于world；只有body含整机聚合惯量。子件质量未知未填，槽位effort=velocity=0是明确禁用电动驱动而非估计额定值；不得按当前URDF直接声称动态接触或子件动力学已有效。","无隔膜发生电极为依据手册默认分支作出的配置补充假设；清单没有规定有/无隔膜。吸附干燥管装配于发生电极上部，加样口属于滴定池。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["coulometry.configure","coulometry.curve","coulometry.reading","coulometry.start","coulometry.stop","power.set","slot.set_installed"],"unsupported":[],"note_zh":"桥接 basic40_runtime_measure.Metrohm899Host（推进方式 step_dt），26 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（8 个按键（碰到即触发）、3 个门/盖/阀等被动关节）；接口点 1 个（放置面）；布局：台面、单人可搬、正面 −y、前方留空 0.25 m；面板为菜单/文字屏（待办）"}},"previews":["previews/metrohm_899/preview.webp","previews/metrohm_899/preview_rear.webp"],"files":[{"name":"USAGE.md","path":"assets/basic40_batch02/t4_measure/metrohm_899/USAGE.md","bytes":2610},{"name":"asset.contract.json","path":"assets/basic40_batch02/t4_measure/metrohm_899/asset.contract.json","bytes":331703},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t4_measure/metrohm_899/collision_proxies.json","bytes":15866},{"name":"geometry_manifest.json","path":"assets/basic40_batch02/t4_measure/metrohm_899/geometry_manifest.json","bytes":31136},{"name":"model.blend","path":"assets/basic40_batch02/t4_measure/metrohm_899/model.blend","bytes":161936},{"name":"model.glb","path":"assets/basic40_batch02/t4_measure/metrohm_899/model.glb","bytes":1096684},{"name":"model.urdf","path":"assets/basic40_batch02/t4_measure/metrohm_899/model.urdf","bytes":15463},{"name":"scene_adapter.py","path":"assets/basic40_batch02/t4_measure/metrohm_899/scene_adapter.py","bytes":2754}],"completeness":{"components":11,"with_collisions":11,"with_objects":11,"with_function":11,"with_mass":0,"joints_matching_component":3,"joints":11,"has_contract":true,"has_layout":true,"has_glb":true,"checks_present":["articulation_check","coverage","contract_validation","runtime_validation","scene_validation"]},"slug":"metrohm_899","chem_id":"CHEM-102","name_en":"Karl Fischer coulometer","maker":"Metrohm","model":"899 Coulometer","domain":"electrochem","domain_name":"Electrochemistry & Titration","path":"assets/basic