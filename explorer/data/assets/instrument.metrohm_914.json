,"component_ids":["probe_do"],"write_via":null},"calibration.do.offset":{"meaning_zh":"运行层状态 calibration.do.offset；观测均属 synthetic。","unit":"kg/m3","access":"read_only","origin":"process_truth","component_ids":["probe_do"],"write_via":null},"truth.ph":{"meaning_zh":"运行层状态 truth.ph；观测均属 synthetic。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null},"truth.conductance_s":{"meaning_zh":"运行层状态 truth.conductance_s；观测均属 synthetic。","unit":"S","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null},"truth.do_kg_m3":{"meaning_zh":"运行层状态 truth.do_kg_m3；观测均属 synthetic。","unit":"kg/m3","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null},"truth.temperature_k":{"meaning_zh":"运行层状态 truth.temperature_k；观测均属 synthetic。","unit":"K","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null},"truth.reference_ph":{"meaning_zh":"运行层状态 truth.reference_ph；观测均属 synthetic。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null},"truth.reference_potential_v":{"meaning_zh":"运行层状态 truth.reference_potential_v；观测均属 synthetic。","unit":"V","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null},"truth.conductance_temp_coefficient_k_inv":{"meaning_zh":"运行层状态 truth.conductance_temp_coefficient_k_inv；观测均属 synthetic。","unit":"1/K","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null},"truth.conductance_reference_temperature_k":{"meaning_zh":"运行层状态 truth.conductance_reference_temperature_k；观测均属 synthetic。","unit":"K","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null},"truth.standard_ph":{"meaning_zh":"运行层状态 truth.standard_ph；观测均属 synthetic。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null},"truth.standard_conductance_s":{"meaning_zh":"运行层状态 truth.standard_conductance_s；观测均属 synthetic。","unit":"S","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null},"truth.standard_do_kg_m3":{"meaning_zh":"运行层状态 truth.standard_do_kg_m3；观测均属 synthetic。","unit":"kg/m3","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null},"truth.standard_slot":{"meaning_zh":"运行层状态 truth.standard_slot；观测均属 synthetic。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["meter_assembly"],"write_via":null}},"mechanisms":{"electrochemistry":{"meaning_zh":"engineering_assumption：按可换探头提供 synthetic pH/Nernst 电位、电导与溶氧读数、标准液校准、温补和终点状态。未知电极参数必须由受信任宿主明确提供。","implementation":"lumped","equations":["pH = -log10(a_H+)；Nernst 简化 E = E_ref - (ln(10) R T / F) (pH - pH_ref)，E_ref 与 pH_ref 均无默认实机数值。","单位关系说明（本版未实现电导率输出）：电导 G 的公共单位为 S；电导率 kappa = K_cell G (S/m)，其中 K_cell 单位 m^-1；当前池常数为 null，不把 G 当作 kappa。","50 mg/L = 0.05 kg/m^3；mg/L 至 kg/m^3 乘 0.001。"],"parameters":{"ph_range":{"value":[-13,20],"unit":"1","evidence":"documented","meaning_zh":"CHEM-005 参数与来源 row10"},"ph_resolution":{"value":0.001,"unit":"1","evidence":"documented","meaning_zh":"仅用于显示量化，不是噪声或准确度"},"ph_instrument_accuracy":{"value":0.003,"unit":"1","evidence":"documented","meaning_zh":"仪表±0.003、不含探头误差；未用作仿真精度"},"conductance_range":{"value":[1e-07,0.5],"unit":"S","evidence":"documented","meaning_zh":"0.1µS..500mS，是电导而非电导率"},"do_range":{"value":[0,0.05],"unit":"kg/m3","evidence":"documented","meaning_zh":"0..50mg/L按SI换算"},"record_base_interval_s":{"value":1,"unit":"s","evidence":"documented","meaning_zh":"CHEM-005 数据间隔1s"},"nernst_model":{"value":"E=E_ref-ln(10)*R*T/F*(pH-pH_ref); pH_display=pH_ref+(E_ref-E)/(ln(10)*R*T_comp/F)","unit":"1","evidence":"assumption","meaning_zh":"理想Nernst响应，R=8.31446261815324 J/(mol K)，F=96485.33212331001 C/mol；参考点和温度必须宿主显式提供"},"endpoint_model":{"value":"max(window)-min(window)<=tolerance_fraction*(channel_max-channel_min)","unit":"1","evidence":"assumption","meaning_zh":"窗口hold与容差初始null；以宿主给定样本零阶保持，每个实际样本才更新，不推断厂家终点算法"},"calibration_model":{"value":"corrected=raw+(standard-raw_at_calibration)","unit":"1","evidence":"assumption","meaning_zh":"单点合成偏置，仅当前安装探头；更换使校准失效"},"conductance_temperature_model":{"value":"G_ref=G/[1+alpha*(T_comp-T_ref)]","unit":"1","evidence":"assumption","meaning_zh":"仅当宿主明确给出alpha和T_ref才启用；否则报告原始电导且不声称完成电导温补"},"cell_constant_m_inv":{"value":null,"unit":"1/m","evidence":"unknown","meaning_zh":"表未给出；不默认生成数值或用整机参数代替"},"contamination_coefficient":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"表未给出；不默认生成数值或用整机参数代替"},"drift_rate":{"value":null,"unit":"1/s","evidence":"unknown","meaning_zh":"表未给出；不默认生成数值或用整机参数代替"},"probe_mass_kg":{"value":null,"unit":"kg","evidence":"unknown","meaning_zh":"表未给出；不默认生成数值或用整机参数代替"},"do_temperature_coefficient":{"value":null,"unit":"1/K","evidence":"unknown","meaning_zh":"表未给出；不默认生成数值或用整机参数代替"},"reference_potential_v":{"value":null,"unit":"V","evidence":"unknown","meaning_zh":"表未给出；不默认生成数值或用整机参数代替"},"reference_ph":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"表未给出；不默认生成数值或用整机参数代替"},"endpoint_hold_s":{"value":null,"unit":"s","evidence":"unknown","meaning_zh":"表未给出；不默认生成数值或用整机参数代替"},"endpoint_tolerance_fraction":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"表未给出；不默认生成数值或用整机参数代替"},"conductance_temperature_coefficient":{"value":null,"unit":"1/K","evidence":"unknown","meaning_zh":"表未给出；不默认生成数值或用整机参数代替"}}}},"limitations":["All measurement outputs are synthetic and estimated; accuracy ±0.003 is an instrument specification, not simulated accuracy.","pH and DO share one digital interface and cannot both be installed; conductance is an independent analog interface. Runtime selects one channel at a time; parallel acquisition is not implemented.","No default cell constant, contamination/drift/noise or probe mass is invented. Conductance is S, not S/m; DO is kg/m3.","Nernst, optional linear conductance compensation, single-point calibration and stability rules are engineering_assumption; DO temperature/pressure/salinity compensation is absent.","Readings need explicit host samples; automatic temperature needs explicit host temperature. Missing values stay null. No intermediate samples are fabricated.","Scene adapter receives only display/power/probe installation state; no robot, contact solver or hardware driver. A failing callback may partly modify the scene but leaves a command's process candidate uncommitted.","Host-supplied principals enforce API visibility only. Python/process/filesystem sandbox isolation is not implemented.","Request deduplication is in-memory and does not survive restart.","本体尺寸和质量有文献，局部外形、接口位置、探头几何与示教行程是 engineering_assumption；不宣称制造商 CAD 精度。","仅根 meter_assembly 使用整机 0.4 kg 与均匀包围盒惯量近似；探头等所有零件质量、实际质心和惯量均未知，没有分摊。","URDF 碰撞限盒、柱、球基元，固定关节保存初始分解摆放 q=0.04 m 快照；交互装配关节由 Blender 场景提供。未知探头/附件惯性数据不能由 URDF 消费者视为已知；本次未证明机器人抓取、插拔、接触力、摩擦或自由体稳定。","pH ±0.003 是整机且不含探头误差；不赋给 probe_ph，不保证 synthetic 模型达到该准确度。","真值隔离只对应实现并测试的会话 API 边界；共享文件系统、进程沙箱与外部部署安全隔离未验证。","硬件、机器人及物理接触求解验证均为 not_run；未有证据的场景能力不得标为 verified。","宿主可用host_step_template以公开标准生成样本：NIST pH(S)(T)、KCl电导率κ(T)、Benson–Krause溶解氧及共享pKa表理想电荷平衡pH；校准须使用证书值。legacy显式样本路径不变。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["acquisition.records","acquisition.set_interval","acquisition.start","acquisition.stop","electrochemistry.calibrate","electrochemistry.configure_endpoint","electrochemistry.configure_temperature","electrochemistry.reading","electrochemistry.select_probe","power.set","probe.set_installed"],"unsupported":[],"note_zh":"桥接 basic40_runtime_measure.Metrohm914Runtime（推进方式 host_step_abs），44 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（3 个按键（碰到即触发））；接口点 0 个（无）；布局：台面、单人可搬、正面 −y、前方留空 0.25 m；面板为菜单/文字屏（待办）"}},"previews":["previews/metrohm_914/preview.webp","previews/metrohm_914/preview_detail.webp","previews/metrohm_914/preview_front.webp","previews/metrohm_91