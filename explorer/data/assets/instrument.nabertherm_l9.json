ontroller","display"],"write_via":null}},"mechanisms":{"empty_chamber_thermal":{"meaning_zh":"集中参数空炉热响应和单槽最多4段温程；不包含固相反应或样品热传递。","implementation":"lumped","equations":["C*dT/dt=P−UA*(T−Ta)，闭门UA=2W/K，开门UA再加18W/K且P=0。","C=−UA*4500/log(1−UA*(1273.15−298.15)/3400)=10560.75403548834J/K；UA和初温为假设。","每个热步使用线性热模型指数解；达到目标后理想控温钳位，功率为额定电功率的等效热输入假设。","程序目标按给定K/s斜率移动；实际炉温由功率和散热限制，距段目标<=0.5K后累计hold_s。","程序step细分<=1s；开门暂停程序、关门恢复；完成/停止后目标退回环境，不瞬间冷却。","可见温度=round(T−273.15,1)+273.15K；heater.enabled表示加热许可，不是瞬时duty。"],"parameters":{"heater_power_w":{"value":3400.0,"unit":"W","evidence":"assumption","meaning_zh":"2021目录第19页整机connected load为3.4kW，230V 1/N/PE；模型以该值作为最大等效热输入并随热容共同拟合，不是独立测得的加热器功率。"},"maximum_temperature_k":{"value":1373.15,"unit":"K","evidence":"documented","meaning_zh":"厂家最高1100°C。"},"long_hold_recommended_temperature_k":{"value":1273.15,"unit":"K","evidence":"documented","meaning_zh":"厂家长保温建议1000°C；建议值不同于最高温度，不硬编码成硬件互锁。"},"reference_heatup_s":{"value":4500.0,"unit":"s","evidence":"documented","meaning_zh":"空炉闭门、230V到Tmax−100K约75min；目录未说明初温。"},"calibration_ambient_k":{"value":298.15,"unit":"K","evidence":"assumption","meaning_zh":"反推热容时假定初始和环境温度25°C。"},"heat_loss_w_k":{"value":2.0,"unit":"W/K","evidence":"assumption","meaning_zh":"闭门有效线性散热UA；一条升温点不足以同时识别C与UA。"},"thermal_capacity_j_k":{"value":10560.75403548834,"unit":"J/K","evidence":"assumption","meaning_zh":"C=-UA*t/log(1-UA*(Tref-Ta)/P)，由75min空炉点在明确UA、环境假设下反推；50kg整机质量未参与。"},"door_open_loss_w_k":{"value":18.0,"unit":"W/K","evidence":"assumption","meaning_zh":"开门额外线性散热；仅用于仿真响应。"},"maximum_door_angle_rad":{"value":1.5707963267948966,"unit":"rad","evidence":"assumption","meaning_zh":"场景向下翻门+X轴0..90°，未测厂家关节极限。"},"door_open_heater_fraction":{"value":0.0,"unit":"1","evidence":"documented","meaning_zh":"M01.1060 Rev2022-12 §6.6第54页：开门中断加热、关门自动恢复，LE例外不适用L...SKM；实现手册支持的门互锁行为，未作实机验证。"},"program_maximum_segments":{"value":4,"unit":"1","evidence":"documented","meaning_zh":"B410每程序4段；只模拟一个程序，不实现五槽存储。"},"program_maximum_ramp_rate_k_s":{"value":1.0,"unit":"K/s","evidence":"assumption","meaning_zh":"目标斜率允许0.001..1K/s；真实升温仍受3400W和散热限制。"},"program_hold_tolerance_k":{"value":0.5,"unit":"K","evidence":"assumption","meaning_zh":"实际模型温度距段目标<=0.5K才累加保温；不声称厂家温控精度。"},"program_integration_maximum_s":{"value":1.0,"unit":"s","evidence":"assumption","meaning_zh":"温程状态机最大积分步长；转换时间分辨率<=1s。"}}}},"limitations":["full表示全部本次配置功能组件已登记，不表示厂家全部模式、程序存储、机器人或真实硬件已实现。","固定采用用户指定目录版3.4kW，不混用新版3.7kW；所有公共温度单位K，显示层明确转换为°C。","局部几何尺寸、材料外观及90°门行程是重建估计；不是厂家CAD或尺寸公差验证。","50kg只用于整机属性；部件质量/惯量/摩擦未知为null。整机包围盒惯量为assumption，仅URDF base_link登记整机集中近似；分件子链接省略未知惯性。","集中参数空炉热模型依据75min升至1000°C校准；单升温点不能同时识别热容和散热，负载热容、炉膛非均匀温场与辐射未独立求解。","程序为本项目单槽最多4段简化温程；不表示实现B410全部5个程序存储、完整固件、报警或控制精度。","坩埚内固体样品是宿主放置输入；未实现固相反应、灰化产物、催化材料品质或质量变化。","保护气接口为厂家选配且不使炉膛气密；本资产未加装保护气设备，不实现气氛输运或气密性判定。","门上可调进气口仅作静态结构，未实现滑片开度操作或定量进排气流量模型。","宿主step统一推进时间；set_temperature仅写目标，read不推进时间；过程真值仅debug/evaluator可见。","API可见性过滤不构成共享Python进程或工作区文件的安全隔离；不能把真实状态文件开放给不可信代理。","GLB与OBJ是导出快照；动态文字和门同步的权威目标在原生Blender文件与适配器中。","仅提供盒、柱、球基元碰撞代理；接触动力学、机器人抓放、轨迹规划和真实硬件验证均not_run。","URDF门关节effort=0、velocity=0为运动学占位，不是厂家扭矩或速度，不能将本资产称为已标定的关节动力学模型。"],"sources":[],"checks":{"coverage":{"status":"full","implemented":["power.set","thermal.set_temperature","door.open","door.close","thermal.configure_program","thermal.start_program","thermal.stop_program"],"unsupported":["thermal.program_library","atmosphere.control","sample.calcination"],"note_zh":"分段温程、门互锁全部搬入；1000 点对比真值差 ≤0.026 K，目标温度/保温计时差 ≤0.17（1 s 子步与 1/12 s 步长之别）；关节化 USD（6 个按键（碰到即触发）、1 个门/盖/阀等被动关节）；接口点 4 个（放置面）；布局：台面、两人搬、正面 −y、前方留空 0.25 m；面板读数 temp(4)"}},"previews":["previews/nabertherm_l9/preview_closed.webp","previews/nabertherm_l9/preview_open.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t1_thermal/nabertherm_l9/asset.contract.json","bytes":190276},{"name":"blender_adapter.py","path":"assets/basic40_batch02/t1_thermal/nabertherm_l9/blender_adapter.py","bytes":5065},{"name":"collision_proxies.json","path":"assets/basic4