ailability":"unsupported","component_ids":["detector"],"implementation":{"process":"absent","host":"absent","scene":"not_applicable","robot":"absent","hardware":"absent"},"input":[]},"xrd.refine":{"function_zh":"精修未实现；未建立结构因子、仪器展宽、择优取向与计数噪声模型。","kind":"analysis","availability":"unsupported","component_ids":["detector"],"implementation":{"process":"absent","host":"absent","scene":"not_applicable","robot":"absent","hardware":"absent"},"input":[]}},"state_slots":{"power.enabled":{"meaning_zh":"逻辑供电；非真实高压电源控制。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["housing"],"write_via":"power.set"},"access.door_angle_rad":{"meaning_zh":"门关节；0为关闭，π/2展示上限为engineering_assumption。","unit":"rad","access":"read_write","origin":"scene","component_ids":["door"],"write_via":"access.set_door_angle"},"slot.sample.connection_id":{"meaning_zh":"粉末平片或适配样品架的逻辑槽占用，不执行机器人插拔。","unit":"1","access":"read_write","origin":"scene","component_ids":["sample_holder"],"write_via":"slot.set_sample"},"cooling.connection_id":{"meaning_zh":"外置循环水依赖连接，只可由宿主登记。","unit":"1","access":"read_only","origin":"scene","component_ids":["cooling_ports"],"write_via":null},"cooling.ready":{"meaning_zh":"宿主明确提供的循环水就绪信号，未模拟水温/流量传感器。","unit":"1","access":"read_only","origin":"derived","component_ids":["cooling_ports"],"write_via":null},"xray.voltage_v":{"meaning_zh":"20–40kV，1kV步长，尚未设置时null。","unit":"V","access":"read_only","origin":"setpoint","component_ids":["xray_tube"],"write_via":null},"xray.current_a":{"meaning_zh":"2–15mA，1mA步长，尚未设置时null。","unit":"A","access":"read_only","origin":"setpoint","component_ids":["xray_tube"],"write_via":null},"xray.power_w":{"meaning_zh":"设定管压×管流；600W为整机管源最大输出约束。","unit":"W","access":"read_only","origin":"derived","component_ids":["xray_tube"],"write_via":null},"xray.active":{"meaning_zh":"仅扫描时为真的逻辑射线使能；不模拟辐射场或屏蔽性能。","unit":"1","access":"read_only","origin":"derived","component_ids":["xray_tube"],"write_via":null},"slit.configuration_id":{"meaning_zh":"显式方法狭缝标签；数值孔径未知，未计算其展宽效应。","unit":"1","access":"read_write","origin":"setpoint","component_ids":["slit_assembly"],"write_via":"xrd.set_slit"},"goniometer.two_theta_rad":{"meaning_zh":"2θ权威机械角，范围−3..145°、量化0.005°后以rad公开。","unit":"rad","access":"read_write","origin":"scene","component_ids":["goniometer"],"write_via":"motion.set_two_theta"},"goniometer.sample_theta_rad":{"meaning_zh":"θ=2θ/2是engineering_assumption的理想耦合展示。","unit":"rad","access":"read_only","origin":"derived","component_ids":["sample_holder"],"write_via":null},"scan.start_rad":{"meaning_zh":"用户配置扫描起点。","unit":"rad","access":"read_only","origin":"setpoint","component_ids":["goniometer"],"write_via":null},"scan.stop_rad":{"meaning_zh":"用户配置扫描终点。","unit":"rad","access":"read_only","origin":"setpoint","component_ids":["goniometer"],"write_via":null},"scan.step_rad":{"meaning_zh":"用户配置扫描步长。","unit":"rad","access":"read_only","origin":"setpoint","component_ids":["goniometer"],"write_via":null},"scan.integration_time_s":{"meaning_zh":"用户配置扫描显式积分时间，厂家范围未知。","unit":"s","access":"read_only","origin":"setpoint","component_ids":["goniometer"],"write_via":null},"scan.running":{"meaning_zh":"开始调用只置运行标志；采集仅在host_step推进。","unit":"1","access":"read_only","origin":"derived","component_ids":["detector"],"write_via":null},"scan.status":{"meaning_zh":"完成仅表示合成插值扫描已采集所有方法点。","unit":"1","access":"read_only","origin":"derived","component_ids":["detector"],"write_via":null},"scan.completed_points":{"meaning_zh":"已完成采集点数；未积分完的点不计入。","unit":"1","access":"read_only","origin":"derived","component_ids":["detector"],"write_via":null},"scan.total_points":{"meaning_zh":"配置方法的点数；未积分完的点不计入。","unit":"1","access":"read_only","origin":"derived","component_ids":["detector"],"write_via":null},"measurement.pattern":{"meaning_zh":"仅已完成积分点的synthetic曲线；逐点含rad、1/s、期望计数与窗口，不含晶体学真实性声明。","unit":"1","access":"read_only","origin":"derived","component_ids":["detector"],"write_via":null},"measurement.last_intensity_cps":{"meaning_zh":"最近完整积分窗口的synthetic平均计数率；没有数据时nul