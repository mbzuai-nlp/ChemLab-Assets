ustment":{"meaning_zh":"真空传感器调整：大气点（>700 mbar）增益与真空点（<20 mbar，0或0.1-20 mbar参考）零点，作用于显示读数（p.78-82）","unit":"1","access":"read_only","origin":"derived","component_ids":["controller"],"write_via":null},"sensor.error":{"meaning_zh":"评测者：传感器原始读数误差（相对增益、偏移），默认0","unit":"1","access":"read_only","origin":"derived","component_ids":["controller"],"write_via":null},"faults.list":{"meaning_zh":"故障指示：警告（黄，过程继续，排除后自动复位）与错误（红，过程停止，排除后须确认）（p.86-90）","unit":"1","access":"read_only","origin":"derived","component_ids":["display"],"write_via":null},"faults.injected":{"meaning_zh":"评测者：注入的故障原因，默认none","unit":"1","access":"read_only","origin":"derived","component_ids":["controller"],"write_via":null},"graph.log":{"meaning_zh":"压力曲线：应用启动后的[秒, Pa]读数（p.59）","unit":"1","access":"read_only","origin":"derived","component_ids":["display"],"write_via":null},"logger.state":{"meaning_zh":"数据记录器：已存记录数与过程文件数（p.83）","unit":"1","access":"read_only","origin":"derived","component_ids":["display"],"write_via":null},"service.hours_s":{"meaning_zh":"运行小时计数（泵运转时间）（p.84）","unit":"s","access":"read_only","origin":"derived","component_ids":["pump_module"],"write_via":null},"editor.draft":{"meaning_zh":"应用编辑器草稿：名称、描述、过程步骤（模板、新建、保存、另存为）（p.63-69）","unit":"1","access":"read_only","origin":"derived","component_ids":["display"],"write_via":null}},"mechanisms":{"vacuum_process":{"meaning_zh":"共用真空源对宿主显式连接的外部恒容、等温腔体执行工程抽空；本机没有内置虚拟待抽腔体。","implementation":"lumped","equations":["满抽速上限Q_full(P)=Qmax*max(0,1-Pultimate/P)，Qmax=2/3600 m^3/s；气镇关/开Pultimate=200/400 Pa。P<=Pultimate或停泵时Q=0，控制模式实际Q可低于上限。","L(P)=L0*(1-P/Pambient)；V*dP/dt=L(P)-Q(P)*P，按分段线性精确积分。","pressure_control有效目标=max(设定值,气镇极限)，仅在抽速足够时理想连续调速维持；pump_down使用气镇对应极限。","目标升高或开启气镇不主动升压；只有外部漏入能使低于有效目标的腔体回升。","守恒核对：P_final*V=P_initial*V+积分漏入(Pa*m^3)-积分抽出(Pa*m^3)。"],"parameters":{"maximum_pumping_speed_m3_s":{"value":0.0005555555555555556,"unit":"m^3/s","evidence":"documented","meaning_zh":"CHEM-188: 2 m3/h maximum pumping speed; actual inlet conditions, not standard flow"},"ultimate_pressure_pa":{"value":200.0,"unit":"Pa","evidence":"documented","meaning_zh":"CHEM-188: 2 mbar absolute, closed gas ballast"},"gas_ballast_ultimate_pressure_pa":{"value":400.0,"unit":"Pa","evidence":"documented","meaning_zh":"CHEM-188: 4 mbar absolute, open gas ballast"},"maximum_back_pressure_pa":{"value":110000.0,"unit":"Pa","evidence":"documented","meaning_zh":"CHEM-188: maximum absolute exhaust back pressure 1.1 bar"},"motor_power_w":{"value":160.0,"unit":"W","evidence":"documented","meaning_zh":"CHEM-188 motor rating; not consumed energy or gas heating in this solver"},"default_ambient_pressure_pa":{"value":101325.0,"unit":"Pa","evidence":"assumption","meaning_zh":"Synthetic host default, caller configurable"},"default_chamber_volume_m3":{"value":0.001,"unit":"m^3","evidence":"assumption","meaning_zh":"External 1 L test fixture; not an internal manufacturer volume"},"gas_ballast_open_angle_rad":{"value":1.5707963267948966,"unit":"rad","evidence":"assumption","meaning_zh":"Demonstration articulation: gas_ballast_joint rotation_euler.z"},"pressure_curve_measurements":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"No manufacturer curve points calibrated in runtime"},"cooling_water_range_m3_s":{"value":null,"unit":"m^3/s","evidence":"unknown","meaning_zh":"No calibrated water loop or process binding"}}}},"limitations":["full表示本次标准AK+EK配置功能组件登记：电源/数据/开关、泵、控制与内置压力传感器、气镇、AK/EK、EK被动压力释放阀、瓶、管路和支撑；内部子功能可聚合登记，不表示厂家全部模式、硬件或机器人已实现。","内置压力传感器的真实精度/响应未知，工程显示不是实测。EK压力释放阀仅聚合登记，内部几何未细化、开启阈值null、释放动作和安全功能未仿真或验证。","整机尺寸和质量有厂家与清单依据；部件尺寸与端口位置为照片辅助工程近似，部件质量、惯量、摩擦和实际壁厚均null。","URDF仅装配根有8.2kg和均匀整机包围盒惯性；这是assumption，子link无虚构质量，不能视为完整接触动力学模型。","气镇实物是手动黑帽；仿真API直接设定角度与过程状态，不声称有电动气镇、机器人旋转或真实控制。","气镇URDF effort=1N*m、velocity=1rad/s仅运动学解析器占位engineering_assumption；真实扭矩和操作速度null。","可选VENT通气阀未建模；未声明标配主动泄压硬件，漏入仅是宿主配置的环境边界。","冷却水控制仅declared/UNSUPPORTED，回收冷凝液为null；没有挥发物、冷凝效率、冷却水热交换或分析算法。","仅共享工程真空源与外腔体模型；压力相关抽速未拟合厂家曲线，未做气体组分或真实实验效果验证。","当前集中模型一源连接一个外部腔体、一个腔体只接一源；多消费者需宿主先合并等效体积和负载，无分支管路导通网络求解。","面向agent的过程真值过滤由运行接口执行；同进程或本地文件不是安全隔离边界。","碰撞基元可审查但接触动力学、机器人操作、真实硬件和厂家性能标定均not_run。","GLB以export_yup=False保留+Z向上和导出姿态；消费者必须保留此坐标基，不能按默认glTF的+Y上再转换。交互绑定以Blender原生对象为准。","需从抽空曲线拟合压力相关抽速、泄漏、溶剂负载和冷凝效率。","运行归属（负责人规则2026-10-19，仿真规则，真实仪器没有调用者概念）：过程（应用或CHEM-188泵运行）属于启动它的agent；运行中另一agent停止、关机或修改该过程（Stop、设定点、参数、通气、传感器调整、设置、重启、控制器ON/OFF键、只关控制器的CHEM-188 power.set）在面板与直接调用两条路径上都被拒（ACCESS_DENIED，状态不变），屏幕弹出消息（文字为假设）；硬电源开关是物理动作（负责人澄清10-19）：泵组摇臂开关（mains.set）任何人都可以拨动，过程按断电结束；气镇（泵头旋帽）与评测者不受限制，查看与导航不受限制。故障注入另含泵变频器错误（Frequency converter (FC) error，p.88）；阀、I/O模块、Peltronic与液位传感器错误需要本配置没有的部件。","前面板层（panel.*）：按panel_ui.json（VACUU·SELECT操作手册V1.13、泵组手册与Modbus/RS-232手册页码证据）实现触摸屏（状态栏、过程画面、压力曲线、主菜单、应用、收藏、参数列表、应用编辑器、设置、管理、VACUU·BUS、传感器调整、数据记录器、服务）、ON/OFF键、摇臂开关与气镇旋帽；每个面板动作调用本运行层的命令。","面板假设（手册未写）：屏幕480×800竖屏；图标画成名称；压力弧线画成直条、箭头标记画成滑块；编辑器拖放改为点按与步骤菜单；标准应用的步骤与默认值、提示文字为我们所拟；方向0/90/180/270°（90/270°转动竖屏画面）；语言（列表为假设）被保存、在Regional settings显示并在settings.values报告，我们的手册没有译文，各语言都显示英文文字。无U盘、以太网/Modbus、RS-232、许可证文件、液位传感器与冷却阀。","设备层：控制器开机约30 s、锁屏、关机、重启；应用由过程步骤（抽真空、真空控制、斜坡、通气、保持、自动沸点、循环、涡轮前级、VACUU-LAN）驱动CHEM-188的模式、目标与启停，步骤转速按比例缩放抽速；传感器集成通气阀按假设流导向外部腔体充入空气；传感器原始误差（仅评测者可设，默认0）与保存的传感器调整构成同一传感器模型，控制器按自己的读数调节（原CHEM-188 vacuum.set_pressure与各应用设定点、斜坡起点、通气到设定点与设定点上调通气都作用于显示压力），有误差时腔体真值与设定点不同而显示等于设定点；泵/传感器/通讯/通气阀故障仅由评测者注入。面板手势背后的命令以发出手势的会话身份执行。","面板不含3D联动：屏幕纹理（render()）与按键/开关关节触发手势属于后续Matterix步骤；本版本只在过程层与会话API层验证（panel_ui_validation）。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["power.set","vacuum.set_gas_ballast","vacuum.set_mode","vacuum.set_pressure","vacuum.start","vacuum.stop"],"unsupported":["cooling.set_flow_rate"],"note_zh":"桥接 basic40_runtime_vacuum.VacuumHost（推进方式 step_dt），12 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（2 个按键（碰到即触发）、1 个门/盖/阀等被动关节）；1 个门/盖/升降关节与运行层双向同步；接口点 0 个（无）；布局：台面、单人可搬、正面 −y、前方留空 0.25 m；面板读数 pressure(4)"}},"previews":["previews/vacuubrand_pc3001_vario_select/preview.webp","previews/vacuubrand_pc3001_vario_select/preview_rear.webp","previews/vacuubrand