":null},"acquisition.elapsed_s":{"meaning_zh":"本次扫描累计时间，完成/取消保留该值；最大2s来自近似模型。","unit":"s","access":"read_only","origin":"derived","component_ids":["optical_module"],"write_via":null},"acquisition.progress":{"meaning_zh":"累计扫描时间除以2s的派生进度；不是实测图像处理进度。","unit":"1","access":"read_only","origin":"derived","component_ids":["optical_module"],"write_via":null},"results.data":{"meaning_zh":"完成后公开的估计管ID-孔位映射、漏读、匹配和重复条码状态；扫描前为空。","unit":"1","access":"read_only","origin":"derived","component_ids":["optical_module"],"write_via":null},"truth.visible_barcodes":{"meaning_zh":"可信宿主预置的可见条码输入；仅debug/evaluator可见，不是化学真值。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["optical_module"],"write_via":null},"truth.task_manifest":{"meaning_zh":"可信宿主任务清单输入；扫描前不得经agent read直接读取。","unit":"1","access":"read_only","origin":"process_truth","component_ids":["optical_module"],"write_via":null}},"mechanisms":{"rack_identity_scan":{"meaning_zh":"宿主可见条码在选定孔位布局上，经约2s代理扫描，发布管ID与孔位、漏读和任务身份匹配。","implementation":"lumped","equations":["t_complete = t_start + 2.0 s (approximate deterministic proxy)","result[well_id] = host_visible_barcode[well_id] or null; missing and matching follow runtime validation"],"parameters":{"scan_time_proxy":{"value":2,"unit":"s","evidence":"assumption","meaning_zh":"将厂家约2s读取用于确定性时间代理；不是像素解码时间预测。"},"barcode_pixels":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"未给条码像素、图像解码阈值和相机分辨率。"},"misread_probability":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"没有误识率统计或标定，不能设0假装完美识别。"},"occlusion_coefficient":{"value":null,"unit":"1","evidence":"unknown","meaning_zh":"遮挡、霜雾响应系数未知。"}}}},"limitations":["本体外形尺寸与整机质量来自2023独立Mirage资料及三表；不是制造商CAD。原始三边未标轴，X/Y/Z映射为本次假设。","局部几何尺寸、镜头布置、管架孔距与管径等是视觉表达假设；未知真实值为null，不能解释为已测量或厂家允许误差。","整机质量1.35kg仅计入刚体聚合根；惯量按整机包围盒均匀体近似。未知部件、管架及样品管质量和惯量为null，URDF不伪造这些惯性参数。","约2s扫描以2.0s确定性宿主时延代理；可见条码由可信宿主供给，不进行像素解码、遮挡、霜雾或误识率仿真。","无样品化学过程、无气路或液路；样品身份和空间附着拓扑不代表物质转移。","管架升降0–0.10m为宿主装卸展示行程，不是仪器内部电机、自动进样器或制造商行程。","attach/release必须由宿主约束回调确认；robot层absent，未实现夹爪接触抓取、运动规划或接触动力学验证。","Standalone/LAN具体订货码原表未定；通用数据端口不承诺真实USB或网络驱动。Cryoprotection、Cyclops为选件，未默认安装。","软件返回仅为仿真状态、管ID与孔位映射、漏读和匹配状态，不证明真实扫码性能。实际硬件和厂商软件集成not_run。","GLB为静态导出快照，遵从glTF坐标基转换；原生Blender和URDF的资产定义为SI、Z向上。","Python宿主与文件可访问性不构成操作系统安全隔离；不可信代理仅应得到绑定身份的Session，不直接暴露宿主对象或调试真值。","仅处理可信宿主提供的合成可见条码观测，不读取真实图像，不实现像素识别、遮挡、霜雾或误识率模型。","2.0 s为表中约2 s的固定仿真近似；不是实测扫描时间分布。完成时一次公布整架结果，取消保留时间进度但不发布部分管ID。","24/48/96/240为支持容量；每个孔位ID由宿主明确提供，未知行列排布未内置为厂家参数。空管与漏读不能由null条码区分，均标missing。","身份匹配仅比对宿主任务清单与条码观测；不确认真实样品身份或化学组成，无化学过程。","外部管架抬升0..0.10 m是假设场景行程，不是Mirage自带电机；机械同步依赖host scene_adapter的True确认。","attach/release仅登记宿主约束回调确认的附着事件；无接触求解或机器人抓取，robot与hardware层absent。","请求去重只在当前宿主内存有效；API可见性过滤不是Python、共享文件系统或进程安全隔离。","导出返回内存中的JSON/CSV文本，不写文件、不发送网络；CSV单元格仅承载合成观测数据。","configuration.export_format是供宿主UI读取的导出偏好；results.export必须显式选json/csv。host_unload_rack仅登记外部移出，容器存在性和移出动作由宿主世界管理。","只保留当前管架/当前扫描的可导出结果；历史operation_id可查完成或取消状态，新的poll会将已清除结果标results_available=false。同request_id重放返回原响应，使用Session.poll读取最新进度。"],"sources":[],"checks":{"coverage":{"status":"bridged","implemented":["acquisition.cancel","acquisition.poll","acquisition.start","configuration.set","power.set","results.export","scene.set_rack_lift"],"unsupported":[],"note_zh":"桥接 basic40_runtime_automation.ZiathDP5Runtime（推进方式 host_step_dt_world），16 个状态槽；与运行层镜像对比全同；受信设置需经 host.call；关节化 USD（1 个门/盖/阀等被动关节）；1 个门/盖/升降关节与运行层双向同步；接口点 1 个（放置面）；布局：台面、机器人可搬、正面 −y、前方留空 0.25 m"}},"previews":["previews/ziath_dp5_mirage_2023/preview_24.webp","previews/ziath_dp5_mirage_2023/preview_240.webp","previews/ziath_dp5_mirage_2023/preview_48.webp","previews/ziath_dp5_mirage_2023/preview_hero.webp","previews/ziath_dp5_mirage_2023/preview_rack_lift.webp","previews/ziath_dp5_mirage_2023/preview_top_96.webp"],"files":[{"name":"asset.contract.json","path":"assets/basic40_batch02/t5_automation/ziath_dp5/asset.contract.json","bytes":158365},{"name":"collision_proxies.json","path":"assets/basic40_batch02/t5_automation/ziath_dp5/collision_proxie